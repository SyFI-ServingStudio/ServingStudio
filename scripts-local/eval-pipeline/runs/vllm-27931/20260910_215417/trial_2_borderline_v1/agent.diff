+    #[test]
+    fn optimized_compatibility_path_uses_after_norm_and_preserves_tree() {
+        let model = ModelCfg::llama3_8b();
+        let parallel = Llama3DenseVllmBeforeParallel {
+            gpu_name: "NVIDIA B200".to_string(),
+        };
+
+        let before_bridge = PerfApiBridge::new_uninit_for_test();
+        before_bridge.enable_enumerate();
+        let before_cfg = build_configs(&model, &parallel);
+        let before = build(
+            "test".to_string(),
+            resolve_configs(&before_cfg),
+            &before_bridge,
+        )
+        .unwrap();
+
+        let optimized_bridge = PerfApiBridge::new_uninit_for_test();
+        optimized_bridge.enable_enumerate();
+        let optimized = build_optimized("test".to_string(), &model, &parallel, &optimized_bridge)
+            .unwrap();
+
+        let after_bridge = PerfApiBridge::new_uninit_for_test();
+        after_bridge.enable_enumerate();
+        let after_cfg = after::build_configs(
+            &model,
+            &after::Llama3DenseVllmAfterParallel {
+                gpu_name: "NVIDIA B200".to_string(),
+            },
+        );
+        let after = after::build(
+            "test".to_string(),
+            after::resolve_configs(&after_cfg),
+            &after_bridge,
+        )
+        .unwrap();
+
+        let before_tree = before.cost_tree();
+        let optimized_tree = optimized.cost_tree();
+        let after_tree = after.cost_tree();
+        assert_eq!(optimized_tree.root, after_tree.root);
+        assert_eq!(optimized_tree.slots, after_tree.slots);
+        assert_eq!(optimized_tree.slots.len(), 14);
+
+        let input_norm = optimized_tree
+            .slots
+            .iter()
+            .find(|slot| slot.name == "test.pre_attn.input_norm" && slot.kind == "rms_norm_vllm")
+            .expect("optimized plain input norm leaf");
+        assert_eq!(input_norm.kernel_config["backends"], serde_json::json!(["vllm_after"]));
+        assert_eq!(input_norm.kernel_config["hidden"]["value"], 4096);
+        assert_eq!(input_norm.kernel_config["dtype"], "bf16");
+        assert_eq!(input_norm.kernel_config["vec_size"], 8);
+        assert_eq!(input_norm.kernel_config["block_size_threshold"], 256);
+        assert_eq!(input_norm.kernel_config["block_size_small_cap"], 1024);
+        assert_eq!(input_norm.kernel_config["block_size_large_cap"], 256);
+        assert_eq!(RmsNormVllmKernelInput::coord_field_names(), &["m"]);
+
+        let mut before_weights = BTreeMap::new();
+        let mut optimized_weights = BTreeMap::new();
+        leaf_weights(&before_tree.root, 1, &mut before_weights);
+        leaf_weights(&optimized_tree.root, 1, &mut optimized_weights);
+        assert_eq!(before_weights, optimized_weights);
+
+        for (before_slot, optimized_slot) in before_tree.slots.iter().zip(&optimized_tree.slots) {

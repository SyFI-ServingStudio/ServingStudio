+/// Build the optimized model selected by the historical `before` selector.
+///
+/// The direct `build` entry point above remains the pre-PR fixture used by
+/// comparisons. The launcher-facing compatibility path deliberately returns
+/// the existing post-PR model so the selector can keep its stable name while
+/// using the cache-validated RMSNorm dispatch.
+pub fn build_optimized(
+    model_name: String,
+    model: &ModelCfg,
+    parallel: &Llama3DenseVllmBeforeParallel,
+    bridge: &PerfApiBridge,
+) -> Result<after::Llama3DenseVllmAfterModel, BuildError> {
+    let optimized_parallel = after::Llama3DenseVllmAfterParallel {
+        gpu_name: parallel.gpu_name.clone(),
+    };
+    let resolved = after::resolve_configs(&after::build_configs(model, &optimized_parallel));
+    after::build(model_name, resolved, bridge)
+}

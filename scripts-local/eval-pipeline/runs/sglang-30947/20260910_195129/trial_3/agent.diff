+/// Logical traffic for the cache append runner: read the newly produced K/V rows,
+/// write the cache rows, and read the int64 slot map used for indexed placement.
+/// This is deliberately the same accounting used by both profiling backends.
+fn kv_cache_append_bytes(
+    config: &KvCacheAppendKernelConfig,
+    input: &KvCacheAppendKernelInput,
+) -> u64 {
+    let num_tokens = u64::from(input.num_tokens);
+    let elements = 2
+        * num_tokens
+        * u64::from(config.num_kv_heads.get())
+        * u64::from(config.head_dim.get());
+    elements * u64::from(config.input_dtype.size_bytes())
+        + elements * u64::from(config.kv_dtype.size_bytes())
+        + num_tokens * 8
+}

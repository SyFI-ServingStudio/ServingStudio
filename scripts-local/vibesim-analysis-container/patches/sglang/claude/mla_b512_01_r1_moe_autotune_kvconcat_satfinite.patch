+# Untuned tactic -1 picks tile_N=8, which re-streams FP4 weights past ~4 rows/expert;
+# (16, 377) is the B200 autotuner pick for K3 at 256..1024 rows (301 vs 355 us).
+_FP4_MOE_OP = "flashinfer::trtllm_fp4_block_scale_moe"
+_K3_FP4_MOE_SHAPE = (3584, 3072)  # (hidden_size, intermediate_size)
+_K3_FP4_MOE_LARGE_M_TACTIC = (16, 377)
+_K3_FP4_MOE_LARGE_M_MIN_ROWS_PER_EXPERT = 4
+
+_fp4_moe_fallback_tactic: contextvars.ContextVar[Optional[tuple[int, int]]] = (
+    contextvars.ContextVar("flashinfer_trtllm_fp4_moe_fallback_tactic", default=None)
+)
+_fp4_moe_valid_tactics: dict[int, frozenset] = {}
+_fp4_moe_fallback_hook_installed = False
+
+
+def _install_fp4_moe_fallback_tactic_hook() -> None:
+    global _fp4_moe_fallback_hook_installed
+    if _fp4_moe_fallback_hook_installed:
+        return
+    from flashinfer.autotuner import AutoTuner
+
+    orig = AutoTuner.choose_one
+
+    def choose_one(self, custom_op, runners, tuning_config, inputs, **kwargs):
+        runner, tactic = orig(self, custom_op, runners, tuning_config, inputs, **kwargs)
+        hint = _fp4_moe_fallback_tactic.get()
+        if (
+            hint is None
+            or tactic != -1
+            or custom_op != _FP4_MOE_OP
+            or self.is_tuning_mode
+            or any(k.custom_op == custom_op for k in self.profiling_cache)
+            or any(k.startswith(f"({custom_op!r}, ") for k in self._file_configs)
+        ):
+            return runner, tactic
+        valid = runners[0].get_valid_tactics(inputs, None)
+        valid_set = _fp4_moe_valid_tactics.get(id(valid))
+        if valid_set is None:
+            valid_set = frozenset(tuple(int(x) for x in t) for t in valid)
+            _fp4_moe_valid_tactics[id(valid)] = valid_set
+        if hint in valid_set:
+            return runners[0], list(hint)
+        return runner, tactic
+
+    AutoTuner.choose_one = choose_one
+    _fp4_moe_fallback_hook_installed = True
+
+
+def _k3_fp4_moe_fallback_tactic(
+    num_tokens: int,
+    top_k: int,
+    num_experts: int,
+    hidden_size: int,
+    intermediate_size: int,
+) -> Optional[tuple[int, int]]:
+    if (hidden_size, intermediate_size) != _K3_FP4_MOE_SHAPE:
+        return None
+    if num_tokens * top_k < _K3_FP4_MOE_LARGE_M_MIN_ROWS_PER_EXPERT * num_experts:
+        return None
+    _install_fp4_moe_fallback_tactic_hook()
+    return _K3_FP4_MOE_LARGE_M_TACTIC
+
+
+@contextmanager
+def _fp4_moe_fallback_tactic_context(
+    tactic: Optional[tuple[int, int]],
+) -> Generator[None, None, None]:
+    token = _fp4_moe_fallback_tactic.set(tactic)
+    try:
+        yield
+    finally:
+        _fp4_moe_fallback_tactic.reset(token)

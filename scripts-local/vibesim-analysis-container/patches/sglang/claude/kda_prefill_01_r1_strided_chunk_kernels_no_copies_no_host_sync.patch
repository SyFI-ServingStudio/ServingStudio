+    y,
+    eps,
+    T,
+    stride_x,
+    H: tl.constexpr,
+    D: tl.constexpr,
+    BT: tl.constexpr,
+    BD: tl.constexpr,
+):
+    # l2norm_fwd_kernel over rows (token, head) of a [N, H, D] view whose
+    # token stride is stride_x (heads packed): same tile, same reduction.
+    i_t = tl.program_id(0)
+    o_r = i_t * BT + tl.arange(0, BT)
+    o_d = tl.arange(0, BD)
+    m = (o_r < T)[:, None] & (o_d < D)[None, :]
+    p_x = x + ((o_r // H) * stride_x + (o_r % H) * D)[:, None] + o_d[None, :]
+    b_x = tl.load(p_x, mask=m, other=0.0).to(tl.float32)
+    b_var = tl.sum(b_x * b_x, axis=1)
+    b_y = b_x / tl.sqrt(b_var + eps)[:, None]
+    p_y = y + (o_r * D)[:, None] + o_d[None, :]
+    tl.store(p_y, b_y.to(y.dtype.element_ty), mask=m)
+
+
+def l2norm_fwd_strided_heads(x: torch.Tensor, eps: float = 1e-6) -> torch.Tensor:
+    """l2norm_fwd(x.contiguous()) for x = [1, N, H, D] with packed heads and
+    any token stride, without materializing the contiguous copy."""
+    _, N, H, D = x.shape
+    assert x.shape[0] == 1 and x.stride(-1) == 1 and x.stride(-2) == D
+    assert D <= 512
+    y = torch.empty(x.shape, dtype=x.dtype, device=x.device)
+    T = N * H
+    BT = 16
+    l2norm_fwd_strided_heads_kernel[(triton.cdiv(T, BT),)](
+        x,
+        y,
+        eps,
+        T=T,
+        stride_x=x.stride(1),
+        H=H,
+        D=D,
+        BT=BT,
+        BD=triton.next_power_of_2(D),
+        num_warps=8,
+        num_stages=3,
+    )
+    return y

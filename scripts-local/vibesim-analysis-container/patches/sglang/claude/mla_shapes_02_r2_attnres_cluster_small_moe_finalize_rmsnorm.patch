diff -ruN -x __pycache__ -x '*.pyc' a/kernels/jit/csrc/kimi_k3/attn_res/cluster_small.cuh b/kernels/jit/csrc/kimi_k3/attn_res/cluster_small.cuh
--- a/kernels/jit/csrc/kimi_k3/attn_res/cluster_small.cuh	1969-12-31 16:00:00.000000000 -0800
+++ b/kernels/jit/csrc/kimi_k3/attn_res/cluster_small.cuh	2026-09-27 01:47:17.717024114 -0700
@@ -0,0 +1,317 @@
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.h>
+
+#include <sgl_kernel/math.cuh>
+#include <sgl_kernel/runtime.cuh>
+#include <sgl_kernel/type.cuh>
+#include <sgl_kernel/utils.cuh>
+#include <sgl_kernel/vec.cuh>
+#include <sgl_kernel/warp.cuh>
+
+#include <tvm/ffi/container/tensor.h>
+
+#include <array>
+#include <cfloat>
+#include <cooperative_groups.h>
+#include <cstdint>
+#include <utility>
+
+// Small-T attention-residual aggregation: one thread-block cluster per token,
+// each CTA owning a kDim / kCluster column slice. Same math as
+// fused_tma.cuh (score -> softmax -> weighted combine -> output RMSNorm, with
+// the optional fused residual add and prefix snapshot); the row reductions
+// cross the cluster through DSMEM instead of running on one SM per token.
+
+namespace sglang {
+
+struct AttnResClusterParams {
+  const bf16_t* __restrict__ prefix_sum;  // [T, H]
+  const bf16_t* __restrict__ bank;        // [T, NB, H]
+  const bf16_t* __restrict__ cw;          // [H] score norm * proj weight
+  const bf16_t* __restrict__ ow;          // [H] out norm weight
+  bf16_t* __restrict__ out;               // [T, H]
+  bf16_t* __restrict__ prefix_dst;        // bank row nvb, nullptr = off
+  const bf16_t* __restrict__ residual;    // fused add only
+  bf16_t* __restrict__ prefix_out;        // fused add only
+  int64_t stride_bm;                      // bank stride along T (elements)
+  float eps;
+};
+
+template <int64_t kDim, uint32_t kCluster, uint32_t kNvb, bool kFuseAdd>
+__global__ void __launch_bounds__(128, 1)
+    attn_res_cluster_kernel(const __grid_constant__ AttnResClusterParams params) {
+  using namespace device;
+  namespace cg = cooperative_groups;
+  using row_vec_t = AlignedVector<bf16x2_t, 4>;  // 8 bf16 = 16 bytes
+  constexpr uint32_t kVecElems = 8;
+  constexpr int64_t kSlice = kDim / kCluster;
+  constexpr uint32_t kActive = kSlice / kVecElems;
+  constexpr uint32_t kNumWarps = 4;
+  constexpr uint32_t kRows = kNvb + 1;  // bank rows, then the prefix row
+  static_assert(kDim % (kCluster * kVecElems) == 0 && kActive <= kNumWarps * kWarpThreads);
+
+  __shared__ float s_warp[kNumWarps][2 * kRows];
+  __shared__ float s_part[2 * kRows];  // read by every CTA of the cluster
+  __shared__ float s_total[2 * kRows];
+  __shared__ float s_warp_sq[kNumWarps];
+  __shared__ float s_part_sq;  // read by every CTA of the cluster
+
+  auto cluster = cg::this_cluster();
+  const uint32_t rank = cluster.block_rank();
+  const int64_t token = blockIdx.y;
+  const uint32_t tx = threadIdx.x;
+  const uint32_t warp_id = tx / kWarpThreads;
+  const uint32_t lane_id = tx % kWarpThreads;
+  const bool active = tx < kActive;
+  const int64_t vid = (rank * kSlice) / kVecElems + tx;  // 16B vector index in the row
+
+  row_vec_t rows[kRows];
+  row_vec_t cw_vec, ow_vec;
+  if (active) {
+    cw_vec.load(params.cw, vid);
+    ow_vec.load(params.ow, vid);
+#pragma unroll
+    for (uint32_t r = 0; r < kNvb; ++r) {
+      rows[r].load(params.bank + token * params.stride_bm + r * kDim, vid);
+    }
+  }
+  // Only the prefix row (and the addend) come from the immediately-preceding
+  // kernel; see the matching wait in fused_tma.cuh.
+  PDLWaitPrimary<true>();
+  if (active) {
+    rows[kNvb].load(params.prefix_sum + token * kDim, vid);
+    if constexpr (kFuseAdd) {
+      row_vec_t addend;
+      addend.load(params.residual + token * kDim, vid);
+#pragma unroll
+      for (uint32_t j = 0; j < kVecElems / 2; ++j) {
+        const auto x = cast<float2>(rows[kNvb][j]);
+        const auto y = cast<float2>(addend[j]);
+        rows[kNvb][j] = cast<bf16x2_t>(make_float2(x.x + y.x, x.y + y.y));
+      }
+    }
+  }
+  PDLTriggerSecondary<true>();
+
+  float rms[kRows] = {};
+  float dot[kRows] = {};
+  if (active) {
+#pragma unroll
+    for (uint32_t j = 0; j < kVecElems / 2; ++j) {
+      const auto q = cast<float2>(cw_vec[j]);
+#pragma unroll
+      for (uint32_t r = 0; r < kRows; ++r) {
+        const auto f = cast<float2>(rows[r][j]);
+        rms[r] = fmaf(f.x, f.x, fmaf(f.y, f.y, rms[r]));
+        dot[r] = fmaf(f.x, q.x, fmaf(f.y, q.y, dot[r]));
+      }
+    }
+  }
+#pragma unroll
+  for (uint32_t r = 0; r < kRows; ++r) {
+    rms[r] = warp::reduce_sum(rms[r]);
+    dot[r] = warp::reduce_sum(dot[r]);
+  }
+  if (lane_id == 0) {
+#pragma unroll
+    for (uint32_t r = 0; r < kRows; ++r) {
+      s_warp[warp_id][r] = rms[r];
+      s_warp[warp_id][kRows + r] = dot[r];
+    }
+  }
+  __syncthreads();
+  if (tx < 2 * kRows) {
+    float v = 0.f;
+#pragma unroll
+    for (uint32_t w = 0; w < kNumWarps; ++w) v += s_warp[w][tx];
+    s_part[tx] = v;
+  }
+  cluster.sync();
+  // Fixed rank order: every CTA of the cluster sees bit-identical totals.
+  if (tx < 2 * kRows) {
+    float v = 0.f;
+#pragma unroll
+    for (uint32_t c = 0; c < kCluster; ++c) v += cluster.map_shared_rank(s_part, c)[tx];
+    s_total[tx] = v;
+  }
+  __syncthreads();
+
+  float logit[kRows];
+  float max_logit = -FLT_MAX;
+#pragma unroll
+  for (uint32_t r = 0; r < kRows; ++r) {
+    constexpr float kScale = 1.f / static_cast<float>(kDim);
+    logit[r] = s_total[kRows + r] * rsqrtf(s_total[r] * kScale + params.eps);
+    max_logit = fmaxf(max_logit, logit[r]);
+  }
+  float weight[kRows];
+  float weight_sum = 0.f;
+#pragma unroll
+  for (uint32_t r = 0; r < kRows; ++r) {
+    weight[r] = exp2f((logit[r] - max_logit) * math::log2e);
+    weight_sum += weight[r];
+  }
+
+  float mixed[kVecElems] = {};
+  float sq = 0.f;
+  if (active) {
+#pragma unroll
+    for (uint32_t j = 0; j < kVecElems / 2; ++j) {
+      float2 a = make_float2(0.f, 0.f);
+#pragma unroll
+      for (uint32_t r = 0; r < kRows; ++r) {
+        const auto f = cast<float2>(rows[r][j]);
+        a.x = fmaf(weight[r], f.x, a.x);
+        a.y = fmaf(weight[r], f.y, a.y);
+      }
+      mixed[2 * j] = a.x;
+      mixed[2 * j + 1] = a.y;
+      sq = fmaf(a.x, a.x, fmaf(a.y, a.y, sq));
+    }
+  }
+  sq = warp::reduce_sum(sq);
+  if (lane_id == 0) s_warp_sq[warp_id] = sq;
+  __syncthreads();
+  if (tx == 0) {
+    float v = 0.f;
+#pragma unroll
+    for (uint32_t w = 0; w < kNumWarps; ++w) v += s_warp_sq[w];
+    s_part_sq = v;
+  }
+  cluster.sync();
+  float total_sq = 0.f;
+#pragma unroll
+  for (uint32_t c = 0; c < kCluster; ++c) total_sq += *cluster.map_shared_rank(&s_part_sq, c);
+
+  if (active) {
+    const float inv_sum = 1.f / weight_sum;
+    const float scale = inv_sum * rsqrtf(total_sq * inv_sum * inv_sum / static_cast<float>(kDim) + params.eps);
+    row_vec_t out_vec;
+#pragma unroll
+    for (uint32_t j = 0; j < kVecElems / 2; ++j) {
+      const auto w = cast<float2>(ow_vec[j]);
+      out_vec[j] = cast<bf16x2_t>(make_float2(mixed[2 * j] * scale * w.x, mixed[2 * j + 1] * scale * w.y));
+    }
+    out_vec.store(params.out + token * kDim, vid);
+    if constexpr (kFuseAdd) {
+      rows[kNvb].store(params.prefix_out + token * kDim, vid);
+    }
+    if (params.prefix_dst != nullptr) {
+      rows[kNvb].store(params.prefix_dst + token * params.stride_bm, vid);
+    }
+  }
+  // Keep this CTA's shared partials alive until every peer has read them.
+  cluster.sync();
+}
+
+template <int64_t kDim, uint32_t kMaxBankRows, uint32_t kCluster>
+struct AttnResClusterKernel {
+  using KernelFn = void (*)(const AttnResClusterParams);
+  static constexpr uint32_t kNumThreads = 128;
+
+  template <bool kFuseAdd, std::size_t... I>
+  static constexpr auto make_table(std::index_sequence<I...>) {
+    return std::array<KernelFn, kMaxBankRows + 1>{
+        nullptr, attn_res_cluster_kernel<kDim, kCluster, I + 1, kFuseAdd>...};
+  }
+  static constexpr auto kTable = make_table<false>(std::make_index_sequence<kMaxBankRows>{});
+  static constexpr auto kAddTable = make_table<true>(std::make_index_sequence<kMaxBankRows>{});
+
+  static void launch(
+      const tvm::ffi::TensorView prefix_sum,
+      const tvm::ffi::TensorView bank,
+      const tvm::ffi::TensorView cw,
+      const tvm::ffi::TensorView ow,
+      const tvm::ffi::TensorView out,
+      const bf16_t* residual,
+      bf16_t* prefix_out,
+      int64_t nvb,
+      double eps,
+      bool write_prefix) {
+    using namespace host;
+
+    auto T_ = SymbolicSize{"num_tokens"};
+    auto H_ = SymbolicSize{"hidden_size"};
+    auto NB_ = SymbolicSize{"num_bank_slots"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+
+    TensorMatcher({T_, H_}).with_dtype<bf16_t>().with_device(device).verify(prefix_sum).verify(out);
+    TensorMatcher({T_, NB_, H_}).with_dtype<bf16_t>().with_device(device).verify(bank);
+    TensorMatcher({H_}).with_dtype<bf16_t>().with_device(device).verify(cw).verify(ow);
+
+    const auto num_tokens = static_cast<int64_t>(T_.unwrap());
+    const auto H = static_cast<int64_t>(H_.unwrap());
+    const auto NB = static_cast<int64_t>(NB_.unwrap());
+    RuntimeCheck(H == kDim, "attn_res_cluster: H must be ", kDim, ", got ", H);
+    RuntimeCheck(1 <= nvb && nvb <= kMaxBankRows && nvb <= NB, "attn_res_cluster: invalid nvb=", nvb, " NB=", NB);
+    RuntimeCheck(!write_prefix || nvb < NB, "attn_res_cluster: write_prefix targets bank row nvb, needs nvb < NB");
+    if (num_tokens == 0) return;
+
+    const auto params = AttnResClusterParams{
+        .prefix_sum = static_cast<const bf16_t*>(prefix_sum.data_ptr()),
+        .bank = static_cast<const bf16_t*>(bank.data_ptr()),
+        .cw = static_cast<const bf16_t*>(cw.data_ptr()),
+        .ow = static_cast<const bf16_t*>(ow.data_ptr()),
+        .out = static_cast<bf16_t*>(out.data_ptr()),
+        .prefix_dst = write_prefix ? static_cast<bf16_t*>(bank.data_ptr()) + nvb * H : nullptr,
+        .residual = residual,
+        .prefix_out = prefix_out,
+        .stride_bm = NB * H,
+        .eps = static_cast<float>(eps),
+    };
+    const auto kernel = residual != nullptr ? kAddTable[nvb] : kTable[nvb];
+    LaunchKernel(dim3(kCluster, num_tokens), kNumThreads, device.unwrap())
+        .config({.use_pdl = true, .cluster_dim = dim3(kCluster, 1, 1)})(kernel, params);
+  }
+
+  static void
+  run(const tvm::ffi::TensorView prefix_sum,
+      const tvm::ffi::TensorView bank,
+      const tvm::ffi::TensorView cw,
+      const tvm::ffi::TensorView ow,
+      const tvm::ffi::TensorView out,
+      int64_t nvb,
+      double eps,
+      bool write_prefix) {
+    launch(prefix_sum, bank, cw, ow, out, nullptr, nullptr, nvb, eps, write_prefix);
+  }
+
+  static void run_add(
+      const tvm::ffi::TensorView input,
+      const tvm::ffi::TensorView residual,
+      const tvm::ffi::TensorView bank,
+      const tvm::ffi::TensorView cw,
+      const tvm::ffi::TensorView ow,
+      const tvm::ffi::TensorView out,
+      const tvm::ffi::TensorView prefix_out,
+      int64_t nvb,
+      double eps,
+      bool write_prefix) {
+    using namespace host;
+    auto T_ = SymbolicSize{"num_tokens"};
+    auto H_ = SymbolicSize{"hidden_size"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+    TensorMatcher({T_, H_})
+        .with_dtype<bf16_t>()
+        .with_device(device)
+        .verify(input)
+        .verify(residual)
+        .verify(out)
+        .verify(prefix_out);
+    launch(
+        input,
+        bank,
+        cw,
+        ow,
+        out,
+        static_cast<const bf16_t*>(residual.data_ptr()),
+        static_cast<bf16_t*>(prefix_out.data_ptr()),
+        nvb,
+        eps,
+        write_prefix);
+  }
+};
+
+}  // namespace sglang

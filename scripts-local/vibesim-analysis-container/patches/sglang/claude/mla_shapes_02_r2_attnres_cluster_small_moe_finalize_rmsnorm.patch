diff -ruN -x __pycache__ -x '*.pyc' a/kernels/ops/moe/moe_finalize_rmsnorm.py b/kernels/ops/moe/moe_finalize_rmsnorm.py
--- a/kernels/ops/moe/moe_finalize_rmsnorm.py	1969-12-31 16:00:00.000000000 -0800
+++ b/kernels/ops/moe/moe_finalize_rmsnorm.py	2026-09-27 01:39:13.180314734 -0700
@@ -0,0 +1,74 @@
+"""Deferred trtllm-gen MoE finalize fused with the following RMSNorm.
+
+Consumes the ``do_finalize=False`` triple of the trtllm-gen routed MoE and
+writes ``rmsnorm(bf16(sum_k w[t, k] * gemm2_out[idx[t * K + k]]))``: the
+finalize is accumulated in fp32 over k in order and rounded to bf16 exactly as
+FlashInfer's finalizeKernel does, so only the norm's reduction order differs
+from the unfused finalize + RMSNorm chain.
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _moe_finalize_rmsnorm_kernel(
+    out_ptr,  # [T, H] bf16
+    g2_ptr,  # [P, H] bf16, permuted gemm2 rows
+    idx_ptr,  # [T * K] int32, -1 for experts not on this rank
+    w_ptr,  # [T, K] fp32 or bf16
+    norm_w_ptr,  # [H] bf16
+    eps,
+    H: tl.constexpr,
+    K: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    t = tl.program_id(0)
+    offs = tl.arange(0, BLOCK)
+    mask = offs < H
+    acc = tl.zeros([BLOCK], dtype=tl.float32)
+    for k in tl.static_range(K):
+        row = tl.load(idx_ptr + t * K + k)
+        scale = tl.load(w_ptr + t * K + k).to(tl.float32)
+        g = tl.load(
+            g2_ptr + row.to(tl.int64) * H + offs, mask=mask & (row >= 0), other=0.0
+        )
+        acc += g.to(tl.float32) * scale
+    x = acc.to(tl.bfloat16).to(tl.float32)
+    rstd = tl.rsqrt(tl.sum(x * x, axis=0) / H + eps)
+    nw = tl.load(norm_w_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    tl.store(out_ptr + t * H + offs, (x * rstd * nw).to(tl.bfloat16), mask=mask)
+
+
+def moe_finalize_rmsnorm(
+    *,
+    gemm2_out: torch.Tensor,
+    expanded_idx_to_permuted_idx: torch.Tensor,
+    expert_weights: torch.Tensor,
+    norm_weight: torch.Tensor,
+    eps: float,
+) -> torch.Tensor:
+    assert gemm2_out.dtype == torch.bfloat16 and gemm2_out.is_contiguous()
+    assert expanded_idx_to_permuted_idx.dtype == torch.int32
+    assert expert_weights.dtype in (torch.float32, torch.bfloat16)
+    num_tokens, top_k = expert_weights.shape
+    hidden = gemm2_out.shape[1]
+    assert expanded_idx_to_permuted_idx.numel() == num_tokens * top_k
+    assert norm_weight.shape == (hidden,)
+    out = gemm2_out.new_empty((num_tokens, hidden))
+    _moe_finalize_rmsnorm_kernel[(num_tokens,)](
+        out,
+        gemm2_out,
+        expanded_idx_to_permuted_idx.contiguous(),
+        expert_weights.contiguous(),
+        norm_weight,
+        eps,
+        H=hidden,
+        K=top_k,
+        BLOCK=triton.next_power_of_2(hidden),
+        num_warps=8,
+    )
+    return out

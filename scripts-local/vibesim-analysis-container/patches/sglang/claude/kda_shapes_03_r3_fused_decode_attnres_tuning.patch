+template <int64_t kDim, uint32_t kNvb>
+__global__ void __launch_bounds__(AttnResDirect<kDim, kNvb>::kNumThreads, 1)
+    attn_res_direct_kernel(const __grid_constant__ AttnResTMAParams params) {
+  using namespace device;
+  using D = AttnResDirect<kDim, kNvb>;
+  using vec_t = AlignedVector<bf16x2_t, 4>;
+  constexpr uint32_t kRows = D::kRows;
+  __shared__ float red_rows[D::kNumWarps][2 * kRows];
+  __shared__ float tot_rows[2 * kRows];
+  __shared__ float red_sq[D::kNumWarps];
+
+  const uint32_t tx = threadIdx.x;
+  const uint32_t warp_id = tx / kWarpThreads;
+  const uint32_t lane_id = tx % kWarpThreads;
+
+  // Static weights: safe to read before the dependency wait.
+  vec_t cw_v, ow_v;
+  cw_v.load(params.cw, tx);
+  ow_v.load(params.ow, tx);
+  PDLWaitPrimary<true>();
+
+  for (uint32_t token = blockIdx.x; token < params.num_tokens; token += gridDim.x) {
+    const int64_t row_off = static_cast<int64_t>(token) * (kDim / D::kVecElems);
+    const bf16_t* bank_tok = params.bank + static_cast<int64_t>(token) * params.stride_bm;
+    vec_t rows[kRows];
+#pragma unroll
+    for (uint32_t r = 0; r < kNvb; ++r) {
+      rows[r].load(bank_tok + r * kDim, tx);
+    }
+    if (params.addend != nullptr) {

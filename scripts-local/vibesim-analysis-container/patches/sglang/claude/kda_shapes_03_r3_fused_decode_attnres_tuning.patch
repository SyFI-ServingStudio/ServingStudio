+// Register-direct aggregation for decode-sized batches (one token per CTA,
+// T <= #SMs). With nvb + 1 rows of one token there is too little data to
+// hide the TMA kernel's serial phases (add -> store -> proxy fence -> bulk
+// reload -> TMEM staging); here each of the kDim / 8 threads owns one 16B
+// vector of every row, so the residual/addend/bank/cw/ow loads go out in a
+// single round trip. Same math as KimiK3AttnResTrait::forward (fp32 scores,
+// max-shifted exp2 softmax, fma mixing in row order, fused out norm); only
+// the fp32 reduction order of the row sums differs. The pending add keeps
+// the explicit add.rn + RN cast, so prefix_out and the bank row are
+// bit-identical to the TMA path.
+template <int64_t kDim, uint32_t kNvb>
+struct AttnResDirect {
+  static constexpr uint32_t kVecElems = 8;
+  static constexpr uint32_t kNumThreads = kDim / kVecElems;
+  static constexpr uint32_t kNumWarps = kNumThreads / device::kWarpThreads;
+  static constexpr uint32_t kRows = kNvb + 1;  // bank rows + prefix row
+  static_assert(kDim % (kVecElems * device::kWarpThreads) == 0);
+  static_assert(kNumThreads <= 1024);
+  static_assert(2 * kRows <= device::kWarpThreads);
+};

+      va.load(params.residual, row_off + tx);
+      vb.load(params.addend, row_off + tx);
+#pragma unroll
+      for (uint32_t j = 0; j < 4; ++j) {
+        const auto fa = cast<float2>(va[j]);
+        const auto fb = cast<float2>(vb[j]);
+        float2 fs;
+        // Explicit non-ftz fp32 add, as in attn_res_fused_add_kernel.
+        asm("add.rn.f32 %0, %1, %2;" : "=f"(fs.x) : "f"(fa.x), "f"(fb.x));
+        asm("add.rn.f32 %0, %1, %2;" : "=f"(fs.y) : "f"(fa.y), "f"(fb.y));
+        rows[kNvb][j] = __float22bfloat162_rn(fs);
+      }
+      rows[kNvb].store(params.prefix_out, row_off + tx);
+    } else {
+      rows[kNvb].load(params.prefix_sum, row_off + tx);
+    }
+    if (token + gridDim.x >= params.num_tokens) PDLTriggerSecondary<true>();
+    if (params.prefix_dst != nullptr) {
+      rows[kNvb].store(params.prefix_dst + static_cast<int64_t>(token) * params.stride_bm, tx);
+    }

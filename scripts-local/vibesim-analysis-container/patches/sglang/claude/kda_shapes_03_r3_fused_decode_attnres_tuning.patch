+    const auto* q2 = reinterpret_cast<const bf16x2_t*>(&cw_v);
+    float part[2 * kRows];
+#pragma unroll
+    for (uint32_t r = 0; r < kRows; ++r) {
+      float2 rms2 = make_float2(0.f, 0.f);
+      float2 dot2 = make_float2(0.f, 0.f);
+#pragma unroll
+      for (uint32_t j = 0; j < 4; ++j) {
+        const auto f = cast<float2>(rows[r][j]);
+        rms2 = fma_f32x2(f, f, rms2);
+        dot2 = fma_f32x2(f, cast<float2>(q2[j]), dot2);
+      }
+      part[2 * r] = warp::reduce_sum(rms2.x + rms2.y);
+      part[2 * r + 1] = warp::reduce_sum(dot2.x + dot2.y);
+    }
+    if (lane_id == 0) {
+#pragma unroll
+      for (uint32_t i = 0; i < 2 * kRows; ++i) red_rows[warp_id][i] = part[i];
+    }
+    __syncthreads();
+    if (warp_id == 0 && lane_id < 2 * kRows) {
+      float t = 0.f;
+#pragma unroll
+      for (uint32_t w = 0; w < D::kNumWarps; ++w) t += red_rows[w][lane_id];
+      tot_rows[lane_id] = t;
+    }
+    __syncthreads();
+
+    constexpr float kScale = 1.f / static_cast<float>(kDim);
+    float logit[kRows];
+    float row_max = -FLT_MAX;
+#pragma unroll
+    for (uint32_t r = 0; r < kRows; ++r) {
+      logit[r] = tot_rows[2 * r + 1] * rsqrtf(tot_rows[2 * r] * kScale + params.eps);
+      row_max = fmaxf(row_max, logit[r]);
+    }
+    float weight_sum = 0.f;
+    float2 acc[4] = {};
+#pragma unroll
+    for (uint32_t r = 0; r < kRows; ++r) {
+      const float w = exp2f((logit[r] - row_max) * math::log2e);
+      weight_sum += w;
+      const float2 w2 = make_float2(w, w);
+#pragma unroll
+      for (uint32_t j = 0; j < 4; ++j) {
+        acc[j] = fma_f32x2(w2, cast<float2>(rows[r][j]), acc[j]);
+      }
+    }
+
+    // Fused out norm: mixed = acc / weight_sum, out = rmsnorm(mixed) * ow.
+    const float inv_sum = 1.f / weight_sum;
+    float2 sq2 = make_float2(0.f, 0.f);
+#pragma unroll
+    for (uint32_t j = 0; j < 4; ++j) sq2 = fma_f32x2(acc[j], acc[j], sq2);
+    const float sq = warp::reduce_sum(sq2.x + sq2.y);
+    if (lane_id == 0) red_sq[warp_id] = sq;
+    __syncthreads();
+    float total_sq = 0.f;
+#pragma unroll
+    for (uint32_t w = 0; w < D::kNumWarps; ++w) total_sq += red_sq[w];
+    const float scale = inv_sum * rsqrtf(total_sq * inv_sum * inv_sum / static_cast<float>(kDim) + params.eps);
+    const float2 scale2 = make_float2(scale, scale);
+    const auto* o2 = reinterpret_cast<const bf16x2_t*>(&ow_v);
+    vec_t out_vec;
+#pragma unroll
+    for (uint32_t j = 0; j < 4; ++j) {
+      out_vec[j] = cast<bf16x2_t>(mul_f32x2(mul_f32x2(acc[j], scale2), cast<float2>(o2[j])));
+    }
+    out_vec.store(params.out, row_off + tx);
+    // red_rows / tot_rows / red_sq are reused by the next token.
+    __syncthreads();
+  }

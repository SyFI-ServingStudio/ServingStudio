+def _num_kv_splits(num_ctas: int, kv_len: int, num_sms: int) -> int:
+    """Split the KV into S batch entries so the grid grows S-fold and the
+    partial last wave is amortized. Measured on B200 (12 heads, kv >= 96k):
+    <= 6 waves (16k q) gains ~8% at S=4 and ~5% at S=2; ~10 waves (32k q)
+    gains ~2% at S=2 only, larger S costs more in extra Q loads than the
+    tail saves. Short KV keeps a single launch."""
+    splits = 4 if num_ctas <= 6 * num_sms else 2
+    while splits > 1 and kv_len < splits * _MIN_SPLIT_KV:
+        splits //= 2
+    return splits

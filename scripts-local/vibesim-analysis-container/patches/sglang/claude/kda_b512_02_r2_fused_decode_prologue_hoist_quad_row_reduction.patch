+// Four rows at once over the same xor-16/8/4/2/1 butterfly tree as
+// warp_reduce_sum_pair_split (bit-identical totals): each level halves the
+// values a lane carries, so 4 rows cost 6 shuffles instead of 2 x 5. Totals
+// end in lanes [0,8) = a, [8,16) = c, [16,24) = b, [24,32) = d.
+SGL_DEVICE float warp_reduce_sum_quad_split(float a, float b, float c, float d) {
+  const bool upper = (threadIdx.x & 16) != 0;
+  float lo = upper ? b : a;
+  float hi = upper ? d : c;
+  lo += __shfl_xor_sync(0xffffffffu, upper ? a : b, 16);
+  hi += __shfl_xor_sync(0xffffffffu, upper ? c : d, 16);
+  const bool upper8 = (threadIdx.x & 8) != 0;
+  float value = upper8 ? hi : lo;
+  value += __shfl_xor_sync(0xffffffffu, upper8 ? lo : hi, 8);
+#pragma unroll
+  for (int mask = 4; mask >= 1; mask >>= 1) {
+    value += __shfl_xor_sync(0xffffffffu, value, mask);
+  }
+  return value;
+}

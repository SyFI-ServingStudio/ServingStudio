+}  // namespace kda_conv_l2norm
+
+struct KdaConvL2normKernel {
+  static void run(
+      const tvm::ffi::TensorView x,
+      const tvm::ffi::TensorView w,
+      const tvm::ffi::TensorView conv_state,
+      const tvm::ffi::TensorView cache_indices,
+      const tvm::ffi::TensorView has_initial_state,
+      const tvm::ffi::TensorView query_start_loc,
+      const tvm::ffi::TensorView out,
+      int64_t max_seqlen,
+      double eps,
+      bool has_init) {
+    using namespace host;
+    using namespace kda_conv_l2norm;
+
+    auto T_ = SymbolicSize{"num_tokens"};
+    auto Dim_ = SymbolicSize{"dim"};
+    auto G_ = SymbolicSize{"group"};
+    auto Slots_ = SymbolicSize{"slots"};
+    auto N_ = SymbolicSize{"num_seqs"};
+    auto Q_ = SymbolicSize{"num_seqs_plus_1"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+
+    TensorMatcher({T_, Dim_}).with_strides({-1, 1}).with_dtype<bf16_t>().with_device(device).verify(x);
+    TensorMatcher({Dim_, kWidth}).with_strides({kWidth, 1}).with_dtype<fp32_t>().with_device(device).verify(w);
+    TensorMatcher({3, T_, G_}).with_dtype<bf16_t>().with_device(device).verify(out);
+    const int64_t dim = Dim_.unwrap();
+    TensorMatcher({Slots_, kWidth - 1, Dim_})
+        .with_strides({-1, dim, 1})
+        .with_dtype<bf16_t>()
+        .with_device(device)
+        .verify(conv_state);
+    TensorMatcher({N_}).with_dtype<int32_t>().with_device(device).verify(cache_indices);
+    TensorMatcher({Q_}).with_dtype<int32_t>().with_device(device).verify(query_start_loc);
+    const int64_t T = T_.unwrap();
+    const int64_t group = G_.unwrap();
+    const int64_t N = N_.unwrap();
+    CHECK_HOST(Q_.unwrap() == N + 1) << "kda_conv_l2norm: query_start_loc must have num_seqs + 1 entries";
+    CHECK_HOST(dim == 3 * group && group % kWarpChannels == 0 && group % kHeadDim == 0)
+        << "kda_conv_l2norm: dim must be 3 * group with group % 256 == 0, got dim " << dim;
+    CHECK_HOST(x.stride(0) % kVec == 0) << "kda_conv_l2norm: x row stride must be a multiple of 8";
+    CHECK_HOST(conv_state.stride(0) % kVec == 0) << "kda_conv_l2norm: conv state slot pitch must be a multiple of 8";
+    const uint8_t* init_ptr = nullptr;
+    if (has_init) {
+      CHECK_HOST(has_initial_state.numel() == N && has_initial_state.dtype().bits == 8)
+          << "kda_conv_l2norm: has_initial_state must be [num_seqs] bool";
+      init_ptr = static_cast<const uint8_t*>(has_initial_state.data_ptr());
+    }
+    if (N == 0 || max_seqlen <= 0) return;
+
+    const int64_t strip_tokens = kWarps * kStrip;
+    const dim3 grid(
+        static_cast<uint32_t>(dim / kWarpChannels),
+        static_cast<uint32_t>((max_seqlen + strip_tokens - 1) / strip_tokens),
+        static_cast<uint32_t>(N));
+    LaunchKernel(grid, dim3(kThreads), device.unwrap())(
+        kda_conv_l2norm_kernel,
+        static_cast<const __nv_bfloat16*>(x.data_ptr()),
+        static_cast<const float*>(w.data_ptr()),
+        static_cast<__nv_bfloat16*>(conv_state.data_ptr()),
+        static_cast<const int32_t*>(cache_indices.data_ptr()),
+        init_ptr,
+        static_cast<const int32_t*>(query_start_loc.data_ptr()),
+        static_cast<__nv_bfloat16*>(out.data_ptr()),
+        x.stride(0),
+        conv_state.stride(0),
+        static_cast<int32_t>(T),
+        static_cast<int32_t>(dim),
+        static_cast<int32_t>(group),
+        static_cast<float>(eps));
+  }
+};

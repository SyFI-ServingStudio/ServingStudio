+/// Approximate SiTU for the plain elementwise kernel, which is ALU-bound on
+/// fp32 input: MUFU tanh (rel err ~2^-11) and approximate reciprocal.
+template <bool kHasLinearBeta>
+SGL_DEVICE float situ_activate_approx(
+    float g, float u, float beta, float inv_beta, float linear_beta, float inv_linear_beta) {
+  const auto tanh_approx = [](float x) {
+#ifdef USE_ROCM
+    return tanhf(x);
+#else
+    float y;
+    asm("tanh.approx.f32 %0, %1;" : "=f"(y) : "f"(x));
+    return y;
+#endif
+  };
+  const float gate_out = beta * tanh_approx(g * inv_beta) * __fdividef(1.0f, 1.0f + __expf(-g));
+  float up_out;
+  if constexpr (kHasLinearBeta) {
+    up_out = linear_beta * tanh_approx(u * inv_linear_beta);
+  } else {
+    up_out = u;
+  }
+  return gate_out * up_out;
+}
+
 }  // namespace kimi_k3
 

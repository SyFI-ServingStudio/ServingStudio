+++ b/kernels/ops/elementwise/l2_prefetch.py	2026-09-27 00:50:56.631296257 -0700
@@ -0,0 +1,31 @@
+"""CUDA JIT L2 warm-up: prefetch a bf16 tensor (or row-strided 2-D view) into L2."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import torch
+
+from sglang.kernels.jit.utils import cache_once, load_jit
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+
+@cache_once
+def _jit_l2_prefetch_module() -> Module:
+    return load_jit(
+        "l2_prefetch_bf16",
+        cuda_files=["elementwise/l2_prefetch.cuh"],
+        cuda_wrappers=[("run", "L2PrefetchKernel::launch")],
+        extra_cuda_cflags=["-O3"],
+    )
+
+
+def l2_prefetch(x: torch.Tensor, num_blocks: int = 148) -> None:
+    """Hint the bytes of bf16 ``x`` into L2 (no reads into SMs, no writes;
+    completion is not tracked). ``x`` is contiguous, or a 2-D view with unit
+    column stride (e.g. a K-prefix ``w[:, :k]`` of a weight). Results of
+    later kernels are unaffected -- only where their loads are served from."""
+    x = x.view(1, -1) if x.is_contiguous() else x
+    _jit_l2_prefetch_module().run(x, num_blocks)

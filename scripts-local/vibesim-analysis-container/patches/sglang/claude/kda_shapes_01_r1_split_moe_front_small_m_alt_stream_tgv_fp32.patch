+// Local pending add + attention-residual aggregation: the whole CTA
+// materializes prefix_out = residual + addend for its tokens, then the TMA
+// pipeline aggregates that row. Each CTA only reads back rows it wrote.
+template <typename Trait, uint32_t kOccupancy>
+__global__ void __launch_bounds__(Trait::kNumThreads, kOccupancy)
+    attn_res_fused_add_kernel(const __grid_constant__ AttnResTMAParams params) {
+  using vec_t = device::AlignedVector<bf16x2_t, 4>;
+  constexpr uint32_t kRowVecs = Trait::kDim * sizeof(bf16_t) / sizeof(vec_t);
+  constexpr uint32_t kVecsPerThread = (kRowVecs + Trait::kNumThreads - 1) / Trait::kNumThreads;
+  device::PDLWaitPrimary<true>();
+  for (auto token = blockIdx.x; token < params.num_tokens; token += gridDim.x) {
+    const auto row = static_cast<int64_t>(token) * Trait::kDim;
+    vec_t va[kVecsPerThread];
+    vec_t vb[kVecsPerThread];
+#pragma unroll
+    for (uint32_t i = 0; i < kVecsPerThread; ++i) {
+      const uint32_t vid = threadIdx.x + i * Trait::kNumThreads;
+      if (vid < kRowVecs) {
+        va[i].load(params.residual + row, vid);
+        vb[i].load(params.addend + row, vid);
+      }
+    }
+#pragma unroll
+    for (uint32_t i = 0; i < kVecsPerThread; ++i) {
+      const uint32_t vid = threadIdx.x + i * Trait::kNumThreads;
+      if (vid < kRowVecs) {
+        vec_t sum;
+#pragma unroll
+        for (uint32_t j = 0; j < 4; ++j) {
+          const auto fa = device::cast<float2>(va[i][j]);
+          const auto fb = device::cast<float2>(vb[i][j]);
+          float2 fs;
+          // Explicit non-ftz fp32 add: the module builds with --use_fast_math,
+          // and torch's bf16 add (fp32 sum, one RN cast) keeps denormals.
+          asm("add.rn.f32 %0, %1, %2;" : "=f"(fs.x) : "f"(fa.x), "f"(fb.x));
+          asm("add.rn.f32 %0, %1, %2;" : "=f"(fs.y) : "f"(fa.y), "f"(fb.y));
+          sum[j] = __float22bfloat162_rn(fs);
+        }
+        sum.store(params.prefix_out + row, vid);
+      }
+    }
+  }
+  // Generic-proxy stores above are read back by the producer's bulk copies.
+  asm volatile("fence.proxy.async.global;" ::: "memory");
+  __syncthreads();
+
+  extern __shared__ char smem_raw[];
+  Trait::forward(params, reinterpret_cast<typename Trait::Smem*>(smem_raw));

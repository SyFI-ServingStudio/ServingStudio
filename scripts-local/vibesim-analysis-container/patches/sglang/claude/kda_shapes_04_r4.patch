+  device::PDLWaitPrimary<kUsePDL>();
+
+  const __nv_bfloat16 qk_new = (is_q ? x_q : x_k)[bos * x_row_stride + hk];
+  {
+    float acc = qk_bias;
+#pragma unroll
+    for (int w = 0; w < kConvStateWidth; ++w) {
+      acc += __bfloat162float(qk_state[w]) * qk_w[w];
+    }
+    acc += __bfloat162float(qk_new) * qk_w[kKernelWidth - 1];

+// Small-grid variant of kda_fused_decode_k3_kernel. Each (token, head) is
+// split over a cluster of kVSplit CTAs, CTA `rank` owning V rows
+// [rank*kDimV/kVSplit, (rank+1)*kDimV/kVSplit); every CTA redundantly runs the
+// q/k conv, decay and L2 norm. Per-row math, the row pairing and the onorm
+// sumsq order (per-32-row warp totals combined by one warp) match the base
+// kernel, so output and state are bitwise equal. Inputs no kernel of this step
+// writes (slot index, recurrent state via TMA, conv-state taps, params) are
+// read before the PDL wait, hiding their latency under the qkvg GEMM tail.
+// q/k conv-state writes wait for a cluster barrier since every CTA of the
+// cluster reads those channels.
+template <int kFixedHeads, bool kUseLowerBound, bool kUsePDL, typename StateT, int kVSplit>
+__global__ __launch_bounds__(kThreads, 1) void kda_fused_decode_k3_vsplit_kernel(

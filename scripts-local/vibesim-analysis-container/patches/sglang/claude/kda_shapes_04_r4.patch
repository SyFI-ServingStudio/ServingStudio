+  const int rank = static_cast<int>(blockIdx.x) % kVSplit;
+  const int i_n = static_cast<int>(blockIdx.x) / kVSplit;
+  const int i_hv = blockIdx.y;
+  const int i_h = i_hv;
+  const int bos = i_n;

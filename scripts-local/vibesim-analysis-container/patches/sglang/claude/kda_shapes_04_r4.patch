+// Split cluster barrier: every thread of every CTA in the cluster must arrive,
+// and phases alternate arrive -> wait.
+static SGL_DEVICE void cluster_arrive() {
+  asm volatile("barrier.cluster.arrive.release.aligned;" ::: "memory");
+}
+
+static SGL_DEVICE void cluster_wait() {
+  asm volatile("barrier.cluster.wait.acquire.aligned;" ::: "memory");
+}

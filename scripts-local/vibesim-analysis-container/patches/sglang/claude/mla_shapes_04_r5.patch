+def merge_kv_split_vup_covered(out: torch.Tensor, w_vc: torch.Tensor) -> bool:
+    return (
+        out.dtype == torch.bfloat16
+        and w_vc.dtype == torch.bfloat16
+        and out.is_contiguous()
+        and w_vc.dim() == 3
+        and w_vc.shape[0] == out.shape[-2]
+        and w_vc.shape[1] == out.shape[-1]
+        and out.shape[-1] in (128, 256, 512)
+        and w_vc.shape[2] % 32 == 0
+    )

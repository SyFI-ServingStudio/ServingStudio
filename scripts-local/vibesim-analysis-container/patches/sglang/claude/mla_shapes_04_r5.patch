+    """Fused merge_kv_split -> per-head v_up bmm (-> x * sigmoid(gate)).
+
+    Returns [bs, H * N] with the rounding points of the unfused sequence
+    (bf16 merged latent, fp32-accumulated bmm to bf16, bf16 sigmoid, bf16
+    product). Caller checks merge_kv_split_vup_covered()."""
+    k = out.shape[0] // bs
+    num_heads, dv = out.shape[-2], out.shape[-1]
+    n = w_vc.shape[2]
+    y = torch.empty((bs, num_heads * n), dtype=out.dtype, device=out.device)
+    # One K step over the whole latent keeps every load in flight; measured
+    # at 1x1M (BLOCK_K 128 -> 512: 5.1 -> ~3 us).
+    block_n = 32
+    if gate is not None:
+        assert gate.is_contiguous() and gate.shape == y.shape
+    _kv_split_merge_vup_kernel[(bs, num_heads, n // block_n)](
+        out,
+        lse,
+        seq_lens,
+        w_vc,
+        gate if gate is not None else y,
+        y,
+        bs,
+        w_vc.stride(0),
+        w_vc.stride(1),
+        w_vc.stride(2),
+        K=k,
+        H=num_heads,
+        DV=dv,
+        N=n,
+        BLOCK_K=dv,
+        BLOCK_N=block_n,
+        HAS_GATE=gate is not None,
+        num_warps=8,
+    )
+    return y

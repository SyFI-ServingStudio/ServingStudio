+    den = 0.0
+    for c in tl.static_range(K):
+        row = c * bs + i
+        valid = tl.load(sl2_ptr + row) > 0
+        la = tl.load(lse_ptr + row.to(tl.int64) * H + h)
+        den += tl.where(valid, tl.exp2(la - m), 0.0)
+    has = den > 0
+    inv = 1.0 / tl.where(has, den, 1.0)
+    offs_n = nb * BLOCK_N + tl.arange(0, BLOCK_N)
+    acc = tl.zeros([BLOCK_N], dtype=tl.float32)
+    for k0 in tl.static_range(0, DV, BLOCK_K):
+        offs_k = k0 + tl.arange(0, BLOCK_K)
+        mk = tl.zeros([BLOCK_K], dtype=tl.float32)
+        v0 = tl.zeros([BLOCK_K], dtype=tl.float32)
+        for c in tl.static_range(K):
+            row = c * bs + i
+            valid = tl.load(sl2_ptr + row) > 0

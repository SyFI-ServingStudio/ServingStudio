diff -ruN -x __pycache__ -x '*.pyc' a/kernels/ops/attention/kda_chunk_h.py b/kernels/ops/attention/kda_chunk_h.py
--- a/kernels/ops/attention/kda_chunk_h.py	1969-12-31 16:00:00.000000000 -0800
+++ b/kernels/ops/attention/kda_chunk_h.py	2026-10-04 12:58:27.368431099 -0700
@@ -0,0 +1,133 @@
+"""CUDA chunked gated delta-rule state scan for KDA chunked prefill.
+
+Drop-in for the Triton ``chunk_gated_delta_rule_fwd_kernel_h_blockdim64`` on
+the per-channel-gate path used by chunk_kda (gk in log2 space, K = 128, no
+scalar g, no state tracking). See csrc/attention/kda_chunk_h.cuh; the result
+is bit-identical to the Triton kernel. ``covered()`` gates the inputs, the
+caller falls back to Triton for everything else.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Optional, Tuple
+
+import torch
+
+from sglang.kernels.jit.utils import (
+    cache_once,
+    is_arch_support_pdl,
+    load_jit,
+    make_cpp_args,
+)
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+_STAGES = 4
+
+
+@cache_once
+def _jit_kda_chunk_h_module() -> Module:
+    args = make_cpp_args(_STAGES, is_arch_support_pdl())
+    return load_jit(
+        "kda_chunk_h",
+        *args,
+        cuda_files=["attention/kda_chunk_h.cuh"],
+        cuda_wrappers=[("run", f"KdaChunkHKernel<{args}>::run")],
+        extra_cuda_cflags=["-O3"],
+    )
+
+
+@cache_once
+def _arch_ok(device_index: int) -> bool:
+    return torch.cuda.get_device_capability(device_index)[0] >= 8
+
+
+def covered(
+    k: torch.Tensor,
+    w: torch.Tensor,
+    u: torch.Tensor,
+    g: Optional[torch.Tensor],
+    gk: Optional[torch.Tensor],
+    initial_state: Optional[torch.Tensor],
+    initial_state_indices: Optional[torch.Tensor],
+    save_new_value: bool,
+    cu_seqlens: Optional[torch.Tensor],
+    use_exp2: bool,
+    inplace_update: bool,
+    track_state: Optional[torch.Tensor],
+    final_state: Optional[torch.Tensor] = None,
+    final_state_indices: Optional[torch.Tensor] = None,
+) -> bool:
+    return (
+        k.is_cuda
+        and gk is not None
+        and g is None
+        and use_exp2
+        and save_new_value
+        and track_state is None
+        and (initial_state is None or (inplace_update and initial_state_indices is not None))
+        and (final_state is None or final_state_indices is not None)
+        and k.shape[-1] == 128
+        and u.shape[-1] % 16 == 0
+        and k.dtype == torch.bfloat16
+        and w.dtype == torch.bfloat16
+        and u.dtype == torch.bfloat16
+        and gk.dtype == torch.float32
+        and k.is_contiguous()
+        and w.is_contiguous()
+        and u.is_contiguous()
+        and gk.is_contiguous()
+        and (cu_seqlens is None or cu_seqlens.dtype == torch.int32)
+        and (
+            initial_state_indices is None or initial_state_indices.dtype == torch.int32
+        )
+        and (
+            final_state_indices is None or final_state_indices.dtype == torch.int32
+        )
+        and _arch_ok(k.device.index)
+    )
+
+
+def kda_chunk_h(
+    k: torch.Tensor,
+    w: torch.Tensor,
+    u: torch.Tensor,
+    gk: torch.Tensor,
+    initial_state: Optional[torch.Tensor],
+    initial_state_indices: Optional[torch.Tensor],
+    cu_seqlens: Optional[torch.Tensor],
+    num_chunks: int,
+    final_state: Optional[torch.Tensor] = None,
+    final_state_indices: Optional[torch.Tensor] = None,
+    h_out: Optional[torch.Tensor] = None,
+    v_new_out: Optional[torch.Tensor] = None,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """Returns (h [B, NT, H, V, K], v_new like u). The scan starts from the
+    slots selected by initial_state_indices and writes the final state to the
+    slots selected by final_state_indices (default: the initial ones, i.e. in
+    place). Caller must have checked covered()."""
+    B, _, H, V = u.shape
+    h = k.new_empty(B, num_chunks, H, V, k.shape[-1]) if h_out is None else h_out
+    v_new = torch.empty_like(u) if v_new_out is None else v_new_out
+    if final_state is None:
+        final_state, final_state_indices = initial_state, initial_state_indices
+    has_state = initial_state is not None
+    has_final = final_state is not None
+    _jit_kda_chunk_h_module().run(
+        k,
+        u,
+        w,
+        gk,
+        v_new,
+        h,
+        initial_state if has_state else h,
+        initial_state_indices if has_state else h,
+        final_state if has_final else h,
+        final_state_indices if has_final else h,
+        cu_seqlens if cu_seqlens is not None else h,
+        has_state,
+        has_final,
+        cu_seqlens is not None,
+    )
+    return h, v_new
diff -ruN -x __pycache__ -x '*.pyc' a/kernels/ops/attention/kda_conv_l2norm.py b/kernels/ops/attention/kda_conv_l2norm.py
--- a/kernels/ops/attention/kda_conv_l2norm.py	1969-12-31 16:00:00.000000000 -0800
+++ b/kernels/ops/attention/kda_conv_l2norm.py	2026-10-04 12:58:27.371430846 -0700
@@ -0,0 +1,100 @@
+"""Fused KDA prefill front: packed-qkv causal conv1d + SiLU + q/k l2norm.
+
+Replaces causal_conv1d_fn over the packed [T, q | k | v] width followed by two
+l2norm_fwd_strided_heads calls, bit-identically (see
+csrc/attention/kda_conv_l2norm.cuh). ``covered()`` gates the inputs; the caller
+keeps the unfused path for everything else.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, List, Optional, Tuple
+
+import torch
+
+from sglang.kernels.jit.utils import cache_once, load_jit
+
+# Tokens per CTA strip; must match kStripTokens in kda_conv_l2norm.cuh.
+_STRIP_TOKENS = 128
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+
+@cache_once
+def _jit_kda_conv_l2norm_module() -> Module:
+    return load_jit(
+        "kda_conv_l2norm",
+        cuda_files=["attention/kda_conv_l2norm.cuh"],
+        cuda_wrappers=[("run", "KdaConvL2normKernel::run")],
+        extra_cuda_cflags=["-O3"],
+    )
+
+
+def covered(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: Optional[torch.Tensor],
+    conv_state: torch.Tensor,
+    cache_indices: Optional[torch.Tensor],
+    q_dim: int,
+    k_dim: int,
+    v_dim: int,
+    head_dim: int,
+) -> bool:
+    """x: [T, q_dim + k_dim + v_dim]; conv_state: [slots, 3, dim] (the pool's
+    native layout, not the transposed view causal_conv1d_fn takes)."""
+    dim = x.shape[-1]
+    return (
+        x.is_cuda
+        and x.dim() == 2
+        and x.stride(1) == 1
+        and x.stride(0) % 8 == 0
+        and x.data_ptr() % 16 == 0
+        and x.dtype == torch.bfloat16
+        and weight.dtype == torch.float32
+        and weight.shape == (dim, 4)
+        and weight.is_contiguous()
+        and bias is None
+        and conv_state.dtype == torch.bfloat16
+        and conv_state.dim() == 3
+        and conv_state.shape[1:] == (3, dim)
+        and conv_state.stride(2) == 1
+        and conv_state.stride(1) == dim
+        and conv_state.stride(0) % 8 == 0
+        and cache_indices is not None
+        and cache_indices.dtype == torch.int32
+        and head_dim == 128
+        and q_dim == k_dim == v_dim
+        and q_dim % 256 == 0
+        and dim == q_dim + k_dim + v_dim
+    )
+
+
+def kda_conv_l2norm(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    conv_state: torch.Tensor,
+    cache_indices: torch.Tensor,
+    has_initial_state: Optional[torch.Tensor],
+    query_start_loc: torch.Tensor,
+    seq_lens_cpu: List[int],
+    eps: float = 1e-6,
+) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Returns contiguous (l2norm(q), l2norm(k), v), each [T, dim / 3], and
+    updates conv_state in place. Caller must have checked covered()."""
+    T, dim = x.shape
+    out = x.new_empty(3, T, dim // 3)
+    _jit_kda_conv_l2norm_module().run(
+        x,
+        weight,
+        conv_state,
+        cache_indices,
+        has_initial_state if has_initial_state is not None else cache_indices,
+        query_start_loc,
+        out,
+        sum((n + _STRIP_TOKENS - 1) // _STRIP_TOKENS for n in seq_lens_cpu),
+        eps,
+        has_initial_state is not None,
+    )
+    return out[0], out[1], out[2]

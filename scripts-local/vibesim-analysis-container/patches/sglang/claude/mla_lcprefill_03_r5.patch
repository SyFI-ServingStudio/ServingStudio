diff -ruN -x __pycache__ -x '*.pyc' a/kernels/ops/attention/mla_kv_b_proj_pack_fp8.py b/kernels/ops/attention/mla_kv_b_proj_pack_fp8.py
--- a/kernels/ops/attention/mla_kv_b_proj_pack_fp8.py	1969-12-31 16:00:00.000000000 -0800
+++ b/kernels/ops/attention/mla_kv_b_proj_pack_fp8.py	2026-09-27 15:30:49.060115541 -0700
@@ -0,0 +1,201 @@
+"""Fused MLA ``kv_b_proj`` + FP8 K/V pack for chunked-prefix prefill on SM100.
+
+Bit-identical to ``kv_b_proj`` (BF16 GEMM) followed by the unit-scale
+``mla_kv_pack_quantize_fp8``, without materializing the BF16 ``[s, h, nope + v]``
+projection: the GEMM epilogue writes FP8 K-nope / V straight into the packed
+layout and a small kernel broadcasts the FP8 ``k_pe`` into every head.
+"""
+
+import functools
+from typing import Tuple
+
+import torch
+import triton
+import triton.language as tl
+
+_MMA_TILER_MN = (256, 256)
+# Swept on B200 at 131072 x 3072 x 512: (2, 2) 310 us vs (2, 1) 352 us.
+_CLUSTER_SHAPE_MN = (2, 2)
+
+
+@functools.lru_cache(maxsize=None)
+def is_supported() -> bool:
+    return torch.cuda.get_device_capability() == (10, 0)
+
+
+@triton.jit
+def _k_pe_broadcast_fp8_kernel(
+    k_pe_ptr,
+    k_out_ptr,
+    s_total,
+    k_pe_stride_t,
+    k_out_stride_t,
+    k_out_stride_h,
+    NUM_HEADS: tl.constexpr,
+    QK_NOPE: tl.constexpr,
+    QK_ROPE: tl.constexpr,
+    BLOCK_T: tl.constexpr,
+):
+    t_idx = tl.program_id(0) * BLOCK_T + tl.arange(0, BLOCK_T)
+    t_mask = t_idx < s_total
+    rope_idx = tl.arange(0, QK_ROPE)
+    k_pe = tl.load(
+        k_pe_ptr + t_idx[:, None] * k_pe_stride_t + rope_idx[None, :],
+        mask=t_mask[:, None],
+    )
+    k_pe_fp8 = k_pe.to(tl.float32).to(tl.float8e4nv)
+    base = k_out_ptr + t_idx[:, None] * k_out_stride_t + QK_NOPE + rope_idx[None, :]
+    for h in tl.static_range(NUM_HEADS):
+        tl.store(base + h * k_out_stride_h, k_pe_fp8, mask=t_mask[:, None])
+
+
+@functools.lru_cache(maxsize=None)
+def _compile(num_heads: int, kv_lora_rank: int, qk_nope: int, qk_rope: int, v_head: int):
+    import cuda.bindings.driver as cuda
+    import cutlass
+    import cutlass.cute as cute
+    import cutlass.utils as utils
+    from cutlass.cute.runtime import make_ptr
+
+    from sglang.kernels.ops.gemm.dense_gemm_sm100_fp8_via_bf16_epilogue import (
+        PersistentDenseGemmKernel,
+    )
+
+    gemm = PersistentDenseGemmKernel(
+        cutlass.Float32, True, _MMA_TILER_MN, _CLUSTER_SHAPE_MN, True
+    )
+    max_active_clusters = utils.HardwareInfo().get_max_active_clusters(
+        _CLUSTER_SHAPE_MN[0] * _CLUSTER_SHAPE_MN[1]
+    )
+    head_rows = qk_nope + v_head
+    k_row = num_heads * (qk_nope + qk_rope)
+    v_row = num_heads * v_head
+    w_numel = num_heads * head_rows * kv_lora_rank
+
+    @cute.jit
+    def run(
+        a_ptr: cute.Pointer,
+        w_ptr: cute.Pointer,
+        k_ptr: cute.Pointer,
+        v_ptr: cute.Pointer,
+        m: cutlass.Int32,
+        stream: cuda.CUstream,
+    ):
+        # Weight rows are [head, nope + v]; the per-head nope / v row blocks
+        # become the N modes of two GEMMs, so no reordered weight copy is kept.
+        a = cute.make_tensor(
+            a_ptr,
+            cute.make_layout(
+                (m, kv_lora_rank, 1), stride=(kv_lora_rank, 1, m * kv_lora_rank)
+            ),
+        )
+        w_stride = ((kv_lora_rank, head_rows * kv_lora_rank), 1, w_numel)
+        w_k = cute.make_tensor(
+            w_ptr,
+            cute.make_layout(((qk_nope, num_heads), kv_lora_rank, 1), stride=w_stride),
+        )
+        w_v = cute.make_tensor(
+            w_ptr + qk_nope * kv_lora_rank,
+            cute.make_layout(((v_head, num_heads), kv_lora_rank, 1), stride=w_stride),
+        )
+        k = cute.make_tensor(
+            k_ptr,
+            cute.make_layout(
+                (m, (qk_nope, num_heads), 1),
+                stride=(k_row, (1, qk_nope + qk_rope), m * k_row),
+            ),
+        )
+        v = cute.make_tensor(
+            v_ptr,
+            cute.make_layout(
+                (m, (v_head, num_heads), 1), stride=(v_row, (1, v_head), m * v_row)
+            ),
+        )
+        gemm(a, w_k, k, max_active_clusters, stream, lambda x: x)
+        gemm(a, w_v, v, max_active_clusters, stream, lambda x: x)
+
+    def ptr(dtype, align):
+        return make_ptr(dtype, 16, cute.AddressSpace.gmem, assumed_align=align)
+
+    compiled = cute.compile(
+        run,
+        ptr(cutlass.BFloat16, 16),
+        ptr(cutlass.BFloat16, 16),
+        ptr(cutlass.Float8E4M3FN, 16),
+        ptr(cutlass.Float8E4M3FN, 16),
+        cutlass.Int32(1),
+        cuda.CUstream(0),
+    )
+
+    def launch(kv_a, weight, k_out, v_out):
+        compiled(
+            make_ptr(cutlass.BFloat16, kv_a.data_ptr(), cute.AddressSpace.gmem, assumed_align=16),
+            make_ptr(cutlass.BFloat16, weight.data_ptr(), cute.AddressSpace.gmem, assumed_align=16),
+            make_ptr(cutlass.Float8E4M3FN, k_out.data_ptr(), cute.AddressSpace.gmem, assumed_align=16),
+            make_ptr(cutlass.Float8E4M3FN, v_out.data_ptr(), cute.AddressSpace.gmem, assumed_align=16),
+            cutlass.Int32(kv_a.shape[0]),
+            cuda.CUstream(torch.cuda.current_stream().cuda_stream),
+        )
+
+    return launch
+
+
+def mla_kv_b_proj_pack_fp8(
+    *,
+    kv_a: torch.Tensor,
+    k_pe: torch.Tensor,
+    weight: torch.Tensor,
+    num_heads: int,
+    qk_nope: int,
+    v_head: int,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """``kv_a [s, kv_lora]`` bf16, ``k_pe [s, 1, rope]`` or ``[s, rope]`` bf16,
+    ``weight [h * (nope + v), kv_lora]`` bf16. Returns ``(k [s, h, nope + rope],
+    v [s, h, v])`` in FP8 e4m3, unit scale."""
+    s, kv_lora_rank = kv_a.shape
+    k_pe_2d = k_pe.reshape(s, -1)
+    qk_rope = k_pe_2d.shape[1]
+    k_out = kv_a.new_empty((s, num_heads, qk_nope + qk_rope), dtype=torch.float8_e4m3fn)
+    v_out = kv_a.new_empty((s, num_heads, v_head), dtype=torch.float8_e4m3fn)
+    launch = _compile(num_heads, kv_lora_rank, qk_nope, qk_rope, v_head)
+    launch(kv_a, weight, k_out, v_out)
+    block_t = 32
+    _k_pe_broadcast_fp8_kernel[(triton.cdiv(s, block_t),)](
+        k_pe_2d,
+        k_out,
+        s,
+        k_pe_2d.stride(0),
+        k_out.stride(0),
+        k_out.stride(1),
+        NUM_HEADS=num_heads,
+        QK_NOPE=qk_nope,
+        QK_ROPE=qk_rope,
+        BLOCK_T=block_t,
+        num_warps=4,
+    )
+    return k_out, v_out
+
+
+def can_use(
+    *,
+    kv_a: torch.Tensor,
+    k_pe: torch.Tensor,
+    weight: torch.Tensor,
+    num_heads: int,
+    qk_nope: int,
+    v_head: int,
+) -> bool:
+    return (
+        is_supported()
+        and kv_a.dtype == torch.bfloat16
+        and k_pe.dtype == torch.bfloat16
+        and weight.dtype == torch.bfloat16
+        and kv_a.dim() == 2
+        and kv_a.shape[0] > 0
+        and tuple(weight.shape) == (num_heads * (qk_nope + v_head), kv_a.shape[1])
+        and kv_a.is_contiguous()
+        and weight.is_contiguous()
+        and k_pe.stride(-1) == 1
+        and kv_a.data_ptr() % 16 == 0
+        and weight.data_ptr() % 16 == 0
+    )

+    def _mixed_decode_split(
+        self: DeepseekV2AttentionMLA, backend, forward_batch: ForwardBatch
+    ) -> Optional[tuple[int, int]]:
+        """(prefill requests, prefill tokens) when the batch ends in 1-token
+        requests with a cached prefix (the decode rows a MIXED batch appends)
+        that the backend can serve with absorbed MLA decode; else None."""
+        seq_lens = forward_batch.extend_seq_lens_cpu
+        prefix_lens = forward_batch.extend_prefix_lens_cpu
+        supported = getattr(backend, "supports_mixed_decode_rows", None)
+        if (
+            supported is None
+            or seq_lens is None
+            or prefix_lens is None
+            or _is_hip
+            or self.use_dsa
+            or self.use_deep_gemm_bmm
+            or self.w_kc is None
+            or self.w_kc.dtype != torch.bfloat16
+            or self.w_vc.dtype != torch.bfloat16
+            or use_dense_prefix_kv(backend)
+            or torch.cuda.is_current_stream_capturing()
+            or not supported(forward_batch)
+        ):
+            return None
+        first = len(seq_lens)
+        while first > 0 and seq_lens[first - 1] == 1 and prefix_lens[first - 1] > 0:
+            first -= 1
+        if first == 0 or first == len(seq_lens):
+            return None
+        return first, sum(seq_lens[:first])
+
+    def _mixed_decode_rows_attn(
+        self: DeepseekV2AttentionMLA,
+        backend,
+        q: torch.Tensor,
+        forward_batch: ForwardBatch,
+        first_req: int,
+    ) -> torch.Tensor:
+        """Absorbed MLA attention of the decode rows q [n, H, qk_head_dim]
+        (post-RoPE, bf16) over their cached latent KV -> [n, H, v_head_dim]."""
+        q_nope, q_pe = q.split([self.qk_nope_head_dim, self.qk_rope_head_dim], dim=-1)
+        q_nope_out = torch.bmm(q_nope.transpose(0, 1), self.w_kc).transpose(0, 1)
+        latent = backend.forward_mixed_decode_rows(
+            q_nope_out, q_pe, self.attn_mqa, forward_batch, first_req
+        )
+        output = latent.new_empty((latent.shape[0], self.num_local_heads, self.v_head_dim))
+        torch.bmm(latent.transpose(0, 1), self.w_vc, out=output.transpose(0, 1))
+        return output
+
     def _overlap_causal_with_prefix(self: DeepseekV2AttentionMLA, backend) -> bool:
         if self.alt_stream is None or torch.cuda.is_current_stream_capturing():
             return False

+    b_var = tl.sum(b_x * b_x, axis=1)
+    b_y = b_x / tl.sqrt(b_var + eps)[:, None]
+    p_y = y + (o_r * D)[:, None] + o_d[None, :]
+    tl.store(p_y, b_y.to(y.dtype.element_ty), mask=m)
+
+

+def l2norm_fwd_strided_heads_kernel(
+    x,
+    y,
+    eps,
+    T,
+    stride_x,
+    H: tl.constexpr,
+    D: tl.constexpr,
+    BT: tl.constexpr,
+    BD: tl.constexpr,
+):
+    # l2norm_fwd_kernel over rows (token, head) of a [N, H, D] view whose
+    # token stride is stride_x (heads packed): same tile, same reduction.
+    i_t = tl.program_id(0)
+    o_r = i_t * BT + tl.arange(0, BT)
+    o_d = tl.arange(0, BD)
+    m = (o_r < T)[:, None] & (o_d < D)[None, :]
+    p_x = x + ((o_r // H) * stride_x + (o_r % H) * D)[:, None] + o_d[None, :]

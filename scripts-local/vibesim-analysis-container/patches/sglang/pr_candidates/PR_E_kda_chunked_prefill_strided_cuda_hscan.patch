+    """l2norm_fwd(x.contiguous()) for x = [1, N, H, D] with packed heads and
+    any token stride, without materializing the contiguous copy."""
+    _, N, H, D = x.shape
+    assert x.shape[0] == 1 and x.stride(-1) == 1 and x.stride(-2) == D
+    assert D <= 512
+    y = torch.empty(x.shape, dtype=x.dtype, device=x.device)
+    T = N * H
+    BT = 16
+    l2norm_fwd_strided_heads_kernel[(triton.cdiv(T, BT),)](
+        x,
+        y,
+        eps,
+        T=T,
+        stride_x=x.stride(1),
+        H=H,
+        D=D,
+        BT=BT,
+        BD=triton.next_power_of_2(D),
+        num_warps=8,
+        num_stages=3,
+    )
+    return y

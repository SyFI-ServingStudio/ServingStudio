+"""KV split for single-request MLA decode.
+
+At batch size 1 the TRT-LLM MLA decode launcher takes its DeepSeek
+min-latency branch and halves headDimPerCtaV, so two CTAs stream every KV
+tile. With few heads per rank (Kimi-K3: 12 at TP8) that path is
+bandwidth-bound on the duplicate read and puts few CTAs on a long context.
+Presenting the request as ``k`` page-aligned KV chunks (a pseudo-batch of
+``k * bs`` rows) keeps the full-V kernel and puts ``k`` times more CTAs on
+the read; the chunks are merged back through their LSE.
+
+Pseudo-batch layout: row ``c * bs + i`` holds KV chunk ``c`` of request
+``i``; each chunk covers ceil(pages_i / k) pages (the last ones may be
+shorter or empty).
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+# Chunks per request; measured on B200 at 1M context (k = 2: 118 us,
+# 4: 108, 16: 104 vs 131 us unsplit).
+KV_SPLIT_FACTOR = 8
+# Below this the replicate/merge/LSE overhead outweighs the bandwidth gain.
+KV_SPLIT_MIN_SEQ_LEN = 65536
+
+
+def kv_split_factor(batch_size: int, max_seq_len: int) -> int:
+    """Number of KV chunks per request; 0 disables the split."""
+    if batch_size == 1 and max_seq_len >= KV_SPLIT_MIN_SEQ_LEN:
+        return KV_SPLIT_FACTOR
+    return 0
+
+
+def kv_split_table_width(ncols: int, k: int, multiple: int = 2) -> int:
+    """Pages per pseudo-batch row: ceil(ncols / k), rounded up to ``multiple``
+    (the TRT-LLM kernel wants block_num % (128 / page_size) == 0; 2 at page
+    size 64)."""
+    w = -(-ncols // k)
+    multiple = max(int(multiple), 1)
+    return -(-w // multiple) * multiple
+
+
+@triton.jit
+def _kv_split_tables_kernel(
+    bt_ptr,  # [bs, stride_bt] int32
+    bt2_ptr,  # [k * bs, ncols2] int32
+    sl_ptr,  # [bs] int32
+    sl2_ptr,  # [k * bs] int32
+    bs,
+    k,
+    ncols,
+    ncols2,
+    stride_bt,
+    PAGE: tl.constexpr,
+    COL_BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    c = row // bs
+    src = row - c * bs
+    seq_len = tl.load(sl_ptr + src)
+    pages = (seq_len + PAGE - 1) // PAGE
+    pc = (pages + k - 1) // k
+    start = c * pc
+    new_len = tl.minimum(tl.maximum(seq_len - start * PAGE, 0), pc * PAGE)
+    tl.store(sl2_ptr + row, new_len)
+    for c0 in range(0, ncols2, COL_BLOCK):
+        cols = c0 + tl.arange(0, COL_BLOCK)
+        src_cols = cols + start
+        v = tl.load(
+            bt_ptr + src.to(tl.int64) * stride_bt + src_cols,
+            mask=(src_cols < ncols) & (cols < pc),
+            other=0,
+        )
+        tl.store(bt2_ptr + row.to(tl.int64) * ncols2 + cols, v, mask=cols < ncols2)
+
+
+@triton.jit
+def _kv_split_merge_kernel(
+    o_ptr,  # [k * bs, H, DV]; rows [0, bs) receive the merged output
+    lse_ptr,  # [k * bs, H] fp32, base 2
+    sl2_ptr,  # [k * bs] int32
+    bs,
+    K: tl.constexpr,
+    H: tl.constexpr,
+    DV: tl.constexpr,
+):
+    i = tl.program_id(0)
+    h = tl.program_id(1)
+    offs = tl.arange(0, DV)
+    m = -float("inf")
+    for c in tl.static_range(K):
+        row = c * bs + i
+        # The kernel skips an empty chunk: its output and LSE are stale.
+        valid = tl.load(sl2_ptr + row) > 0
+        la = tl.load(lse_ptr + row.to(tl.int64) * H + h)
+        m = tl.where(valid, tl.maximum(m, la), m)
+    acc = tl.zeros([DV], dtype=tl.float32)
+    den = 0.0
+    for c in tl.static_range(K):
+        row = c * bs + i
+        valid = tl.load(sl2_ptr + row) > 0
+        la = tl.load(lse_ptr + row.to(tl.int64) * H + h)
+        w = tl.where(valid, tl.exp2(la - m), 0.0)
+        v = tl.load(o_ptr + (row.to(tl.int64) * H + h) * DV + offs).to(tl.float32)
+        acc += tl.where(valid, v * w, 0.0)
+        den += w
+    base = (i.to(tl.int64) * H + h) * DV
+    v0 = tl.load(o_ptr + base + offs).to(tl.float32)
+    # Empty request (all chunks empty): keep row 0 as the kernel left it.
+    merged = tl.where(den > 0, acc / den, v0)
+    tl.store(o_ptr + base + offs, merged.to(o_ptr.dtype.element_ty))
+
+
+def build_kv_split_tables(
+    block_tables: torch.Tensor,
+    seq_lens: torch.Tensor,
+    out_block_tables: torch.Tensor,
+    out_seq_lens: torch.Tensor,
+    page_size: int,
+) -> None:
+    """Fill the (k * bs)-row pseudo-batch block table and seq_lens."""
+    bs = seq_lens.shape[0]
+    k = out_seq_lens.shape[0] // bs
+    ncols2 = out_block_tables.shape[1]
+    assert block_tables.dtype == torch.int32 and block_tables.stride(1) == 1
+    assert out_block_tables.is_contiguous() and k * bs == out_seq_lens.shape[0]
+    _kv_split_tables_kernel[(k * bs,)](
+        block_tables,
+        out_block_tables,
+        seq_lens,
+        out_seq_lens,
+        bs,
+        k,
+        block_tables.shape[1],
+        ncols2,
+        block_tables.stride(0),
+        PAGE=page_size,
+        COL_BLOCK=min(1024, triton.next_power_of_2(ncols2)),
+        num_warps=4,
+    )
+
+
+def expand_kv_split_query(query: torch.Tensor, k: int, bs: int) -> torch.Tensor:
+    """Return the (k * bs)-row pseudo-batch query (chunk-major replicas).
+
+    ``query`` holds either ``bs`` rows or ``k * bs`` rows whose first ``bs``
+    are filled; the latter is completed in place.
+    """
+    if query.shape[0] == bs:
+        return query.repeat((k,) + (1,) * (query.dim() - 1))
+    assert query.shape[0] == k * bs
+    rest = query[bs:].view((k - 1, bs) + tuple(query.shape[1:]))
+    rest.copy_(query[:bs].unsqueeze(0).expand_as(rest))
+    return query
+
+
+def merge_kv_split(
+    out: torch.Tensor, lse: torch.Tensor, seq_lens: torch.Tensor, bs: int
+) -> torch.Tensor:
+    """Merge the KV chunks into rows [0, bs) in place; return that view."""
+    k = out.shape[0] // bs
+    num_heads, head_dim_v = out.shape[-2], out.shape[-1]
+    _kv_split_merge_kernel[(bs, num_heads)](
+        out,
+        lse,
+        seq_lens,
+        bs,
+        K=k,
+        H=num_heads,
+        DV=head_dim_v,
+        num_warps=4,
+    )
+    return out[:bs]

+// ---- thread-block cluster (PTX ISA §9.7.13.4, §9.7.9.x mapa) ---------------
+
+// Split cluster barrier: every thread of every CTA in the cluster must arrive,
+// and phases alternate arrive -> wait.
+static SGL_DEVICE void cluster_arrive() {
+  asm volatile("barrier.cluster.arrive.release.aligned;" ::: "memory");
+}
+
+static SGL_DEVICE void cluster_wait() {
+  asm volatile("barrier.cluster.wait.acquire.aligned;" ::: "memory");
+}
+
+// Store to the same smem variable of CTA `rank` in this cluster (DSMEM).
+static SGL_DEVICE void st_cluster_f32(float* local_ptr, uint32_t rank, float value) {
+  uint32_t remote;
+  asm volatile("mapa.shared::cluster.u32 %0, %1, %2;" : "=r"(remote) : "r"(to_shared(local_ptr)), "r"(rank));
+  asm volatile("st.shared::cluster.f32 [%0], %1;" ::"r"(remote), "f"(value) : "memory");
+}

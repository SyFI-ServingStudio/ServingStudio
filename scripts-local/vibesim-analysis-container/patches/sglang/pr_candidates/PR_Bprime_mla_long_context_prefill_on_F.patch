+    @staticmethod
+    def _merge_chunk_state(merge_state, chunk_state, accum_output, accum_lse):
+        output, lse = chunk_state
+        tmp_output = torch.empty_like(accum_output)
+        tmp_lse = torch.empty_like(accum_lse)
+        merge_state(output, lse, accum_output, accum_lse, tmp_output, tmp_lse)
+        return tmp_output, tmp_lse
+
+    def _causal_attn_mha_on_alt_stream(
+        self: DeepseekV2AttentionMLA,
+        q: torch.Tensor,
+        k: torch.Tensor,
+        v: torch.Tensor,
+        forward_batch: ForwardBatch,
+        *,
+        after: torch.cuda.Event,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.cuda.Event]:
+        # Gated on the first chunk's K/V being packed, the causal CTAs share the
+        # SMs with that chunk's FMHA grid and fill its partial waves.
+        current_stream = torch.cuda.current_stream()
+        self.alt_stream.wait_event(after)
+        forward_batch.set_attn_attend_prefix_cache(False)
+        with torch.cuda.stream(self.alt_stream):
+            output, lse = self.attn_mha(q, k, v, forward_batch, save_kv_cache=False)
+        forward_batch.set_attn_attend_prefix_cache(True)
+        for t in (q, k, v):
+            t.record_stream(self.alt_stream)
+        output.record_stream(current_stream)
+        lse.record_stream(current_stream)
+        return output, lse, self.alt_stream.record_event()
+
+    def _overlap_causal_with_prefix(self: DeepseekV2AttentionMLA, backend) -> bool:
+        if self.alt_stream is None or torch.cuda.is_current_stream_capturing():
+            return False
+        can_overlap = getattr(backend, "can_overlap_causal_with_prefix", None)
+        return can_overlap is not None and can_overlap()

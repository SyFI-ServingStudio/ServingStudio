+# Measured on B200, 12-head fp8 MLA prefix pass: the full-correction cute-dsl
+# FMHA runs 16k x 49k in 3.29 ms vs 3.54 ms for the trtllm-gen cubin. The causal
+# pass stays on trtllm-gen: cute-dsl rounds differently, and on no-prefix
+# batches that alone shifts the layer output past the 1% mean-error budget.
+_cute_dsl_fp8_prefill_ok = True
+
+
+def _use_cute_dsl_fp8_prefill(q, k, v, out, is_causal: bool) -> bool:
+    return (
+        _cute_dsl_fp8_prefill_ok
+        and not is_causal
+        and cute_dsl_fmha_fp8.is_supported()
+        and q.dtype == k.dtype == v.dtype == torch.float8_e4m3fn
+        and out is not None
+        and out.dtype == torch.bfloat16
+        and out.data_ptr() % 32 == 0  # kernel uses 256-bit stores
+    )
+
+

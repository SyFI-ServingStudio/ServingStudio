+    def _packs_fp8_prefill_kv(self, forward_batch: ForwardBatch) -> bool:
+        """The ragged prefill kernel reads unit-scale fp8 Q/K/V; the fp8 cast
+        is exact either way, so doing it at pack time only drops the bf16
+        concat + strided cast passes. Not for the flashinfer fallback, which
+        wants bf16 inputs."""
+        return (
+            self.data_type == torch.float8_e4m3fn
+            and forward_batch.forward_mode.is_extend()
+            and not forward_batch.forward_mode.is_target_verify()
+            and not forward_batch.forward_mode.is_draft_extend_v2()
+            and self.forward_prefill_metadata is not None
+            and not self.forward_prefill_metadata.fallback_to_flashinfer_impl
+        )
+
+    def pack_extend_kv(
+        self,
+        k_nope: torch.Tensor,
+        k_pe: torch.Tensor,
+        v: torch.Tensor,
+        layer: RadixAttention,
+        forward_batch: ForwardBatch,
+    ) -> Optional[tuple[torch.Tensor, torch.Tensor]]:
+        """Build the current chunk's fp8 K = [k_nope | k_pe] and fp8 V in one
+        launch (bit-identical to concat + ``.to(fp8)``). Returns None when the
+        default bf16 path must be kept."""
+        if not self._packs_fp8_prefill_kv(forward_batch):
+            return None
+        if getattr(layer, "k_scale_float", None) not in (None, 1.0) or getattr(
+            layer, "v_scale_float", None
+        ) not in (None, 1.0):
+            return None
+        return mla_kv_pack_quantize_fp8(k_nope, k_pe, v, enable_pdl=False)
+
+    def pack_prefix_chunk_kv(
+        self,
+        k_nope: torch.Tensor,
+        k_pe: torch.Tensor,
+        v: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Pack a materialized prefix chunk into contiguous K/V for the ragged
+        kernel: unit-scale fp8 in one launch for the fp8 KV cache, else the
+        bf16 concat."""
+        if self.data_type == torch.float8_e4m3fn:
+            return mla_kv_pack_quantize_fp8(k_nope, k_pe, v, enable_pdl=False)
+        k = k_nope.new_empty(
+            (k_nope.shape[0], k_nope.shape[1], k_nope.shape[2] + k_pe.shape[-1])
+        )
+        k[..., : k_nope.shape[-1]] = k_nope
+        k[..., k_nope.shape[-1] :] = k_pe
+        return k, v
+
+    def prepare_chunked_prefill_qkv(
+        self,
+        q: torch.Tensor,
+        k: torch.Tensor,
+        v: torch.Tensor,
+        forward_batch: ForwardBatch,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        """Cast Q once for the causal pass and every prefix pass (each ragged
+        launch would otherwise re-cast the same bf16 Q)."""
+        if self._packs_fp8_prefill_kv(forward_batch):
+            q = q.to(torch.float8_e4m3fn)
+        return q, k, v

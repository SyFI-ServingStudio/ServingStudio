+    #[test]
+    fn decode_input_keeps_prefill_out_of_the_decode_only_leaf() {
+        let input = KimiK3KdaLocalWorkletInput {
+            batch_tokens: 17,
+            decode_tokens: 5,
+            prefill_chunk_pairs: Vec::new(),

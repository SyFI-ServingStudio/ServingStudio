+                selected_k: cfg.selected_k,
+                latent_dim: cfg.kv_lora_rank.clone(),
+                rope_dim: cfg.rope_dim.clone(),
+                value_dim: cfg.kv_lora_rank.clone(),
+                softmax_scale_denominator: cfg.softmax_scale_denominator,

diff --git a/presets/glm52_nvfp4_b200_ep4_diverse.yaml b/presets/glm52_nvfp4_b200_ep4_diverse.yaml
new file mode 100644
index 00000000..184ac127
--- /dev/null
+++ b/presets/glm52_nvfp4_b200_ep4_diverse.yaml
@@ -0,0 +1,46 @@
+# GLM-5.2 NVFP4 on one four-GPU B200 NVLink domain, driven by the 100-request
+# diverse workload instead of a single shape. Same deployment as
+# glm52_nvfp4_b200_ep4.yaml; the context limit and the KV budget are what differ,
+# and both follow from the trace.
+deployment: unified
+
+workload:
+  trace_files:
+    - trace/diverse_100.csv
+  input_file_format: text-generation-independent
+  arrival_mode: trace_timed
+  session_dependency: independent
+  run_to_end: true
+
+io:
+  log_dir: logs/glm52_nvfp4_b200_ep4_diverse
+
+pools:
+  main:
+    groups:
+      - gpu: "NVIDIA B200"
+        replicas: 1
+        arch:
+          type: glm52_vllm_nvfp4_dsa_moe
+          model_config: model/config/glm52_nvfp4.json
+          fp8: false
+          ep_size: 4
+          nvl_num_gpu: 4
+          # The trace's largest request is 131,071 tokens of context, which is
+          # what this limit is sized to admit.
+          max_model_len: 131072
+          routing: uniform
+          mtp_mode: "off"
+        worker:
+          type: hp_unified
+          # Measured KV capacity at this context limit and gpu_memory_utilization
+          # 0.85, taken from alignment case 13, which runs the same deployment at
+          # the same limit (`GPU KV cache size: C tokens` in the workload-only
+          # server log, C * 55_224 / 1e9). The 8192-context preset's 120.0 does
+          # not carry over: raising the context limit costs KV capacity.
+          #
+          # That leaves 676,160 tokens of KV against a trace carrying 2,196,962,
+          # so the run is admission-bound rather than compute-bound at full
+          # arrival. That is the intended shape of this workload, not a budget to
+          # widen until the queue disappears.
+          attn_gpu_memory_gb: 37.34025984
diff --git a/presets/glm52_nvfp4_b200_ep4_speculative.yaml b/presets/glm52_nvfp4_b200_ep4_speculative.yaml
new file mode 100644
index 00000000..30218afe
--- /dev/null
+++ b/presets/glm52_nvfp4_b200_ep4_speculative.yaml
@@ -0,0 +1,45 @@
+# GLM-5.2 NVFP4 on one four-GPU B200 NVLink domain, driving its MTP layer as a
+# real drafter. Same rank group and context cap as `glm52_nvfp4_b200_ep4.yaml`,
+# so the two are directly comparable; the difference is that an iteration here
+# is one target verify over `draft_tokens + 1` rows per resident decode plus
+# `draft_tokens` draft passes, and a request advances by its accepted chain.
+#
+# Per-request acceptance comes from the tagged trace's `accept_rate` column.
+# This smoke uses a synthetic 0.65 conditional acceptance at every position.
+deployment: unified
+
+workload:
+  trace_files:
+    - presets/glm52_spec5_smoke.csv
+  input_file_format: text-generation-independent
+  input_file_tags: [speculative]
+  arrival_mode: trace_timed
+  session_dependency: independent
+  run_to_end: true
+
+io:
+  log_dir: logs/glm52_nvfp4_b200_ep4_speculative
+
+pools:
+  main:
+    groups:
+      - gpu: "NVIDIA B200"
+        replicas: 1
+        arch:
+          type: glm52_vllm_nvfp4_dsa_moe_speculative
+          model_config: model/config/glm52_nvfp4.json
+          fp8: false
+          ep_size: 4
+          nvl_num_gpu: 4
+          max_model_len: 8192
+          routing: uniform
+          mtp_mode: index_share
+          draft_tokens: 5
+        worker:
+          type: speculative
+          attn_gpu_memory_gb: 120.0
+          # Decode spends this cap in query rows, so a resident decode costs the
+          # whole verify width here, not one row.
+          max_batch_tokens: 8192
+          # Must match the arch's: the width selects a profiled kernel shape.
+          draft_tokens: 5
diff --git a/presets/glm52_nvfp4_b200_sglang_tp4_diverse.yaml b/presets/glm52_nvfp4_b200_sglang_tp4_diverse.yaml
new file mode 100644
index 00000000..1e4d9d41
--- /dev/null
+++ b/presets/glm52_nvfp4_b200_sglang_tp4_diverse.yaml
@@ -0,0 +1,62 @@
+# GLM-5.2 NVFP4 pure TP4 under the SGLang scheduler contract captured by the
+# alignment run. This preset keeps the framework-facing scheduler decisions
+# explicit instead of relying on simulator defaults.
+deployment: unified
+
+workload:
+  trace_files:
+    - trace/diverse_100.csv
+  input_file_format: text-generation-independent
+  arrival_mode: trace_timed
+  # Trace timestamps are already the captured absolute millisecond schedule.
+  # VibeSim scales trace_timed timestamps by request_rate, so 1.0 is required
+  # to preserve them exactly.
+  request_rate: 1.0
+  session_dependency: independent
+  run_to_end: true
+
+io:
+  log_dir: logs/glm52_nvfp4_b200_sglang_tp4_diverse
+
+pools:
+  main:
+    groups:
+      - gpu: "NVIDIA B200"
+        replicas: 1
+        arch:
+          type: glm52_sglang_nvfp4_tp_dsa_moe
+          model_config: model/config/glm52_nvfp4.json
+          fp8: false
+          tp_size: 4
+          max_model_len: 131072
+          routing: custom
+          routing_seed: null
+          expert_popularity_file: presets/alignment/glm52_nvfp4_b200_sglang_tp4/expert_popularity.json
+          mtp_mode: "off"
+        worker:
+          type: chunked_prefill
+          # Captured SGLang: chunked_prefill_size=2048 and
+          # enable_mixed_chunk=False. This selects the mechanism, not a fitted
+          # throughput target: a runnable prefill produces a prefill-only
+          # iteration, and resident decode resumes afterward.
+          max_batch_tokens: 2048
+          batch_policy: separate-prefill-priority
+          # Source-defined SGLang KV admission/retraction mechanics. These are
+          # server defaults from the pinned capture, not fitted simulator
+          # parameters.
+          kv_admission_policy: bounded-future
+          kv_page_size: 1
+          kv_max_future_tokens: 4096
+          kv_initial_new_token_ratio: 0.7
+          kv_minimum_new_token_ratio: 0.098
+          kv_new_token_ratio_decay_steps: 600
+          kv_retract_decode_steps: 20
+          decode_retraction_policy: length
+          # Kernel timing remains unscaled in this scheduler baseline. A
+          # measured duty-cycle multiplier belongs to an alignment result, not
+          # to the scheduler mechanism itself.
+          gpu_time_multiplier: 1.0
+          # max_total_num_tokens=817408 in the captured SGLang deployment at
+          # mem_fraction_static=0.85. With 220896 whole-model KV bytes/token and
+          # TP4 replication accounting: 817408 * 220896 / 4 bytes.
+          attn_gpu_memory_gb: 45.140539392

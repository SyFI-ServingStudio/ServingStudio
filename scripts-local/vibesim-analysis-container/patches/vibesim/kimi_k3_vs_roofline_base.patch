+def _build_sglang_page_planar_fp8_operands(
+    torch: Any,
+    *,
+    num_tokens: int,
+    kv_lora_rank: int,
+    rope_dim: int,
+    block_size: int,
+    torch_dtype: Any,
+    device: Any,
+) -> _SglangPagePlanarFp8Operands:
+    """Allocate SGLang's flattened paged pool and scattered decode inputs."""

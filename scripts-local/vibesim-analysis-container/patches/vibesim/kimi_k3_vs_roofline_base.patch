+schema_version: 1
+pack: glm52_nvfp4_b200_tp8
+description: GLM-5.2 NVFP4 on B200, EP8/TP8/DP1 under vLLM (whole 8-GPU NVLink
+  domain) -- Coral Bricks production topology. Derived from the accepted TP4/EP4
+  pack `glm52_nvfp4_b200` with only the topology changed; see make_tp8_pack.py.
+
+# The machine that produced the accepted numbers, as facts rather than as a
+# runnable config. A host profile is a local file (only hosts/example.yaml is
+# tracked) because its contents are absolute paths to an HF cache and a 1 GB
+# corpus -- uncommittable, and named after whoever's directory they sit in.
+# These four things are what a reader actually needs to judge the numbers, and
+# none of them is a path.
+recorded_on:
+  host: coral_b200
+  gpu: NVIDIA B200
+  # Relative to the host's hf_hub_root. A different snapshot is a different
+  # model, so the hash is part of the result, not part of the machine.
+  checkpoint_snapshots:
+    glm52_nvfp4: models--nvidia--GLM-5.2-NVFP4/snapshots/aec724e8c7b8ee9db3b48c01c320f63f9cdaf8aa
+  # The profiler version is an input to every measured duration.
+  nsys_version: 2025.5.2
+  # What `cases[].device_role` meant on that box. GPU 4 was approved but held by
+  # an unrelated service, which is why the two halves are not interchangeable.
+  device_roles:
+    primary: '0,1,2,3,4,5,6,7'
+
+variants:
+  tp8_ep8_dp1:
+    deployment: unified
+    gpu: NVIDIA B200
+    replicas: 1
+    checkpoint: glm52_nvfp4
+    engine: vllm
+    backend: vllm_tokens
+    run_name_prefix: glm52_b200_tp8_ep8
+    server:
+      tp_size: 8
+      dp_size: 1
+      chunk_size: 2048
+      max_cudagraph_capture_size: 2048
+      enable_server_load_tracking: true
+      extra_args:
+      - --enable-expert-parallel
+      - --kv-cache-dtype
+      - fp8_e4m3
+    arch:
+      type: glm52_vllm_nvfp4_dsa_moe
+      model_config: model/config/glm52_nvfp4.json
+      fp8: false
+      ep_size: 8
+      nvl_num_gpu: 8
+      routing: custom
+      expert_popularity_file: expert_popularity.json
+      mtp_mode: 'off'
+    worker:
+      type: chunked_prefill
+      max_batch_tokens: 2048
+      batch_policy: mix
+    profile_passes:
+    - kind: nsys
+      name: profile_nsys
+      trace: kernel
+    - kind: workload_metrics
+      name: profile_workload
+      trace: workload
+    input_builder:
+      type: vllm_text
+      measured_phase: forward
+      group_assignment: per_dp_rank
+    label_rules: label_rules/manifest.json
+cases:
+- index: 1
+  name: micro_throughput_c256
+  variant: tp8_ep8_dp1
+  purpose: Maximum request batching and scheduler pressure.
+  coverage:
+  - batching
+  - scheduler_pressure
+  max_model_len: 8192
+  max_concurrency: 256
+  profile_arrival_mode: saturated
+  simulation_arrival_mode: saturated
+  gpu_memory_utilization: 0.75
+  capture_seconds: 15.0
+  device_role: primary
+  workload_trace:
+    file: traces/01_micro_throughput_c256.csv
+    shapes:
+    - - 16
+      - 16
+    - - 32
+      - 32
+    - - 64
+      - 64
+    - - 128
+      - 64
+    repeats: 256
+  attn_gpu_memory_gb:
+    value: 75.9917583
+    status: measured
+    derived_from: '`GPU KV cache size: C tokens` in the workload-only server log; C * 55_224 / 1e9'
+    evidence: tp8_20260901/01_micro_throughput_c256/profile_workload/vllm/glm52_b200_tp8_ep8_01_micro_throughput_c256_workload_server.log
+  provenance:
+    accepted_run: logs/20260827_0_glm52_nvfp4_l1_clean_alignment/cases/01_micro_throughput_c256
+    capture_source: logs/20260826_0_glm52_b200_ep4_workload_matrix_realign/cases/01_micro_throughput_c256
+- index: 2
+  name: graph_boundaries_c128
+  variant: tp8_ep8_dp1
+  purpose: CUDA graph and small-batch kernel boundaries.
+  coverage:
+  - cuda_graph_boundaries
+  - small_batch
+  max_model_len: 8192
+  max_concurrency: 128
+  profile_arrival_mode: saturated
+  simulation_arrival_mode: saturated
+  gpu_memory_utilization: 0.75
+  capture_seconds: 15.0
+  device_role: primary
+  # This case's subject IS the small-batch and CUDA-graph boundary region, which
+  # the profiler's default 24-48 analysis window starts after. Widened to the
+  # whole capture in the accepted run; without this the pack would re-run it
+  # against a different iteration population than the recorded numbers.
+  analyze_iterations: [0, 239]
+  workload_trace:
+    file: traces/02_graph_boundaries_c128.csv

+                backends: cfg.prefill_projection_backends.clone(),
+                gpu_name: cfg.gpu_name.clone(),
+                n: cfg.hidden.clone(),
+                k: (heads * cfg.v_head_dim.get()).into(),
+                dtype: cfg.dtype,

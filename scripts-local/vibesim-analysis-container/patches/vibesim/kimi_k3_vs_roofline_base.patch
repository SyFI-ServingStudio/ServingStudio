+            .kda_attention
+            .as_ref()
+            .map(KimiK3KdaLocalWorklet::resolve_config),
+        kda_moe: cfg
+            .kda_moe
+            .as_ref()
+            .map(KimiK3MoeLocalWorklet::resolve_config),
+        mla_attention: cfg
+            .mla_attention
+            .as_ref()
+            .map(KimiK3MlaLocalWorklet::resolve_config),

+        KdaFusedDecodeKernelConfig {
+            backends: vec!["sglang_fused"],
+            gpu_name: "NVIDIA B200".to_string(),
+            num_heads: 12.into(),
+            head_k_dim: 128.into(),
+            head_v_dim: 128.into(),

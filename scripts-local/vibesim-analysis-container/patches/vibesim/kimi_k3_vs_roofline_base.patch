+
+#[derive(KernelConfig, Hash, PartialEq, Eq, Clone, Debug, serde::Serialize, serde::Deserialize)]
+pub struct Mxfp4FusedMoeKernelConfig {
+    #[serde(deserialize_with = "de_backends")]

+def test_mla_runner_rejects_kv_allocations_beyond_the_profile_pool():
+    from profiling.runners.attention.mla_decode_attention import (
+        _build_operands,
+        _validate_args,
+    )
+    from profiling.runners.exceptions import ProfilerNotImplemented
+
+    args = _validate_args(
+        12,

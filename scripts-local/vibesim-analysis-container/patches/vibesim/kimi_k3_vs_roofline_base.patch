+            )?,
+            kda_fused_decode,
+            kda_conv_prefill,
+            kda_chunk_prefill,
+            kda_gated_norm_prefill,
+            kda_conv_decode,
+            kda_recurrent_decode,
+            kda_gated_norm,
+            o_proj: build_atomic(

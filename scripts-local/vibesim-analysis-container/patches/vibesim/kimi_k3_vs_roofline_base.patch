+                num_batches: cfg.heads.clone(),
+                n: cfg.v_head_dim.clone(),
+                k: cfg.kv_lora_rank.clone(),
+                dtype: cfg.dtype,
+            },
+            output_gate: SingleGemmKernelConfig {
+                backends: cfg.projection_backends.clone(),
+                gpu_name: cfg.gpu_name.clone(),

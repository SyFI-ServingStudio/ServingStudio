+
+    #[test]
+    fn kind_backend_and_coords_are_stable() {
+        let cfg = config();
+        assert_eq!(KdaFusedDecodeSpec::KIND, "kda_fused_decode");
+        assert_eq!(cfg.backends(), &["sglang_fused"]);
+        assert_eq!(

+"""CUDA chunked gated delta-rule state scan for KDA chunked prefill.
+
+Drop-in for the Triton ``chunk_gated_delta_rule_fwd_kernel_h_blockdim64`` on
+the per-channel-gate path used by chunk_kda (gk in log2 space, K = 128, no
+scalar g, no state tracking). See csrc/attention/kda_chunk_h.cuh; the result
+is bit-identical to the Triton kernel. ``covered()`` gates the inputs, the
+caller falls back to Triton for everything else.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Optional, Tuple
+
+import torch
+
+from sglang.kernels.jit.utils import (
+    cache_once,
+    is_arch_support_pdl,
+    load_jit,
+    make_cpp_args,
+)
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+_STAGES = 3
+
+
+@cache_once
+def _jit_kda_chunk_h_module() -> Module:
+    args = make_cpp_args(_STAGES, is_arch_support_pdl())
+    return load_jit(
+        "kda_chunk_h",
+        *args,
+        cuda_files=["attention/kda_chunk_h.cuh"],
+        cuda_wrappers=[("run", f"KdaChunkHKernel<{args}>::run")],
+        extra_cuda_cflags=["-O3"],
+    )
+
+
+@cache_once
+def _arch_ok(device_index: int) -> bool:
+    return torch.cuda.get_device_capability(device_index)[0] >= 8
+
+
+def covered(
+    k: torch.Tensor,
+    w: torch.Tensor,
+    u: torch.Tensor,
+    g: Optional[torch.Tensor],
+    gk: Optional[torch.Tensor],
+    initial_state: Optional[torch.Tensor],
+    initial_state_indices: Optional[torch.Tensor],
+    save_new_value: bool,
+    cu_seqlens: Optional[torch.Tensor],
+    use_exp2: bool,
+    inplace_update: bool,
+    track_state: Optional[torch.Tensor],
+) -> bool:
+    return (
+        k.is_cuda
+        and gk is not None
+        and g is None
+        and use_exp2
+        and save_new_value
+        and track_state is None
+        and (initial_state is None or (inplace_update and initial_state_indices is not None))
+        and k.shape[-1] == 128
+        and u.shape[-1] % 16 == 0
+        and k.dtype == torch.bfloat16
+        and w.dtype == torch.bfloat16
+        and u.dtype == torch.bfloat16
+        and gk.dtype == torch.float32
+        and k.is_contiguous()
+        and w.is_contiguous()
+        and u.is_contiguous()
+        and gk.is_contiguous()
+        and (cu_seqlens is None or cu_seqlens.dtype == torch.int32)
+        and (
+            initial_state_indices is None or initial_state_indices.dtype == torch.int32
+        )
+        and _arch_ok(k.device.index)
+    )
+
+
+def kda_chunk_h(
+    k: torch.Tensor,
+    w: torch.Tensor,
+    u: torch.Tensor,
+    gk: torch.Tensor,
+    initial_state: Optional[torch.Tensor],
+    initial_state_indices: Optional[torch.Tensor],
+    cu_seqlens: Optional[torch.Tensor],
+    num_chunks: int,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """Returns (h [B, NT, H, V, K], v_new like u); updates the state slots
+    selected by initial_state_indices in place. Caller must have checked
+    covered()."""
+    B, _, H, V = u.shape
+    h = k.new_empty(B, num_chunks, H, V, k.shape[-1])
+    v_new = torch.empty_like(u)
+    has_state = initial_state is not None
+    _jit_kda_chunk_h_module().run(
+        k,
+        u,
+        w,
+        gk,
+        v_new,
+        h,
+        initial_state if has_state else h,
+        initial_state_indices if has_state else h,
+        cu_seqlens if cu_seqlens is not None else h,
+        has_state,
+        cu_seqlens is not None,
+    )
+    return h, v_new

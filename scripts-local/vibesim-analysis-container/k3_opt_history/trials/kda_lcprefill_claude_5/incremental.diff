+"""Fused CUDA chunk preparation for KDA chunked prefill.
+
+One kernel for the safe-gate Triton chain intra_sub_chunk -> inter_solve_fused
+-> recompute_w_u of chunk_kda: returns (w, u, kg, Aqk) with the same operand
+precisions (see csrc/attention/kda_chunk_prep.cuh). ``covered()`` gates the
+inputs, the caller falls back to Triton for everything else.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Tuple
+
+import torch
+
+from sglang.kernels.jit.utils import cache_once, load_jit
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+
+@cache_once
+def _jit_kda_chunk_prep_module() -> Module:
+    return load_jit(
+        "kda_chunk_prep",
+        cuda_files=["attention/kda_chunk_prep.cuh"],
+        cuda_wrappers=[("run", "KdaChunkPrepKernel::run")],
+        extra_cuda_cflags=["-O3"],
+    )
+
+
+@cache_once
+def _arch_ok(device_index: int) -> bool:
+    return torch.cuda.get_device_capability(device_index)[0] >= 8
+
+
+def covered(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    cu_seqlens: torch.Tensor | None,
+    chunk_indices: torch.Tensor | None,
+    chunk_size: int,
+) -> bool:
+    return (
+        q.is_cuda
+        and chunk_size == 64
+        and cu_seqlens is not None
+        and chunk_indices is not None
+        and cu_seqlens.dtype == torch.int32
+        and chunk_indices.dtype == torch.int32
+        and q.dim() == 4
+        and q.shape[0] == 1
+        and q.shape[-1] == 128
+        and v.shape == q.shape
+        and k.shape == q.shape
+        and q.dtype == torch.bfloat16
+        and k.dtype == torch.bfloat16
+        and v.dtype == torch.bfloat16
+        and g.dtype == torch.float32
+        and beta.dtype == torch.float32
+        and q.is_contiguous()
+        and k.is_contiguous()
+        and g.is_contiguous()
+        and beta.is_contiguous()
+        and v.stride(-1) == 1
+        and v.stride(-2) == v.shape[-1]
+        and _arch_ok(q.device.index)
+    )
+
+
+def kda_chunk_prep(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    scale: float,
+    cu_seqlens: torch.Tensor,
+    chunk_indices: torch.Tensor,
+) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Returns (w, u, kg, Aqk); Aqk blocks above the diagonal are left
+    unwritten, as in the Triton path. Caller must have checked covered()."""
+    B, T, H, K = k.shape
+    w = torch.empty_like(k)
+    u = torch.empty(v.shape, dtype=v.dtype, device=v.device)
+    kg = torch.empty_like(k)
+    Aqk = k.new_empty(B, T, H, 64)
+    _jit_kda_chunk_prep_module().run(
+        q, k, v, g, beta, Aqk, w, u, kg, cu_seqlens, chunk_indices, scale
+    )
+    return w, u, kg, Aqk

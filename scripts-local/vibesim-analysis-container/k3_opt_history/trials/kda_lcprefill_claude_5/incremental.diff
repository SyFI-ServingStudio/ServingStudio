+++ /raid/yilegu/roofline_guided_agent/VibeSimWorkspace/scripts-local/vibesim-analysis-container/iter_opt_eval_k3_kda_lcprefill_claude/trial_5_tree_judged/kernels/ops/attention/kda_chunk_prep.py	2026-09-27 17:02:39.092938946 -0700

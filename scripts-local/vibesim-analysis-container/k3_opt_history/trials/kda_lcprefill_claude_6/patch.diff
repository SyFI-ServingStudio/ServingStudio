+}  // namespace kda_chunk_h
+
+
+/// \brief Host launcher for the KDA chunked h-scan (see file header).
+template <int kStages, bool kUsePDL>
+struct KdaChunkHKernel {
+  template <typename InT, typename OutT>
+  static void launch(
+      const tvm::ffi::TensorView k,
+      const tvm::ffi::TensorView u,
+      const tvm::ffi::TensorView w,
+      const tvm::ffi::TensorView gk,
+      const tvm::ffi::TensorView v_new,
+      const tvm::ffi::TensorView h,
+      const tvm::ffi::TensorView state,
+      const tvm::ffi::TensorView state_indices,
+      const tvm::ffi::TensorView final_state,
+      const tvm::ffi::TensorView final_indices,
+      const tvm::ffi::TensorView cu_seqlens,
+      bool has_state,
+      bool has_final,
+      bool is_varlen) {
+    using namespace host;
+    using namespace kda_chunk_h;
+
+    auto B_ = SymbolicSize{"batch"};
+    auto T_ = SymbolicSize{"seqlen"};
+    auto H_ = SymbolicSize{"num_heads"};
+    auto Hg_ = SymbolicSize{"num_k_heads"};
+    auto V_ = SymbolicSize{"head_v_dim"};
+    auto NT_ = SymbolicSize{"num_chunks"};
+    auto N_ = SymbolicSize{"num_seqs"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+
+    TensorMatcher({B_, T_, Hg_, kK}).with_dtype<bf16_t>().with_device(device).verify(k);
+    TensorMatcher({B_, T_, H_, kK}).with_dtype<bf16_t>().with_device(device).verify(w);
+    TensorMatcher({B_, T_, H_, kK}).with_dtype<fp32_t>().with_device(device).verify(gk);
+    TensorMatcher({B_, T_, H_, V_}).with_dtype<bf16_t>().with_device(device).verify(u).verify(v_new);
+    TensorMatcher({B_, NT_, H_, V_, kK}).with_dtype<bf16_t>().with_device(device).verify(h);
+
+    const int64_t B = B_.unwrap();
+    const int64_t T = T_.unwrap();
+    const int64_t H = H_.unwrap();
+    const int64_t Hg = Hg_.unwrap();
+    const int64_t V = V_.unwrap();
+    CHECK_HOST(V % kBV == 0) << "kda_chunk_h: V must be a multiple of " << kBV << ", got " << V;
+    CHECK_HOST(H % Hg == 0) << "kda_chunk_h: H (" << H << ") must be a multiple of Hg (" << Hg << ")";
+
+    int64_t N = B;
+    const int32_t* cu_ptr = nullptr;
+    if (is_varlen) {
+      CHECK_HOST(B == 1) << "kda_chunk_h: varlen input must have batch 1, got " << B;
+      TensorMatcher({N_}).with_dtype<int32_t>().with_device(device).verify(cu_seqlens);
+      N = N_.unwrap() - 1;
+      cu_ptr = static_cast<const int32_t*>(cu_seqlens.data_ptr());
+    }
+    auto verify_pool = [&](const tvm::ffi::TensorView pool, const tvm::ffi::TensorView indices, auto dtype_tag) {
+      using PoolT = decltype(dtype_tag);
+      auto Slots_ = SymbolicSize{"pool_slots"};
+      TensorMatcher({Slots_, H_, V_, kK})
+          .with_dtype<PoolT>()
+          .with_device(device)
+          .with_strides({-1, V * kK, kK, 1})
+          .verify(pool);
+      TensorMatcher({N}).with_dtype<int32_t>().with_device(device).verify(indices);
+      CHECK_HOST(pool.stride(0) % 2 == 0) << "kda_chunk_h: state slot pitch must be even, got " << pool.stride(0);
+      return pool.stride(0);
+    };
+    const InT* state_ptr = nullptr;
+    const int32_t* idx_ptr = nullptr;
+    int64_t state_stride = 0;
+    if (has_state) {
+      state_stride = verify_pool(state, state_indices, InT{});
+      state_ptr = static_cast<const InT*>(state.data_ptr());
+      idx_ptr = static_cast<const int32_t*>(state_indices.data_ptr());
+    }
+    OutT* final_ptr = nullptr;
+    const int32_t* final_idx_ptr = nullptr;
+    int64_t final_stride = 0;
+    if (has_final) {
+      final_stride = verify_pool(final_state, final_indices, OutT{});
+      final_ptr = static_cast<OutT*>(final_state.data_ptr());
+      final_idx_ptr = static_cast<const int32_t*>(final_indices.data_ptr());
+    }
+    if (N == 0) return;
+
+    auto kernel = kda_chunk_h_kernel<InT, OutT, kStages, kUsePDL>;
+    constexpr size_t smem_bytes = sizeof(Smem<kStages>);
+    static bool attr_set = false;
+    if (!attr_set) {
+      RuntimeDeviceCheck(
+          cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, static_cast<int>(smem_bytes)));
+      attr_set = true;
+    }
+    LaunchKernel(dim3(static_cast<uint32_t>(V / kBV), static_cast<uint32_t>(N * H)), dim3(kThreads), device.unwrap(),
+                 smem_bytes)
+        .enable_pdl(kUsePDL)(
+            kernel,
+            static_cast<const bf16_t*>(k.data_ptr()),
+            static_cast<const bf16_t*>(u.data_ptr()),
+            static_cast<const bf16_t*>(w.data_ptr()),
+            static_cast<const float*>(gk.data_ptr()),
+            static_cast<bf16_t*>(v_new.data_ptr()),
+            static_cast<bf16_t*>(h.data_ptr()),
+            state_ptr,
+            idx_ptr,
+            final_ptr,
+            final_idx_ptr,
+            cu_ptr,
+            state_stride,
+            final_stride,
+            static_cast<int32_t>(T),
+            static_cast<int32_t>(H),
+            static_cast<int32_t>(Hg),
+            static_cast<int32_t>(V));
+  }
+
+  template <typename InT>
+  static void dispatch_final(
+      const tvm::ffi::TensorView k,
+      const tvm::ffi::TensorView u,
+      const tvm::ffi::TensorView w,
+      const tvm::ffi::TensorView gk,
+      const tvm::ffi::TensorView v_new,
+      const tvm::ffi::TensorView h,
+      const tvm::ffi::TensorView state,
+      const tvm::ffi::TensorView state_indices,
+      const tvm::ffi::TensorView final_state,
+      const tvm::ffi::TensorView final_indices,
+      const tvm::ffi::TensorView cu_seqlens,
+      bool has_state,
+      bool has_final,
+      bool is_varlen) {
+    using namespace host;
+    if (!has_final || is_type<bf16_t>(final_state.dtype())) {
+      launch<InT, bf16_t>(
+          k, u, w, gk, v_new, h, state, state_indices, final_state, final_indices, cu_seqlens, has_state, has_final,
+          is_varlen);
+    } else if (is_type<fp32_t>(final_state.dtype())) {
+      launch<InT, fp32_t>(
+          k, u, w, gk, v_new, h, state, state_indices, final_state, final_indices, cu_seqlens, has_state, has_final,
+          is_varlen);
+    } else {
+      Panic("kda_chunk_h: final state dtype must be bf16 or fp32");
+    }
+  }
+
+  static void run(
+      const tvm::ffi::TensorView k,
+      const tvm::ffi::TensorView u,
+      const tvm::ffi::TensorView w,
+      const tvm::ffi::TensorView gk,
+      const tvm::ffi::TensorView v_new,
+      const tvm::ffi::TensorView h,
+      const tvm::ffi::TensorView state,
+      const tvm::ffi::TensorView state_indices,
+      const tvm::ffi::TensorView final_state,
+      const tvm::ffi::TensorView final_indices,
+      const tvm::ffi::TensorView cu_seqlens,
+      bool has_state,
+      bool has_final,
+      bool is_varlen) {
+    using namespace host;
+    if (!has_state || is_type<bf16_t>(state.dtype())) {
+      dispatch_final<bf16_t>(
+          k, u, w, gk, v_new, h, state, state_indices, final_state, final_indices, cu_seqlens, has_state, has_final,
+          is_varlen);
+    } else if (is_type<fp32_t>(state.dtype())) {
+      dispatch_final<fp32_t>(
+          k, u, w, gk, v_new, h, state, state_indices, final_state, final_indices, cu_seqlens, has_state, has_final,
+          is_varlen);
+    } else {
+      Panic("kda_chunk_h: state dtype must be bf16 or fp32");
+    }
+  }
+};
+

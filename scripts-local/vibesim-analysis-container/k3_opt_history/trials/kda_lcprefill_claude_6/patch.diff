+// Fused KDA prefill front: depthwise causal conv1d (width 4) + SiLU over the
+// packed [T, q | k | v] pre-conv activations, then a per-head l2norm of q and k.
+// Replaces causal_conv1d_fn followed by two l2norm_fwd_strided_heads calls.
+//
+// Each thread owns 8 consecutive channels and walks a strip of tokens with the
+// three previous inputs in registers, so every input row is read once and
+// every output row written once (16B per thread). A 128-channel head spans 16
+// lanes; its l2norm is a 16-lane butterfly.
+//
+// Arithmetic matches the Triton kernels instruction for instruction: fp32 taps
+// accumulated from 0, where (as Triton's BLOCK_N = 256 / 2-warp build lowers
+// it) odd channels of each 4-channel group round taps 2 and 3 as mul + add and
+// every other tap is an fma; SiLU as
+// x / (1 + ex2.approx(-x * log2e)) with div.full, bf16 round; the l2norm sums
+// x1^2 then fma x0, x2..x7 per thread, butterflies xor 8/4/2/1, adds eps, and
+// divides by sqrt.approx.ftz with div.full.
+//
+// The conv state [slot, 3, dim] is read (as the left halo of the sequence) and
+// then overwritten with the last 3 inputs by the thread that owns the strip at
+// token 0, so no other thread touches it.
+
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.h>
+
+#include <sgl_kernel/type.cuh>
+#include <sgl_kernel/utils.cuh>
+
+#include <dlpack/dlpack.h>
+#include <tvm/ffi/container/tensor.h>
+
+#include <cstdint>
+#include <cuda_bf16.h>
+
+namespace sglang {
+
+namespace kda_conv_l2norm {
+
+constexpr int kWidth = 4;
+constexpr int kVec = 8;                     // channels per thread
+constexpr int kWarpChannels = 32 * kVec;    // 256
+constexpr int kHeadDim = 128;               // 16 lanes
+constexpr int kWarps = 4;
+constexpr int kThreads = 32 * kWarps;
+constexpr int kStrip = 32;                  // tokens per warp
+constexpr int kUnroll = 8;                  // token rows loaded ahead
+
+SGL_DEVICE uint4 zero_vec() {
+  return make_uint4(0u, 0u, 0u, 0u);
+}
+
+SGL_DEVICE uint4 load_vec(const __nv_bfloat16* p) {
+  return *reinterpret_cast<const uint4*>(p);
+}
+
+SGL_DEVICE void store_vec(__nv_bfloat16* p, const uint4& r) {
+  *reinterpret_cast<uint4*>(p) = r;
+}
+
+SGL_DEVICE float ex2_approx_ftz(float x) {
+  float y;
+  asm("ex2.approx.ftz.f32 %0, %1;" : "=f"(y) : "f"(x));
+  return y;
+}
+
+SGL_DEVICE float rcp_approx_ftz(float x) {
+  float y;
+  asm("rcp.approx.ftz.f32 %0, %1;" : "=f"(y) : "f"(x));
+  return y;
+}
+
+SGL_DEVICE float sqrt_approx_ftz(float x) {
+  float y;
+  asm("sqrt.approx.ftz.f32 %0, %1;" : "=f"(y) : "f"(x));
+  return y;
+}
+
+// div.full.f32 a / b for b >= 1, as ptxas expands it: rescale both operands
+// by 1/4 when |b| > 2^126 (the small-|b| branch cannot fire), then a * rcp(b).
+SGL_DEVICE float div_full_ge1(float a, float b) {
+  if (b > 0x1p126f) {
+    a = __fmul_rn(a, 0.25f);
+    b = __fmul_rn(b, 0.25f);
+  }
+  return __fmul_rn(a, rcp_approx_ftz(b));
+}
+
+SGL_DEVICE float bf16_lo(uint32_t v) {
+  return __uint_as_float(v << 16);
+}
+
+SGL_DEVICE float bf16_hi(uint32_t v) {
+  return __uint_as_float(v & 0xffff0000u);
+}
+
+SGL_DEVICE uint32_t pack_bf16x2(float lo, float hi) {
+  const __nv_bfloat162 r = __floats2bfloat162_rn(lo, hi);
+  return *reinterpret_cast<const uint32_t*>(&r);
+}
+
+/**
+ * \brief One output row: conv taps over (x[t-3], x[t-2], x[t-1], x[t]), SiLU,
+ *        bf16 round, and (for q/k) the head l2norm.
+ */
+SGL_DEVICE uint4 conv_row(
+    const uint4& x0, const uint4& x1, const uint4& x2, const uint4& x3,
+    const float (&w)[kVec][kWidth], bool normalize, float eps) {
+  const uint32_t* xp[kWidth] = {&x0.x, &x1.x, &x2.x, &x3.x};
+  float y[kVec];
+#pragma unroll
+  for (int p = 0; p < kVec / 2; ++p) {
+    float lo = 0.0f;
+    float hi = 0.0f;
+#pragma unroll
+    for (int j = 0; j < kWidth; ++j) {
+      lo = __fmaf_rn(w[2 * p][j], bf16_lo(xp[j][p]), lo);
+      hi = j < 2 ? __fmaf_rn(w[2 * p + 1][j], bf16_hi(xp[j][p]), hi)
+                 : __fadd_rn(hi, __fmul_rn(w[2 * p + 1][j], bf16_hi(xp[j][p])));
+    }
+    // x / (1 + exp(-x)); exp lowers to ex2(-x * log2e). ftz is exact here:
+    // a denormal ex2 result leaves 1 + e == 1.
+    y[2 * p] = div_full_ge1(lo, __fadd_rn(ex2_approx_ftz(__fmul_rn(lo, -1.44269502162933349609375f)), 1.0f));
+    y[2 * p + 1] = div_full_ge1(hi, __fadd_rn(ex2_approx_ftz(__fmul_rn(hi, -1.44269502162933349609375f)), 1.0f));
+  }
+  uint4 out;
+  uint32_t* op = &out.x;
+#pragma unroll
+  for (int p = 0; p < kVec / 2; ++p) op[p] = pack_bf16x2(y[2 * p], y[2 * p + 1]);
+  if (normalize) {
+    float f[kVec];
+#pragma unroll
+    for (int p = 0; p < kVec / 2; ++p) {
+      f[2 * p] = bf16_lo(op[p]);
+      f[2 * p + 1] = bf16_hi(op[p]);
+    }
+    float s = __fmul_rn(f[1], f[1]);
+    s = __fmaf_rn(f[0], f[0], s);
+#pragma unroll
+    for (int i = 2; i < kVec; ++i) s = __fmaf_rn(f[i], f[i], s);
+#pragma unroll
+    for (int m = 8; m >= 1; m >>= 1) s = __fadd_rn(s, __shfl_xor_sync(0xffffffffu, s, m));
+    // div.full by r in [sqrt(eps), 2^126] is f * rcp(r)
+    const float rr = rcp_approx_ftz(sqrt_approx_ftz(__fadd_rn(eps, s)));
+#pragma unroll
+    for (int p = 0; p < kVec / 2; ++p) op[p] = pack_bf16x2(__fmul_rn(f[2 * p], rr), __fmul_rn(f[2 * p + 1], rr));

+
+/// \brief Host launcher for the fused KDA intra-chunk stage (see file header).
+template <bool kUsePDL>
+struct KdaChunkIntraKernel {
+  static void run(
+      const tvm::ffi::TensorView q,
+      const tvm::ffi::TensorView k,
+      const tvm::ffi::TensorView v,
+      const tvm::ffi::TensorView graw,
+      const tvm::ffi::TensorView beta,
+      const tvm::ffi::TensorView A_log,
+      const tvm::ffi::TensorView dt_bias,
+      const tvm::ffi::TensorView g_out,
+      const tvm::ffi::TensorView aqk,
+      const tvm::ffi::TensorView w_out,
+      const tvm::ffi::TensorView u_out,
+      const tvm::ffi::TensorView kg_out,
+      const tvm::ffi::TensorView cu_seqlens,
+      const tvm::ffi::TensorView chunk_indices,
+      int64_t num_chunks,
+      bool is_varlen,
+      double lower_bound,
+      double scale) {
+    using namespace host;
+    using namespace kda_chunk_intra;
+
+    auto B_ = SymbolicSize{"batch"};
+    auto T_ = SymbolicSize{"seqlen"};
+    auto H_ = SymbolicSize{"num_heads"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+
+    TensorMatcher({B_, T_, H_, kK}).with_dtype<bf16_t>().with_device(device).with_strides({-1, -1, kK, 1}).verify(q);
+    TensorMatcher({B_, T_, H_, kK}).with_dtype<bf16_t>().with_device(device).with_strides({-1, -1, kK, 1}).verify(k);
+    TensorMatcher({B_, T_, H_, kK}).with_dtype<bf16_t>().with_device(device).with_strides({-1, -1, kK, 1}).verify(v);
+    TensorMatcher({B_, T_, H_, kK}).with_dtype<bf16_t>().with_device(device).with_strides({-1, -1, kK, 1}).verify(graw);
+    TensorMatcher({B_, T_, H_}).with_dtype<fp32_t>().with_device(device).verify(beta);
+    TensorMatcher({B_, T_, H_, kK}).with_dtype<fp32_t>().with_device(device).verify(g_out);
+    TensorMatcher({B_, T_, H_, kBT}).with_dtype<bf16_t>().with_device(device).verify(aqk);
+    TensorMatcher({B_, T_, H_, kK}).with_dtype<bf16_t>().with_device(device).verify(w_out).verify(u_out).verify(kg_out);
+
+    const int64_t B = B_.unwrap();
+    const int64_t T = T_.unwrap();
+    const int64_t H = H_.unwrap();
+    CHECK_HOST(A_log.numel() == H) << "kda_chunk_intra: A_log must have H elements";
+    CHECK_HOST(dt_bias.numel() == H * kK) << "kda_chunk_intra: dt_bias must have H * K elements";
+    CHECK_HOST(is_type<fp32_t>(A_log.dtype()) && is_type<fp32_t>(dt_bias.dtype()))
+        << "kda_chunk_intra: A_log / dt_bias must be fp32";
+    for (int i = 0; i < 4; ++i) {

+"""Fused CUDA intra-chunk stage of KDA chunked prefill.
+
+One kernel replaces the Triton chain kda_gate_chunk_cumsum -> intra_sub_chunk ->
+inter_solve_fused -> recompute_w_u of chunk_kda on the safe lower-bounded gate
+path (K = V = 128, chunk 64): see csrc/attention/kda_chunk_intra.cuh.
+``covered()`` gates the inputs, the caller falls back to Triton otherwise.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Optional, Tuple
+
+import torch
+
+from sglang.kernels.jit.utils import (
+    cache_once,
+    is_arch_support_pdl,
+    load_jit,
+    make_cpp_args,
+)
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+
+@cache_once
+def _jit_kda_chunk_intra_module() -> Module:
+    args = make_cpp_args(is_arch_support_pdl())
+    return load_jit(
+        "kda_chunk_intra",
+        *args,
+        cuda_files=["attention/kda_chunk_intra.cuh"],
+        cuda_wrappers=[("run", f"KdaChunkIntraKernel<{args}>::run")],
+        extra_cuda_cflags=["-O3"],
+    )
+
+
+@cache_once
+def _arch_ok(device_index: int) -> bool:
+    return torch.cuda.get_device_capability(device_index)[0] >= 8
+
+
+def _heads_view_ok(x: torch.Tensor) -> bool:
+    # [B, T, H, 128] bf16 with packed heads; any 16 B aligned token stride.
+    return (
+        x.dim() == 4
+        and x.dtype == torch.bfloat16
+        and x.shape[-1] == 128
+        and x.stride(-1) == 1
+        and x.stride(-2) == 128
+        and x.stride(1) % 8 == 0
+        and x.data_ptr() % 16 == 0
+        and (x.shape[0] == 1 or x.stride(0) == x.shape[1] * x.stride(1))
+    )
+
+
+def covered(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    A_log: Optional[torch.Tensor],
+    dt_bias: Optional[torch.Tensor],
+    lower_bound: Optional[float],
+    cu_seqlens: Optional[torch.Tensor],
+    chunk_indices: Optional[torch.Tensor],
+) -> bool:
+    H = q.shape[-2] if q.dim() == 4 else 0
+    return (
+        q.is_cuda
+        and A_log is not None
+        and dt_bias is not None
+        and lower_bound is not None
+        and all(_heads_view_ok(x) for x in (q, k, v, g))
+        and q.shape == k.shape == v.shape == g.shape
+        and beta.dtype == torch.float32
+        and beta.shape == q.shape[:3]
+        and beta.is_contiguous()
+        and A_log.dtype == torch.float32
+        and A_log.numel() == H
+        and A_log.is_contiguous()
+        and dt_bias.dtype == torch.float32
+        and dt_bias.numel() == H * 128
+        and dt_bias.is_contiguous()
+        and (
+            cu_seqlens is None
+            or (
+                cu_seqlens.dtype == torch.int32
+                and chunk_indices is not None
+                and chunk_indices.dtype == torch.int32
+                and chunk_indices.is_contiguous()
+            )
+        )
+        and _arch_ok(q.device.index)
+    )
+
+
+def kda_chunk_intra(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    A_log: torch.Tensor,
+    dt_bias: torch.Tensor,
+    lower_bound: float,
+    scale: float,
+    cu_seqlens: Optional[torch.Tensor],
+    chunk_indices: Optional[torch.Tensor],
+) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Returns (g_cum fp32, w, u, kg, Aqk [B, T, H, 64]); g is the raw gate.
+    Caller must have checked covered()."""
+    B, T, H, K = q.shape
+    g_cum = torch.empty(B, T, H, K, dtype=torch.float32, device=q.device)
+    w = torch.empty(B, T, H, K, dtype=q.dtype, device=q.device)
+    u = torch.empty_like(w)
+    kg = torch.empty_like(w)
+    Aqk = torch.empty(B, T, H, 64, dtype=q.dtype, device=q.device)
+    is_varlen = cu_seqlens is not None
+    _jit_kda_chunk_intra_module().run(
+        q,
+        k,
+        v,
+        g,
+        beta,
+        A_log,
+        dt_bias,
+        g_cum,
+        Aqk,
+        w,
+        u,
+        kg,
+        cu_seqlens if is_varlen else g_cum,
+        chunk_indices if is_varlen else g_cum,
+        chunk_indices.shape[0] if is_varlen else 0,
+        is_varlen,
+        float(lower_bound),
+        float(scale),
+    )
+    return g_cum, w, u, kg, Aqk

+template <bool kUsePDL>
+__global__ void __launch_bounds__(kThreads, 2) kda_chunk_intra_kernel(
+    const bf16_t* __restrict__ q,       // [.., T, H, K], token stride sq
+    const bf16_t* __restrict__ k,       // [.., T, H, K], token stride sk
+    const bf16_t* __restrict__ v,       // [.., T, H, V], token stride sv
+    const bf16_t* __restrict__ graw,    // [.., T, H, K], token stride sg
+    const float* __restrict__ beta,     // [.., T, H]
+    const float* __restrict__ A_log,    // [H]
+    const float* __restrict__ dt_bias,  // [H * K]
+    float* __restrict__ g_out,          // [.., T, H, K]
+    bf16_t* __restrict__ aqk,           // [.., T, H, 64]
+    bf16_t* __restrict__ w_out,         // [.., T, H, K]
+    bf16_t* __restrict__ u_out,         // [.., T, H, V]
+    bf16_t* __restrict__ kg_out,        // [.., T, H, K]
+    const int32_t* __restrict__ cu_seqlens,     // [N + 1] or null
+    const int32_t* __restrict__ chunk_indices,  // [NT, 2] or null
+    int64_t sq,
+    int64_t sk,
+    int64_t sv,
+    int64_t sg,
+    int32_t T_fixed,
+    int32_t H,
+    float lower_bound,
+    float scale) {
+  extern __shared__ __align__(128) uint8_t smem_raw[];
+  auto& sm = *reinterpret_cast<Smem*>(smem_raw);
+
+  const int tid = threadIdx.x;
+  const int warp = tid >> 5;
+  const int lane = tid & 31;
+  const int i_h = blockIdx.y % H;
+  int64_t bos;
+  int32_t T;
+  int32_t i_t = blockIdx.x;
+  if (cu_seqlens != nullptr) {
+    const int32_t i_n = chunk_indices[2 * i_t];
+    i_t = chunk_indices[2 * i_t + 1];
+    bos = cu_seqlens[i_n];
+    T = cu_seqlens[i_n + 1] - static_cast<int32_t>(bos);
+  } else {
+    const int32_t i_b = blockIdx.y / H;
+    T = T_fixed;
+    bos = static_cast<int64_t>(i_b) * T;
+    if (i_t * kBT >= T) return;
+  }
+  const int64_t tok0 = bos + static_cast<int64_t>(i_t) * kBT;  // first token of the chunk
+  const int nrows = min(kBT, T - i_t * kBT);
+  const int nblk = (nrows + kBC - 1) / kBC;
+  const int64_t sHK = static_cast<int64_t>(H) * kK;
+
+  device::PDLWaitPrimary<kUsePDL>();
+
+  // ------------------------------------------------------------------ loads
+  bf16_t* graw_s = reinterpret_cast<bf16_t*>(sm.a);
+  for (int c = tid; c < kBT * kK / 8; c += kThreads) {
+    const int row = c >> 4, ch = c & 15;
+    const bool ok = row < nrows;
+    const int64_t tok = tok0 + (ok ? row : 0);
+    cp_async16(smem_addr(&graw_s[row * kPB + ch * 8]), graw + tok * sg + i_h * kK + ch * 8, ok);
+  }
+  cp_async_commit();
+  for (int c = tid; c < kBT * kK / 8; c += kThreads) {
+    const int row = c >> 4, ch = c & 15;
+    const bool ok = row < nrows;
+    const int64_t tok = tok0 + (ok ? row : 0);
+    cp_async16(smem_addr(&sm.q[row * kPB + ch * 8]), q + tok * sq + i_h * kK + ch * 8, ok);
+    cp_async16(smem_addr(&sm.k[row * kPB + ch * 8]), k + tok * sk + i_h * kK + ch * 8, ok);
+    cp_async16(smem_addr(&sm.v[row * kPB + ch * 8]), v + tok * sv + i_h * kK + ch * 8, ok);
+  }
+  cp_async_commit();
+  if (tid < kBT) sm.beta[tid] = tid < nrows ? beta[(tok0 + tid) * H + i_h] : 0.f;
+
+  // ------------------------------------------------- gate + chunk-local cumsum
+  cp_async_wait<1>();
+  __syncthreads();
+  {
+    // thread: columns 2 * cp, 2 * cp + 1 of rows [16 * qt, 16 * qt + 16)
+    const int cp = tid & 63, qt = tid >> 6, d = 2 * cp;
+    // sigmoid(x) = 1 / (1 + exp2(-x * log2(e))), x = exp(A_log) * (g_raw + dt_bias)
+    const float c1 = -__expf(A_log[i_h]) * kRcpLn2;
+    const float2 bias = ld_f2(&dt_bias[i_h * kK + d]);
+    float2 acc = make_float2(0.f, 0.f);
+#pragma unroll
+    for (int r = 16 * qt; r < 16 * qt + 16; ++r) {
+      const float2 x = ld_bf16x2(&graw_s[r * kPB + d]);
+      acc.x += lower_bound * __fdividef(1.f, 1.f + ex2_approx(c1 * (x.x + bias.x)));
+      acc.y += lower_bound * __fdividef(1.f, 1.f + ex2_approx(c1 * (x.y + bias.y)));
+      *reinterpret_cast<float2*>(&sm.g[r * kPG + d]) = acc;
+    }
+    *reinterpret_cast<float2*>(&sm.tot[qt * kK + d]) = acc;
+    __syncthreads();
+    float2 carry = make_float2(0.f, 0.f);
+    for (int p = 0; p < qt; ++p) {
+      const float2 c = ld_f2(&sm.tot[p * kK + d]);
+      carry.x += c.x;
+      carry.y += c.y;
+    }
+    float* go = g_out + tok0 * sHK + i_h * kK + d;
+#pragma unroll
+    for (int r = 16 * qt; r < 16 * qt + 16; ++r) {
+      const float2 s = ld_f2(&sm.g[r * kPG + d]);
+      const float2 x = make_float2((s.x + carry.x) * kRcpLn2, (s.y + carry.y) * kRcpLn2);
+      *reinterpret_cast<float2*>(&sm.g[r * kPG + d]) = x;
+      if (r < nrows) *reinterpret_cast<float2*>(go + r * sHK) = x;
+    }
+  }
+  cp_async_wait<0>();
+  __syncthreads();
+
+  // ------------------------------------------------------- Aqk and Akk blocks
+  bf16_t* aqk_row0 = aqk + (tok0 * H + i_h) * kBT;
+  const int64_t aqk_stride = static_cast<int64_t>(H) * kBT;
+  if (warp < 4) {
+    if (warp < nblk) diag_block(sm, warp, nrows, lane, scale, aqk_row0, aqk_stride);
+  } else if (warp == 4) {
+    if (1 < nblk) offdiag_blocks<1>(sm, 1, 0, nrows, lane, scale, aqk_row0, aqk_stride);
+  } else if (warp == 5) {
+    if (2 < nblk) offdiag_blocks<2>(sm, 2, 0, nrows, lane, scale, aqk_row0, aqk_stride);
+  } else if (warp == 6) {
+    if (3 < nblk) offdiag_blocks<2>(sm, 3, 0, nrows, lane, scale, aqk_row0, aqk_stride);
+  } else {
+    if (3 < nblk) offdiag_blocks<1>(sm, 3, 2, nrows, lane, scale, aqk_row0, aqk_stride);
+  }
+  __syncthreads();
+
+  float* X = reinterpret_cast<float*>(sm.q);
+  if (warp < 2) {
+    // ------------- invert the diagonal blocks (fp32; half-warp per block, lane = column)
+    const int I = 2 * warp + (lane >> 4);
+    if (I < nblk) {
+      const int c = lane & 15;
+      const int i0 = I * kBC;
+      float x[kBC];
+#pragma unroll
+      for (int i = 0; i < kBC; ++i) {
+        float l[kBC];
+#pragma unroll
+        for (int j = 0; j < i; j += 4) {
+          const float4 v4 = *reinterpret_cast<const float4*>(&sm.a[(i0 + i) * kPA + i0 + j]);
+          l[j] = v4.x, l[j + 1] = v4.y, l[j + 2] = v4.z, l[j + 3] = v4.w;
+        }
+        float acc = i == c ? 1.f : 0.f;
+#pragma unroll
+        for (int j = 0; j < i; ++j) acc -= l[j] * x[j];
+        x[i] = acc;
+      }
+#pragma unroll
+      for (int i = 0; i < kBC; ++i) X[(i0 + i) * kPA + i0 + c] = x[i];
+    }
+  } else {
+    // ----------------- kg out; k -> bf16(k * beta * exp2(g)); v -> bf16(v * beta)
+    const int last = nrows - 1;
+    for (int idx = tid - 64; idx < kBT * kK / 8; idx += kThreads - 64) {
+      const int row = idx >> 4;
+      const int c = (idx & 15) * 8;
+      const uint4 k8 = *reinterpret_cast<const uint4*>(&sm.k[row * kPB + c]);
+      const uint4 v8 = *reinterpret_cast<const uint4*>(&sm.v[row * kPB + c]);
+      const float4 g0 = *reinterpret_cast<const float4*>(&sm.g[row * kPG + c]);
+      const float4 g1 = *reinterpret_cast<const float4*>(&sm.g[row * kPG + c + 4]);
+      const float4 l0 = *reinterpret_cast<const float4*>(&sm.g[last * kPG + c]);
+      const float4 l1 = *reinterpret_cast<const float4*>(&sm.g[last * kPG + c + 4]);
+      const float bt = sm.beta[row];
+      const uint32_t ku[4] = {k8.x, k8.y, k8.z, k8.w};
+      const uint32_t vu[4] = {v8.x, v8.y, v8.z, v8.w};
+      const float gg[8] = {g0.x, g0.y, g0.z, g0.w, g1.x, g1.y, g1.z, g1.w};
+      const float gl[8] = {l0.x, l0.y, l0.z, l0.w, l1.x, l1.y, l1.z, l1.w};
+      uint32_t kg_o[4], kb_o[4], vb_o[4];
+#pragma unroll
+      for (int e = 0; e < 4; ++e) {
+        const float2 kx = bf16x2_to_f2(ku[e]);
+        const float2 vx = bf16x2_to_f2(vu[e]);
+        kg_o[e] = pack_bf16(kx.x * ex2_approx(gl[2 * e] - gg[2 * e]), kx.y * ex2_approx(gl[2 * e + 1] - gg[2 * e + 1]));
+        kb_o[e] = pack_bf16(kx.x * bt * ex2_approx(gg[2 * e]), kx.y * bt * ex2_approx(gg[2 * e + 1]));
+        vb_o[e] = pack_bf16(vx.x * bt, vx.y * bt);
+      }
+      if (row < nrows) {
+        *reinterpret_cast<uint4*>(kg_out + (tok0 + row) * sHK + i_h * kK + c) =
+            make_uint4(kg_o[0], kg_o[1], kg_o[2], kg_o[3]);
+      }
+      *reinterpret_cast<uint4*>(&sm.k[row * kPB + c]) = make_uint4(kb_o[0], kb_o[1], kb_o[2], kb_o[3]);
+      *reinterpret_cast<uint4*>(&sm.v[row * kPB + c]) = make_uint4(vb_o[0], vb_o[1], vb_o[2], vb_o[3]);
+    }
+  }
+  __syncthreads();
+
+  // ------------------------------------------ off-diagonal blocks of the inverse
+  if (warp < 4) {
+    merge_columns<0, 4>(sm, X, warp * 4, nblk, lane);
+  } else if (warp < 6) {
+    merge_columns<1, 8>(sm, X, (warp - 4) * 8, nblk, lane);
+  } else {
+    merge_columns<2, 8>(sm, X, (warp - 6) * 8, nblk, lane);
+  }
+  __syncthreads();
+
+  // ------------------------------------------------ u = X @ vb, w = X @ kb
+  {
+    const int g = lane >> 2, t = lane & 3;
+    bf16_t* src = warp < 4 ? sm.v : sm.k;
+    const int n0 = (warp & 3) * 32;
+    float acc[4][4][4] = {};  // [m-tile][n-tile][frag]
+#pragma unroll
+    for (int I = 0; I < 4; ++I) {
+      if (I < nblk) {
+        const int ra = I * kBC + g, rb = ra + 8;
+#pragma unroll
+        for (int ks = 0; ks <= I; ++ks) {
+          const int c0 = ks * kBC + 2 * t;
+          const float2 x0 = ld_f2(&X[ra * kPA + c0]);
+          const float2 x1 = ld_f2(&X[rb * kPA + c0]);
+          const float2 x2 = ld_f2(&X[ra * kPA + c0 + 8]);
+          const float2 x3 = ld_f2(&X[rb * kPA + c0 + 8]);
+          // the diagonal blocks of X are stored in full (zero upper triangle)
+          const uint32_t a[4] = {
+              pack_bf16(x0.x, x0.y), pack_bf16(x1.x, x1.y), pack_bf16(x2.x, x2.y), pack_bf16(x3.x, x3.y)};
+#pragma unroll
+          for (int np = 0; np < 2; ++np) {
+            uint32_t b[4];
+            const int krow = ks * kBC + (lane & 7) + ((lane >> 3) & 1) * 8;
+            const int ncol = n0 + np * 16 + (lane >> 4) * 8;
+            ldsm_x4_t(b, smem_addr(&src[krow * kPB + ncol]));
+            mma_bf16(acc[I][2 * np], a, b[0], b[1]);
+            mma_bf16(acc[I][2 * np + 1], a, b[2], b[3]);
+          }
+        }
+      }
+    }
+    __syncthreads();  // all reads of vb / kb done: reuse the tiles for the outputs
+#pragma unroll
+    for (int I = 0; I < 4; ++I) {
+#pragma unroll
+      for (int nt = 0; nt < 4; ++nt) {
+        const int col = n0 + nt * 8 + 2 * t;
+        const int row = I * kBC + g;
+        *reinterpret_cast<uint32_t*>(&src[row * kPB + col]) = pack_bf16(acc[I][nt][0], acc[I][nt][1]);
+        *reinterpret_cast<uint32_t*>(&src[(row + 8) * kPB + col]) = pack_bf16(acc[I][nt][2], acc[I][nt][3]);
+      }
+    }
+  }
+  __syncthreads();
+  for (int c = tid; c < kBT * kK / 8; c += kThreads) {
+    const int row = c >> 4, ch = c & 15;
+    if (row < nrows) {
+      const int64_t off = (tok0 + row) * sHK + i_h * kK + ch * 8;
+      *reinterpret_cast<uint4*>(u_out + off) = *reinterpret_cast<const uint4*>(&sm.v[row * kPB + ch * 8]);
+      *reinterpret_cast<uint4*>(w_out + off) = *reinterpret_cast<const uint4*>(&sm.k[row * kPB + ch * 8]);
+    }
+  }
+  device::PDLTriggerSecondary<kUsePDL>();
+}

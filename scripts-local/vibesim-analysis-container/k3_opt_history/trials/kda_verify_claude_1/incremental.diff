+        trtllm_fp4_block_scale_routed_moe(topk_ids=routing, do_finalize=True, **kw)
+    finally:
+        del tuner.choose_one
+    moe_op = _raw_trtllm_fp4_moe_ffi(
+        get_trtllm_moe_sm100_module().trtllm_fp4_block_scale_moe
+    )
+    if len(tactics) == 1 and moe_op is not None:
+        _mxfp4_routed_tactic_cache[key] = (
+            moe_op,
+            tactics[0],
+            _mxfp4_tuner_version(tuner),
+        )

+def _mxfp4_routed_moe_record(
+    routing: FlashInferRouting, key: tuple, fast: bool, kw: dict
+) -> None:
+    """Run the public flashinfer op, capturing the tactic its tuner selects."""
+    from flashinfer.autotuner import AutoTuner
+    from flashinfer.fused_moe import trtllm_fp4_block_scale_routed_moe
+    from flashinfer.fused_moe.core import get_trtllm_moe_sm100_module
+
+    tuner = AutoTuner.get()
+    if not fast:
+        trtllm_fp4_block_scale_routed_moe(topk_ids=routing, do_finalize=True, **kw)
+        return
+    choose_one = tuner.choose_one
+    tactics = []

+class _StridedKVLayouts:
+    """Stand-in for flashinfer fmha's ``cute`` module while tracing: its
+    ``__call__`` rebuilds K/V layouts as compact (token stride ``d * h_k``);
+    the 2nd and 3rd ``make_tensor`` there (K, then V) get the real strides."""
+
+    def __init__(self, cute, token_stride: int, head_stride: int):
+        self._cute = cute
+        self._strides = (token_stride, head_stride)
+        self.replaced = 0
+        self._calls = 0
+
+    def __getattr__(self, name):
+        return getattr(self._cute, name)
+
+    def make_tensor(self, iterator, layout, *args, **kwargs):
+        import sys
+
+        cute = self._cute
+        if sys._getframe(1).f_code.co_name == "__call__" and self._calls < 3:
+            self._calls += 1
+            if self._calls >= 2:
+                ts, hs = self._strides
+                if self._calls == 2:
+                    # (s_k, d, ((h_r, h_k), b))
+                    stride = (ts, 1, ((0, hs), 0))
+                else:
+                    # (dv, s_v, ((h_r, h_k), b))
+                    stride = (1, ts, ((0, hs), 0))
+                layout = cute.make_layout(layout.shape, stride=stride)
+                self.replaced += 1
+        return cute.make_tensor(iterator, layout, *args, **kwargs)
+

+    def choose_one(self, custom_op, runners, tuning_config, inputs, **kwargs):
+        runner, tactic = orig(self, custom_op, runners, tuning_config, inputs, **kwargs)
+        hint = _fp4_moe_fallback_tactic.get()
+        if (

+"""Tail split for persistent MLA decode.
+
+The TRT-LLM persistent MLA decode kernel hands requests to its SM-sized grid
+round-robin, so a batch of ``num_sms * k + r`` equal-length requests ends with a
+wave that keeps only ``r`` SMs busy. Splitting the last ``r`` requests' KV in
+two halves (``2r <= num_sms`` pseudo-requests, each half the cost) halves the
+length of that last wave. The halves are merged back through their LSE.
+
+Pseudo-batch layout (``n_full = bs - r``):
+  rows [0, bs)           original requests; rows [n_full, bs) keep KV pages
+                         [0, p0) of their request
+  rows [bs, bs + r)      KV pages [p0, ...) of request n_full + (row - bs)
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+def tail_split_rows(batch_size: int, num_sms: int) -> int:
+    """Number of trailing requests to split; 0 disables the split."""
+    r = batch_size % num_sms
+    if batch_size <= num_sms or r == 0 or 2 * r > num_sms:
+        return 0
+    return r
+
+
+@triton.jit
+def _tables_kernel(
+    bt_ptr,  # [bs, stride_bt] int32
+    bt2_ptr,  # [bs + r, ncols] int32
+    sl_ptr,  # [bs] int32
+    sl2_ptr,  # [bs + r] int32
+    bs,
+    n_full,
+    ncols,

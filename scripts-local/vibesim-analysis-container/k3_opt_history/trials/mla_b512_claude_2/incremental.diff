+"""Tail split for persistent MLA decode.
+
+The TRT-LLM persistent MLA decode kernel hands requests to its SM-sized grid
+round-robin, so a batch of ``num_sms * k + r`` equal-length requests ends with a
+wave that keeps only ``r`` SMs busy. Splitting the last ``r`` requests' KV in
+two halves (``2r <= num_sms`` pseudo-requests, each half the cost) halves the
+length of that last wave. The halves are merged back through their LSE.
+
+Pseudo-batch layout (``n_full = bs - r``):
+  rows [0, bs)           original requests; rows [n_full, bs) keep KV pages
+                         [0, p0) of their request
+  rows [bs, bs + r)      KV pages [p0, ...) of request n_full + (row - bs)
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+def tail_split_rows(batch_size: int, num_sms: int) -> int:
+    """Number of trailing requests to split; 0 disables the split."""
+    r = batch_size % num_sms
+    if batch_size <= num_sms or r == 0 or 2 * r > num_sms:
+        return 0
+    return r
+
+
+@triton.jit
+def _tables_kernel(
+    bt_ptr,  # [bs, stride_bt] int32
+    bt2_ptr,  # [bs + r, ncols] int32
+    sl_ptr,  # [bs] int32
+    sl2_ptr,  # [bs + r] int32
+    bs,
+    n_full,
+    ncols,
+    stride_bt,
+    PAGE: tl.constexpr,
+    COL_BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    is_second = row >= bs
+    src = tl.where(is_second, n_full + row - bs, row)
+
+    seq_len = tl.load(sl_ptr + src)
+    # First half keeps ceil(pages / 2) pages; a <= 1-page request leaves an
+    # empty second half, dropped by the merge.
+    p0 = (seq_len + 2 * PAGE - 1) // (2 * PAGE)
+    len0 = tl.minimum(seq_len, p0 * PAGE)
+    is_tail = src >= n_full
+    new_len = tl.where(is_second, seq_len - len0, tl.where(is_tail, len0, seq_len))
+    tl.store(sl2_ptr + row, new_len)
+
+    col_shift = tl.where(is_second, p0, 0)
+    for c0 in range(0, ncols, COL_BLOCK):
+        cols = c0 + tl.arange(0, COL_BLOCK)
+        src_cols = cols + col_shift
+        v = tl.load(
+            bt_ptr + src.to(tl.int64) * stride_bt + src_cols,
+            mask=src_cols < ncols,
+            other=0,
+        )
+        tl.store(bt2_ptr + row.to(tl.int64) * ncols + cols, v, mask=cols < ncols)
+
+
+@triton.jit
+def _merge_kernel(
+    o_ptr,  # [bs + r, H, DV], rows [n_full, bs) merged in place
+    lse_ptr,  # [bs + r, H] fp32, base 2
+    sl2_ptr,  # [bs + r] int32
+    bs,
+    n_full,
+    H: tl.constexpr,
+    DV: tl.constexpr,
+):
+    i = tl.program_id(0)
+    h = tl.program_id(1)
+    a = (n_full + i).to(tl.int64) * H + h
+    b = (bs + i).to(tl.int64) * H + h
+    offs = tl.arange(0, DV)
+    la = tl.load(lse_ptr + a)
+    lb = tl.load(lse_ptr + b)
+    va = tl.load(o_ptr + a * DV + offs).to(tl.float32)
+    vb = tl.load(o_ptr + b * DV + offs).to(tl.float32)
+    mx = tl.maximum(la, lb)
+    wa = tl.exp2(la - mx)
+    wb = tl.exp2(lb - mx)
+    merged = (va * wa + vb * wb) / (wa + wb)
+    # The kernel skips an empty half: its output and LSE are stale memory.
+    merged = tl.where(tl.load(sl2_ptr + bs + i) == 0, va, merged)
+    tl.store(o_ptr + a * DV + offs, merged.to(o_ptr.dtype.element_ty))
+
+
+def build_tail_split_tables(
+    block_tables: torch.Tensor,
+    seq_lens: torch.Tensor,
+    out_block_tables: torch.Tensor,
+    out_seq_lens: torch.Tensor,
+    page_size: int,
+) -> None:
+    """Fill the (bs + r)-row pseudo-batch block table and seq_lens."""
+    bs = seq_lens.shape[0]
+    r = out_seq_lens.shape[0] - bs
+    ncols = out_block_tables.shape[1]
+    assert block_tables.dtype == torch.int32 and block_tables.stride(1) == 1
+    assert block_tables.shape[1] == ncols and out_block_tables.is_contiguous()
+    _tables_kernel[(bs + r,)](
+        block_tables,
+        out_block_tables,
+        seq_lens,
+        out_seq_lens,
+        bs,
+        bs - r,
+        ncols,
+        block_tables.stride(0),
+        PAGE=page_size,
+        COL_BLOCK=min(1024, triton.next_power_of_2(ncols)),
+        num_warps=4,
+    )
+
+
+def expand_tail_split_query(query: torch.Tensor, r: int, bs: int) -> torch.Tensor:
+    """Return the (bs + r)-row pseudo-batch query.
+
+    ``query`` holds either ``bs`` rows or ``bs + r`` rows whose first ``bs``
+    are filled; the latter is completed in place.
+    """
+    if query.shape[0] == bs:
+        return torch.cat([query, query[bs - r :]])
+    assert query.shape[0] == bs + r
+    query[bs:].copy_(query[bs - r : bs])
+    return query
+
+
+def merge_tail_split(
+    out: torch.Tensor, lse: torch.Tensor, seq_lens: torch.Tensor, bs: int
+) -> torch.Tensor:
+    """Merge the split halves in place and return the [bs, ...] output view."""
+    r = out.shape[0] - bs
+    num_heads, head_dim_v = out.shape[-2], out.shape[-1]
+    _merge_kernel[(r, num_heads)](
+        out,
+        lse,
+        seq_lens,
+        bs,
+        bs - r,
+        H=num_heads,
+        DV=head_dim_v,
+        num_warps=4,
+    )
+    return out[:bs]

+"""K3 MXFP4 SiTU routed MoE GEMV path for tiny decode batches.
+
+Replaces trtllm-gen's routed op (routing permutation + GEMM1 + GEMM2, ~24us at
+one token) with two GEMV kernels that read the trtllm-gen shuffled weights in
+place, and returns the same ``do_finalize=False`` triple (gemm2_out, bf16
+topk weights, expanded_idx) so moe_finalize_rmsnorm consumes it unchanged.
+Layout and math contract: jit/csrc/moe/mxfp4_small_m_moe.cuh.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Tuple
+
+import torch
+
+from sglang.kernels.jit.utils import (
+    cache_once,
+    is_arch_support_pdl,
+    load_jit,
+    make_cpp_args,
+)
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+_HIDDEN = 3584
+_INTER = 3072
+# Each routed row is 96 + 112 CTAs; past a handful of rows trtllm-gen's
+# grouped GEMMs win. Only M=1 (top-2) was measured.
+MAX_ROWS = 4
+
+
+@cache_once
+def _jit_module(top_k: int) -> Module:
+    args = make_cpp_args(top_k, is_arch_support_pdl())
+    return load_jit(
+        "moe_mxfp4_small_m",
+        *args,
+        cuda_files=["moe/mxfp4_small_m_moe.cuh"],
+        cuda_wrappers=[("run", f"Mxfp4SmallMMoeKernel<{args}>::run")],
+        extra_cuda_cflags=["-O3"],
+    )
+
+
+@cache_once
+def available(top_k: int) -> bool:
+    import logging
+
+    try:
+        _jit_module(top_k)
+        return True
+    except Exception as e:  # pragma: no cover - toolchain dependent
+        logging.getLogger(__name__).warning(
+            f"Failed to load the JIT small-m MXFP4 MoE kernel: {e}"
+        )
+        return False
+
+
+def covered(
+    packed: torch.Tensor,
+    x_q: torch.Tensor,
+    w13: torch.Tensor,
+    w2: torch.Tensor,
+    intermediate_size: int,
+) -> bool:
+    return (
+        packed.dim() == 2
+        and packed.dtype == torch.int32
+        and packed.is_contiguous()
+        and packed.shape[0] * packed.shape[1] <= MAX_ROWS
+        and x_q.dim() == 2
+        and x_q.shape == (packed.shape[0], _HIDDEN)
+        and x_q.is_contiguous()
+        and intermediate_size == _INTER
+        and w13.dim() == 3
+        and w13.shape[1:] == (2 * _INTER, _HIDDEN // 2)
+        and w2.dim() == 3
+        and w2.shape[1:] == (_HIDDEN, _INTER // 2)
+    )
+
+
+def mxfp4_small_m_moe(
+    packed: torch.Tensor,
+    x_q: torch.Tensor,
+    x_s: torch.Tensor,
+    w13: torch.Tensor,
+    w13_scale: torch.Tensor,
+    gemm1_alpha: torch.Tensor,
+    gemm1_limit: torch.Tensor,
+    w2: torch.Tensor,
+    w2_scale: torch.Tensor,
+    local_expert_offset: int,
+) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Returns ``(gemm2_out [M*K, 3584] bf16, topk_weights [M, K] bf16,
+    expanded_idx [M*K] int32)``; caller must have checked covered()."""
+    m, top_k = packed.shape
+    mk = m * top_k
+    device = x_q.device
+    inter = torch.empty((mk, _INTER), dtype=torch.float32, device=device)
+    out = torch.empty((mk, _HIDDEN), dtype=torch.bfloat16, device=device)
+    idx = torch.empty((mk,), dtype=torch.int32, device=device)
+    weights = torch.empty((m, top_k), dtype=torch.bfloat16, device=device)
+    _jit_module(top_k).run(
+        packed,
+        x_q.view(torch.uint8),
+        x_s.view(torch.uint8),
+        w13.view(torch.uint8),
+        w13_scale.view(torch.uint8),
+        gemm1_alpha,
+        gemm1_limit,
+        w2.view(torch.uint8),
+        w2_scale.view(torch.uint8),
+        inter,
+        out,
+        idx,
+        weights.view(torch.int16),
+        int(local_expert_offset),
+    )
+    return out, weights, idx

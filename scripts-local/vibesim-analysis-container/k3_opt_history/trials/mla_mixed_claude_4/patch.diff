+"""fp8 ragged prefill FMHA (cute-dsl, SM100) with full softmax correction.
+
+flashinfer's cute-dsl FMHA artifacts are built with ``enable_skip_correction``,
+which also drops the fp8 P pre-scale (P stays in [0, 1] of E4M3) and doubles
+the row error vs the trtllm-gen cubin. Compiling with the correction always
+on restores the 2^8 P pre-scale and trtllm-gen accuracy, and still beats the
+cubin on the 12-head MLA prefill shapes.
+"""
+
+from __future__ import annotations
+
+import functools
+import math
+from typing import Optional
+
+import torch
+import triton
+import triton.language as tl
+
+# The kernel runs one 256-row Q tile (two 128-row softmax warpgroups) per CTA,
+# one CTA per SM, and every CTA of a non-causal launch walks the full KV.
+_CTA_Q_ROWS = 256
+_MIN_SPLIT_KV = 16384
+
+
+@functools.lru_cache(maxsize=None)
+def _num_sms(device_index: int) -> int:
+    return torch.cuda.get_device_properties(device_index).multi_processor_count
+
+
+def _num_kv_splits(num_ctas: int, kv_len: int, num_sms: int) -> int:
+    """Split the KV into S batch entries so the grid grows S-fold and the
+    partial last wave is amortized. Measured on B200 (12 heads, kv >= 96k):
+    <= 6 waves (16k q) gains ~8% at S=4 and ~5% at S=2; ~10 waves (32k q)
+    gains ~2% at S=2 only, larger S costs more in extra Q loads than the
+    tail saves. Short KV keeps a single launch."""
+    splits = 4 if num_ctas <= 6 * num_sms else 2
+    while splits > 1 and kv_len < splits * _MIN_SPLIT_KV:
+        splits //= 2
+    return splits
+
+
+@functools.lru_cache(maxsize=64)
+def _split_indptrs(num_q: int, kv_len: int, splits: int, device: torch.device):
+    step = -(-kv_len // (splits * 128)) * 128
+    cu_kv = [min(i * step, kv_len) for i in range(splits)] + [kv_len]
+    cu_q = [i * num_q for i in range(splits + 1)]
+    return (
+        torch.tensor(cu_q, dtype=torch.int32, device=device),
+        torch.tensor(cu_kv, dtype=torch.int32, device=device),
+        step,
+    )
+
+
+@functools.lru_cache(maxsize=64)
+def _chunk_split_indptrs(
+    num_q: int, chunk_lens: tuple, chunk_splits: tuple, device: torch.device
+):
+    # Per chunk, the KV splits _split_indptrs gives a launch over that chunk
+    # alone, laid out back to back so one launch covers every chunk.
+    cu_kv, max_step, start = [0], 0, 0
+    for kv_len, splits in zip(chunk_lens, chunk_splits):
+        step = -(-kv_len // (splits * 128)) * 128
+        max_step = max(max_step, step)
+        cu_kv += [start + min((i + 1) * step, kv_len) for i in range(splits)]
+        start += kv_len
+    cu_q = [i * num_q for i in range(sum(chunk_splits) + 1)]
+    return (
+        torch.tensor(cu_q, dtype=torch.int32, device=device),
+        torch.tensor(cu_kv, dtype=torch.int32, device=device),
+        max_step,
+    )
+
+
+@triton.jit
+def _merge_kv_splits_kernel(
+    o_ptr,  # [S * T, H, D] bf16
+    lse_ptr,  # [S * T, H] fp32, log2 domain (as the kernel writes it)
+    out_ptr,  # [T, H, D]
+    out_lse_ptr,  # [T, H]
+    T,
+    out_stride_t,
+    out_stride_h,
+    H: tl.constexpr,
+    D: tl.constexpr,
+    S: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    t = tl.program_id(0).to(tl.int64)
+    offs_h = tl.arange(0, BLOCK_H)
+    offs_d = tl.arange(0, D)
+    mask_h = offs_h < H
+    m = tl.full([BLOCK_H], float("-inf"), tl.float32)
+    for s in tl.static_range(S):
+        lse = tl.load(
+            lse_ptr + (s * T + t) * H + offs_h, mask=mask_h, other=float("-inf")
+        )
+        m = tl.maximum(m, lse)
+    m_safe = tl.where(m == float("-inf"), 0.0, m)
+    acc = tl.zeros([BLOCK_H, D], dtype=tl.float32)
+    den = tl.zeros([BLOCK_H], dtype=tl.float32)
+    for s in tl.static_range(S):
+        lse = tl.load(
+            lse_ptr + (s * T + t) * H + offs_h, mask=mask_h, other=float("-inf")
+        )
+        w = tl.exp2(lse - m_safe)
+        o = tl.load(
+            o_ptr + ((s * T + t) * H + offs_h[:, None]) * D + offs_d[None, :],
+            mask=mask_h[:, None],
+            other=0.0,
+        )
+        acc += w[:, None] * o.to(tl.float32)
+        den += w
+    has = den > 0
+    out = acc / tl.where(has, den, 1.0)[:, None]
+    tl.store(
+        out_ptr + t * out_stride_t + offs_h[:, None] * out_stride_h + offs_d[None, :],
+        out.to(out_ptr.dtype.element_ty),
+        mask=mask_h[:, None],
+    )
+    tl.store(
+        out_lse_ptr + t * H + offs_h,
+        tl.where(has, m_safe + tl.log2(tl.where(has, den, 1.0)), float("-inf")),
+        mask=mask_h,
+    )
+
+
+@functools.lru_cache(maxsize=None)
+def is_supported() -> bool:
+    # ex2 emulation below is tuned for CC 10.0; other Blackwell parts untested.
+    return torch.cuda.get_device_capability() == (10, 0)
+
+
+# Softmax exp split of the fp8 kernel, swept on B200 at 16k q x 128k kv, 12 heads
+# (flashinfer's default is 20 emulated, degree 3): 7.79 -> 7.55 ms; 32 and 48 are slower.
+# A rescale threshold > 0 is another -1.4% but raises the worst-row error on peaked
+# scores from 0.031 to 0.041, so the correction stays exact.
+_EX2_EMULATION_COUNT = 40
+# 2^f ~= 1 + f * (c1 + c2 * f) on [0, 1), minimax with p(1) = 2: max rel err
+# 2.7e-3, well below the e4m3 half-ulp (6.25%) that P is rounded to next.
+_EX2_DEG2_C1 = 0.6602345839457641
+_EX2_DEG2_C2 = 0.33976541605423594
+
+
+@functools.lru_cache(maxsize=None)
+def _fmha_class():
+    """flashinfer's Blackwell FMHA with the softmax exp split re-balanced from
+    MUFU towards the FMA pipe (the fp8 prefill is MUFU/issue bound)."""
+    import cutlass
+    import cutlass.cute as cute
+    from cutlass._mlir.dialects import llvm
+    from cutlass.cute.typing import Float32
+    from cutlass.cutlass_dsl import T, dsl_user_op
+    from flashinfer.cute_dsl.attention.fmha.fmha import (
+        BlackwellFusedMultiHeadAttentionForward,
+    )
+    from flashinfer.cute_dsl.attention.fmha.helpers import fmha_helpers
+
+    @dsl_user_op
+    def ex2_deg2_packed_f32x2(x, y, *, loc=None, ip=None):
+        # Same range reduction as fmha_helpers.ex2_emulation_packed_f32x2,
+        # with a degree-2 instead of degree-3 polynomial on the fraction.
+        xy = (cute.arch.fmax(x, -127.0), cute.arch.fmax(y, -127.0))
+        round_int = float(2**23 + 2**22)
+        xy_rounded = cute.arch.add_packed_f32x2(
+            xy, (round_int, round_int), rnd="rm"
+        )
+        xy_floor = cute.arch.sub_packed_f32x2(xy_rounded, (round_int, round_int))
+        frac = cute.arch.sub_packed_f32x2(xy, xy_floor)
+        poly = cute.arch.fma_packed_f32x2(
+            (_EX2_DEG2_C2, _EX2_DEG2_C2),
+            frac,
+            (_EX2_DEG2_C1, _EX2_DEG2_C1),
+            loc=loc,
+            ip=ip,
+        )
+        poly = cute.arch.fma_packed_f32x2(poly, frac, (1.0, 1.0), loc=loc, ip=ip)
+
+        def add_exponent(rounded, mantissa):
+            return Float32(
+                llvm.inline_asm(
+                    T.f32(),
+                    [
+                        Float32(rounded).ir_value(loc=loc, ip=ip),
+                        Float32(mantissa).ir_value(loc=loc, ip=ip),
+                    ],
+                    "{\n\t.reg .s32 r, m, e, o;\n\tmov.b32 r, $1;\n\t"
+                    "mov.b32 m, $2;\n\tshl.b32 e, r, 23;\n\tadd.s32 o, e, m;\n\t"
+                    "mov.b32 $0, o;\n\t}\n",
+                    "=f,f,f",
+                    has_side_effects=False,
+                    is_align_stack=False,
+                    asm_dialect=llvm.AsmDialect.AD_ATT,
+                )
+            )
+
+        return (
+            add_exponent(xy_rounded[0], poly[0]),
+            add_exponent(xy_rounded[1], poly[1]),
+        )
+
+    class Fp8PrefillFmha(BlackwellFusedMultiHeadAttentionForward):
+        @cute.jit
+        def apply_exp_and_cvt(
+            self,
+            tTMEM_LOADrS,
+            tTMEM_LOADrS_cvt,
+            tTMEM_STORErS_x4_e_cvt,
+            stage,
+            scale,
+            minus_row_max_scale,
+            local_row_sum,
+            inplace_consumer,
+            EXP2_EMULATION_OFFSET,
+            EXP2_EMULATION_COUNT,
+            CVT_COUNT,
+            CVT_PER_STEP,
+            FMA_COUNT,
+            ARV_COUNT,
+        ):
+            # The caller (softmax_step) row-sums [OFFSET, OFFSET + COUNT) after
+            # this returns; the extra emulated elements are summed here.
+            if cutlass.const_expr(EXP2_EMULATION_COUNT == 0):
+                local_row_sum, inplace_consumer = (
+                    BlackwellFusedMultiHeadAttentionForward.apply_exp_and_cvt(
+                        self,
+                        tTMEM_LOADrS,
+                        tTMEM_LOADrS_cvt,
+                        tTMEM_STORErS_x4_e_cvt,
+                        stage,
+                        scale,
+                        minus_row_max_scale,
+                        local_row_sum,
+                        inplace_consumer,
+                        EXP2_EMULATION_OFFSET,
+                        EXP2_EMULATION_COUNT,
+                        CVT_COUNT,
+                        CVT_PER_STEP,
+                        FMA_COUNT,
+                        ARV_COUNT,
+                    )
+                )
+            else:
+                local_row_sum, inplace_consumer = self._exp_and_cvt_rebalanced(
+                    tTMEM_LOADrS,
+                    tTMEM_LOADrS_cvt,
+                    tTMEM_STORErS_x4_e_cvt,
+                    scale,
+                    minus_row_max_scale,
+                    local_row_sum,
+                    inplace_consumer,
+                    EXP2_EMULATION_OFFSET + EXP2_EMULATION_COUNT - _EX2_EMULATION_COUNT,
+                    EXP2_EMULATION_OFFSET,
+                    CVT_COUNT,
+                    CVT_PER_STEP,
+                    FMA_COUNT,
+                )
+            return local_row_sum, inplace_consumer
+
+        @cute.jit
+        def _exp_and_cvt_rebalanced(
+            self,
+            tTMEM_LOADrS,
+            tTMEM_LOADrS_cvt,
+            tTMEM_STORErS_x4_e_cvt,
+            scale,
+            minus_row_max_scale,
+            local_row_sum,
+            inplace_consumer,
+            emu_offset,
+            caller_offset,
+            CVT_COUNT,
+            CVT_PER_STEP,
+            FMA_COUNT,
+        ):
+            # Mirrors the parent's schedule: MUFU exp2 on [0, emu_offset) with
+            # the scale FMA and fp8 cvt interleaved, then the emulated tail.
+            for i in cutlass.range_constexpr(0, emu_offset, 2):
+                if cutlass.const_expr(i >= CVT_COUNT):
+                    if cutlass.const_expr(i % CVT_PER_STEP == 0):
+                        fmha_helpers.cvt_f32x4_to_f8x4(
+                            tTMEM_LOADrS_cvt[None, (i - CVT_COUNT) // CVT_PER_STEP],
+                            tTMEM_STORErS_x4_e_cvt[
+                                None, (i - CVT_COUNT) // CVT_PER_STEP
+                            ],
+                        )
+                    local_row_sum = cute.arch.add_packed_f32x2(
+                        local_row_sum,
+                        (tTMEM_LOADrS[i - CVT_COUNT], tTMEM_LOADrS[i - CVT_COUNT + 1]),
+                    )
+                tTMEM_LOADrS[i] = cute.math.exp2(tTMEM_LOADrS[i], fastmath=True)
+                if cutlass.const_expr(i + FMA_COUNT < emu_offset):
+                    (
+                        tTMEM_LOADrS[i + FMA_COUNT],
+                        tTMEM_LOADrS[i + FMA_COUNT + 1],
+                    ) = cute.arch.fma_packed_f32x2(
+                        (tTMEM_LOADrS[i + FMA_COUNT], tTMEM_LOADrS[i + FMA_COUNT + 1]),
+                        (scale, scale),
+                        (minus_row_max_scale, minus_row_max_scale),
+                    )
+                tTMEM_LOADrS[i + 1] = cute.math.exp2(
+                    tTMEM_LOADrS[i + 1], fastmath=True
+                )
+            for i in cutlass.range_constexpr(emu_offset - CVT_COUNT, emu_offset, 2):
+                if cutlass.const_expr(i % CVT_PER_STEP == 0):
+                    fmha_helpers.cvt_f32x4_to_f8x4(
+                        tTMEM_LOADrS_cvt[None, i // CVT_PER_STEP],
+                        tTMEM_STORErS_x4_e_cvt[None, i // CVT_PER_STEP],
+                    )
+                local_row_sum = cute.arch.add_packed_f32x2(
+                    local_row_sum, (tTMEM_LOADrS[i], tTMEM_LOADrS[i + 1])
+                )
+            emu_mid = emu_offset + _EX2_EMULATION_COUNT // 2
+            emu_end = emu_offset + _EX2_EMULATION_COUNT
+            for i in cutlass.range_constexpr(emu_offset, emu_mid, 2):
+                self._exp2_emulated_step(
+                    tTMEM_LOADrS,
+                    tTMEM_LOADrS_cvt,
+                    tTMEM_STORErS_x4_e_cvt,
+                    scale,
+                    minus_row_max_scale,
+                    i,
+                    CVT_PER_STEP,
+                )
+            inplace_peek_status = inplace_consumer.try_wait()
+            for i in cutlass.range_constexpr(emu_mid, emu_end, 2):
+                self._exp2_emulated_step(
+                    tTMEM_LOADrS,
+                    tTMEM_LOADrS_cvt,
+                    tTMEM_STORErS_x4_e_cvt,
+                    scale,
+                    minus_row_max_scale,
+                    i,
+                    CVT_PER_STEP,
+                )
+            inplace_consumer.wait_and_advance(inplace_peek_status)
+            for j in cutlass.range_constexpr(emu_offset, caller_offset, 2):
+                local_row_sum = cute.arch.add_packed_f32x2(
+                    (tTMEM_LOADrS[j], tTMEM_LOADrS[j + 1]), local_row_sum
+                )
+            return local_row_sum, inplace_consumer
+
+        @cute.jit
+        def _exp2_emulated_step(
+            self,
+            tTMEM_LOADrS,
+            tTMEM_LOADrS_cvt,
+            tTMEM_STORErS_x4_e_cvt,
+            scale,
+            minus_row_max_scale,
+            i,
+            CVT_PER_STEP,
+        ):
+            tTMEM_LOADrS[i], tTMEM_LOADrS[i + 1] = cute.arch.fma_packed_f32x2(
+                (tTMEM_LOADrS[i], tTMEM_LOADrS[i + 1]),
+                (scale, scale),
+                (minus_row_max_scale, minus_row_max_scale),
+            )
+            tTMEM_LOADrS[i], tTMEM_LOADrS[i + 1] = ex2_deg2_packed_f32x2(
+                tTMEM_LOADrS[i], tTMEM_LOADrS[i + 1]
+            )
+            if cutlass.const_expr((i + 2) % CVT_PER_STEP == 0):
+                fmha_helpers.cvt_f32x4_to_f8x4(
+                    tTMEM_LOADrS_cvt[None, i // CVT_PER_STEP],
+                    tTMEM_STORErS_x4_e_cvt[None, i // CVT_PER_STEP],
+                )
+
+    return Fp8PrefillFmha
+
+
+@functools.lru_cache(maxsize=None)
+def _compile(num_heads: int, head_dim: int, head_dim_v: int, is_causal: bool):
+    import cutlass
+    import cutlass.cute as cute
+    from cutlass.cute.runtime import make_fake_compact_tensor, make_fake_stream
+    from cutlass.cute.typing import Int32
+    from flashinfer.cute_dsl.attention.fmha.helpers import fmha_helpers
+
+    fmha = _fmha_class()(
+        qk_acc_dtype=cutlass.Float32,
+        pv_acc_dtype=cutlass.Float32,
+        mma_tiler=(128, 128),
+        head_dim=head_dim if head_dim == head_dim_v else (head_dim, head_dim_v),
+        is_persistent=False,
+        mask_type=(
+            fmha_helpers.MaskEnum.WINDOW_MASK_INFERENCE
+            if is_causal
+            else fmha_helpers.MaskEnum.RESIDUAL_MASK
+        ),
+        enable_ex2_emulation=True,
+        enable_skip_correction=False,
+        use_tma_store=False,
+    )
+
+    fp8 = cutlass.Float8E4M3FN
+    b, s_q, s_k, h_k, h_r, n_seq = (cute.sym_int() for _ in range(6))
+
+    def fake(dtype, shape, align):
+        order = tuple(range(len(shape) - 1, -1, -1))
+        return make_fake_compact_tensor(
+            dtype, shape, stride_order=order, assumed_align=align
+        )
+
+    scale_softmax = 1.0 / math.sqrt(head_dim)
+    return cute.compile(
+        fmha,
+        fake(fp8, (b, s_q, h_k, h_r, head_dim), 16),
+        fake(fp8, (b, s_k, h_k, 1, head_dim), 16),
+        fake(fp8, (b, s_k, h_k, 1, head_dim_v), 16),
+        fake(cutlass.BFloat16, (b, s_q, h_k, h_r, head_dim_v), 32),
+        (1, 1, 1, 1, num_heads, num_heads, head_dim, head_dim_v),
+        make_fake_compact_tensor(Int32, (n_seq,), assumed_align=16),
+        make_fake_compact_tensor(Int32, (n_seq,), assumed_align=16),
+        fake(cutlass.Float32, (b, s_q, h_k, h_r), 16),
+        None,
+        scale_softmax * math.log2(math.e),
+        scale_softmax,
+        1.0,
+        None,
+        None,
+        Int32(0) if is_causal else None,
+        None,
+        None,
+        make_fake_stream(use_tvm_ffi_env_stream=True),
+        False,
+        options="--enable-tvm-ffi --opt-level 2",
+    )
+
+
+def _align16(t: torch.Tensor) -> torch.Tensor:
+    # The kernel is compiled for 16B-aligned cum_seqlen tensors; a row of the
+    # [num_prefix_chunks, bs + 1] chunk table (e.g. chunk 1 at bs = 1) is not.
+    return t if t.data_ptr() % 16 == 0 else t.clone()
+
+
+def cute_dsl_fmha_fp8_ragged_prefill(
+    *,
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    out: torch.Tensor,
+    lse: torch.Tensor,
+    cum_seq_lens_q: torch.Tensor,
+    cum_seq_lens_kv: torch.Tensor,
+    max_q_len: int,
+    max_kv_len: int,
+    sm_scale: float,
+    v_scale: float,
+    is_causal: bool,
+    batch_size: int = 0,
+) -> None:
+    """q/k: [tokens, heads, d] fp8, v: [tokens, heads, dv] fp8, out bf16 and
+    lse fp32 [tokens_q, heads] written in place. ``batch_size`` (host int)
+    enables the KV-split launch for a single non-causal request."""
+    from flashinfer.attention.cute_dsl.fmha import cute_dsl_fmha_ragged_prefill
+
+    kernel_fn = _compile(q.shape[1], q.shape[2], v.shape[2], is_causal)
+    num_q, num_heads = q.shape[0], q.shape[1]
+    splits = 1
+    if (
+        batch_size == 1
+        and not is_causal
+        and num_q == max_q_len
+        and k.shape[0] >= max_kv_len
+        and out.shape[0] == num_q
+        and out.stride(-1) == 1
+        and lse.is_contiguous()
+    ):
+        num_ctas = -(-num_q // _CTA_Q_ROWS) * num_heads
+        splits = _num_kv_splits(num_ctas, max_kv_len, _num_sms(q.device.index))
+    if splits > 1:
+        # Each split is its own batch entry over a replicated Q, so the grid
+        # grows S-fold while K/V stay in place; the partial states are then
+        # merged like chunked-prefix partials (fp32, log2-domain LSE).
+        cu_q, cu_kv, step = _split_indptrs(num_q, max_kv_len, splits, q.device)
+        o_rep, lse_rep = _split_launch(
+            kernel_fn=kernel_fn,
+            q=q,
+            k=k,
+            v=v,
+            out=out,
+            lse=lse,
+            cu_q=cu_q,
+            cu_kv=cu_kv,
+            num_entries=splits,
+            max_kv_len=step,
+            sm_scale=sm_scale,
+            v_scale=v_scale,
+        )
+        _merge_kv_splits(o_rep=o_rep, lse_rep=lse_rep, out=out, lse=lse, splits=splits)
+        return
+    cute_dsl_fmha_ragged_prefill(
+        q=q,
+        k=k,
+        v=v,
+        o=out,
+        qo_indptr=_align16(cum_seq_lens_q),
+        kv_indptr=_align16(cum_seq_lens_kv),
+        is_causal=is_causal,
+        sm_scale=sm_scale,
+        lse=lse,
+        scale_v=v_scale,
+        max_qo_len=max_q_len,
+        max_kv_len=max_kv_len,
+        kernel_fn=kernel_fn,
+    )
+
+
+def _split_launch(
+    *,
+    kernel_fn,
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    out: torch.Tensor,
+    lse: torch.Tensor,
+    cu_q: torch.Tensor,
+    cu_kv: torch.Tensor,
+    num_entries: int,
+    max_kv_len: int,
+    sm_scale: float,
+    v_scale: float,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    from flashinfer.attention.cute_dsl.fmha import cute_dsl_fmha_ragged_prefill
+
+    num_q, num_heads = q.shape[0], q.shape[1]
+    q_rep = q.new_empty((num_entries, *q.shape))
+    for i in range(num_entries):
+        # Contiguous same-dtype copies are plain D2D memcpys; an expanded
+        # fp8 source would take aten's slow non-vectorized copy kernel.
+        q_rep[i].copy_(q)
+    q_rep = q_rep.view(-1, *q.shape[1:])
+    o_rep = out.new_empty((num_entries * num_q, num_heads, out.shape[-1]))
+    lse_rep = lse.new_empty((num_entries * num_q, num_heads))
+    cute_dsl_fmha_ragged_prefill(
+        q=q_rep,
+        k=k,
+        v=v,
+        o=o_rep,
+        qo_indptr=cu_q,
+        kv_indptr=cu_kv,
+        is_causal=False,
+        sm_scale=sm_scale,
+        lse=lse_rep,
+        scale_v=v_scale,
+        max_qo_len=num_q,
+        max_kv_len=max_kv_len,
+        kernel_fn=kernel_fn,
+    )
+    return o_rep, lse_rep
+
+
+def _merge_kv_splits(
+    *,
+    o_rep: torch.Tensor,
+    lse_rep: torch.Tensor,
+    out: torch.Tensor,
+    lse: torch.Tensor,
+    splits: int,
+) -> None:
+    num_q, num_heads = out.shape[0], out.shape[1]
+    _merge_kv_splits_kernel[(num_q,)](
+        o_rep,
+        lse_rep,
+        out,
+        lse,
+        num_q,
+        out.stride(0),
+        out.stride(1),
+        H=num_heads,
+        D=out.shape[-1],
+        S=splits,
+        BLOCK_H=triton.next_power_of_2(num_heads),
+        num_warps=4,
+    )
+
+
+def prefix_chunk_splits(
+    *, num_q: int, num_heads: int, chunk_lens: tuple, device: torch.device
+) -> Optional[tuple]:
+    """KV splits per chunk for ``cute_dsl_fmha_fp8_prefix_chunks``, or None
+    when a single launch over every chunk is not expected to pay off."""
+    num_ctas = -(-num_q // _CTA_Q_ROWS) * num_heads
+    num_sms = _num_sms(device.index)
+    # Measured on B200: only the <= 6-wave (S = 4) grids gain from sharing
+    # one launch; the 32k-query S = 2 grids are neutral.
+    if len(chunk_lens) < 2 or num_ctas > 6 * num_sms:
+        return None
+    splits = tuple(_num_kv_splits(num_ctas, n, num_sms) for n in chunk_lens)
+    return splits if min(splits) > 1 else None
+
+
+def cute_dsl_fmha_fp8_prefix_chunks(
+    *,
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    chunk_lens: tuple,
+    chunk_splits: tuple,
+    outs: list,
+    lses: list,
+    sm_scale: float,
+    v_scale: float,
+) -> None:
+    """One request's Q against every prefix chunk (packed back to back in
+    k/v) in one launch; chunk c's state lands in outs[c]/lses[c], bit-identical
+    to a ``cute_dsl_fmha_fp8_ragged_prefill`` call per chunk."""
+    kernel_fn = _compile(q.shape[1], q.shape[2], v.shape[2], False)
+    num_q = q.shape[0]
+    cu_q, cu_kv, max_step = _chunk_split_indptrs(
+        num_q, tuple(chunk_lens), tuple(chunk_splits), q.device
+    )
+    o_rep, lse_rep = _split_launch(
+        kernel_fn=kernel_fn,
+        q=q,
+        k=k,
+        v=v,
+        out=outs[0],
+        lse=lses[0],
+        cu_q=cu_q,
+        cu_kv=cu_kv,
+        num_entries=sum(chunk_splits),
+        max_kv_len=max_step,
+        sm_scale=sm_scale,
+        v_scale=v_scale,
+    )
+    first = 0
+    for splits, out, lse in zip(chunk_splits, outs, lses):
+        rows = slice(first * num_q, (first + splits) * num_q)
+        _merge_kv_splits(
+            o_rep=o_rep[rows], lse_rep=lse_rep[rows], out=out, lse=lse, splits=splits
+        )
+        first += splits

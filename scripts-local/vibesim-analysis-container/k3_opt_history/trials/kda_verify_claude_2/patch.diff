+// Fire-and-forget L2 warm-up of a strided 2-D byte range (rows of row_bytes,
+// row_stride_bytes apart): every thread issues per-line prefetch.global.L2
+// hints in a grid-stride loop. Nothing is read
+// into the SM and nothing is written, so it cannot change any result. Meant
+// to run on a side stream while the main stream is latency-bound, so that a
+// later weight-streaming GEMM finds its operand already in L2.
+struct L2PrefetchParams {
+  const char* __restrict__ ptr;
+  int64_t row_stride_bytes;
+  int64_t lines_per_row;
+  int64_t num_lines;
+};
+
+constexpr int64_t kL2LineBytes = 128;
+
+__global__ void l2_prefetch_kernel(const __grid_constant__ L2PrefetchParams params) {
+  const int64_t stride = static_cast<int64_t>(gridDim.x) * blockDim.x;
+  for (int64_t line = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; line < params.num_lines;
+       line += stride) {
+    const int64_t row = line / params.lines_per_row;
+    const int64_t col = line - row * params.lines_per_row;
+    const char* addr = params.ptr + row * params.row_stride_bytes + col * kL2LineBytes;
+    asm volatile("prefetch.global.L2::evict_normal [%0];" ::"l"(addr) : "memory");
+  }
+}
+
+struct L2PrefetchKernel {
+  static constexpr int kThreads = 128;
+
+  static void launch(const tvm::ffi::TensorView x, const int64_t num_blocks) {
+    using namespace host;
+    auto R = SymbolicSize{"rows"};
+    auto C = SymbolicSize{"cols"};
+    auto S = SymbolicSize{"row_stride"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+    TensorMatcher({R, C}).with_strides({S, 1}).with_dtype<bf16_t>().with_device(device).verify(x);
+    const int64_t row_bytes = C.unwrap() * static_cast<int64_t>(sizeof(bf16_t));
+    const int64_t lines_per_row = (row_bytes + kL2LineBytes - 1) / kL2LineBytes;
+    const int64_t num_lines = R.unwrap() * lines_per_row;
+    if (num_lines == 0) return;
+    const auto params = L2PrefetchParams{
+        .ptr = static_cast<const char*>(x.data_ptr()),
+        .row_stride_bytes = S.unwrap() * static_cast<int64_t>(sizeof(bf16_t)),
+        .lines_per_row = lines_per_row,
+        .num_lines = num_lines,
+    };
+    LaunchKernel(num_blocks, kThreads, device.unwrap())(l2_prefetch_kernel, params);
+  }
+};
+
+}  // namespace sglang

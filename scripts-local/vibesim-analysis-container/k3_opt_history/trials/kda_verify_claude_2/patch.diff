@@ -0,0 +1,72 @@
+"""Low-overhead launch of already-compiled ``@triton.jit`` kernels.
+
+``fast_launch(kernel, grid, *args, **kwargs)`` is equivalent to
+``kernel[grid](*args, **kwargs)``. It keeps Triton's own binder and cache
+key, so specialization (dtypes, 16-byte alignment, ``== 1`` / ``% 16`` ints,
+constexprs and launch options) resolves to exactly the kernel
+``JITFunction.run`` would pick. On a cache hit it launches that kernel
+directly, skipping the rest of ``run``'s per-call Python bookkeeping, which
+dominates small eager decode/verify steps. Anything unusual (first
+compile, run/launch hooks, stage-inspection pipelines) falls back to the
+regular path.
+"""
+
+from triton import knobs
+from triton.knobs import HookChain
+from triton.runtime.driver import driver
+from triton.runtime.jit import compute_cache_key
+
+_MISSING = object()
+
+
+def _no_hook(hook) -> bool:
+    # knobs.runtime.launch_{enter,exit}_hook: HookChain, empty unless a tool
+    # (e.g. proton) registered one.
+    return hook is None or (isinstance(hook, HookChain) and not hook.calls)
+
+
+def fast_launch(kernel, grid, *args, **kwargs):
+    runtime = knobs.runtime
+    if (
+        kernel.pre_run_hooks
+        or runtime.add_stages_inspection_hook is not None
+        or not _no_hook(runtime.launch_enter_hook)
+        or not _no_hook(runtime.launch_exit_hook)
+    ):
+        return kernel[grid](*args, **kwargs)
+
+    # Same option injection as JITFunction.run.
+    opts = dict(kwargs)
+    opts["debug"] = opts.get("debug", kernel.debug) or runtime.debug
+    opts["instrumentation_mode"] = knobs.compilation.instrumentation_mode
+
+    device = driver.active.get_current_device()
+    kernel_cache, kernel_key_cache, _, _, binder = kernel.device_caches[device]
+    bound_args, specialization, options = binder(*args, **opts)
+    compiled = kernel_cache.get(
+        compute_cache_key(kernel_key_cache, specialization, options), None
+    )
+    if compiled is None:
+        return kernel[grid](*args, **kwargs)
+
+    for (name, _), (val, globals_dict) in kernel.used_global_vals.items():
+        if globals_dict.get(name, _MISSING) != val:
+            # Let JITFunction.run raise its usual error.
+            return kernel[grid](*args, **kwargs)
+
+    if callable(grid):
+        grid = grid(bound_args)
+    grid_size = len(grid)
+    compiled.run(
+        grid[0],
+        grid[1] if grid_size > 1 else 1,
+        grid[2] if grid_size > 2 else 1,
+        driver.active.get_current_stream(device),
+        compiled.function,
+        compiled.packed_metadata,
+        None,  # launch_metadata: only read by launch hooks, none registered
+        None,
+        None,
+        *bound_args.values(),
+    )
+    return compiled

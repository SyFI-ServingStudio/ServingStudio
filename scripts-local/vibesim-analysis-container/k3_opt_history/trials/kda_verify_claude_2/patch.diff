+_MXFP4_ROUTING_TOPK = 5
+_MXFP4_ACT_SITU = 10
+
+
+def _mxfp4_moe_tune_context(num_tokens: int, top_k: int, num_local_experts: int):
+    """Profile the trtllm-gen MXFP4 tactic of this token bucket once, eagerly.
+
+    Untuned, FlashInfer runs the tile_N one below nextPow2(rows per expert), so
+    above 8 rows/expert each expert's weights are split over 2+ CTAs (B=512
+    over 112 local experts: tile 8, ~15% slower than a tuned tile-16 tactic).
+    Only engaged in that regime, when no runner-level autotune pass produced
+    data for this op, outside graph capture; one bucket is profiled per shape.
+    """
+    from flashinfer.autotuner import AutoTuner, autotune
+
+    if num_tokens * top_k <= _MXFP4_MIN_TILE_N * num_local_experts:
+        return contextlib.nullcontext()
+    bucket = 1 << (num_tokens.bit_length() - 1)
+    tuner = AutoTuner.get()
+    if (
+        bucket in _mxfp4_self_tuned_buckets
+        or tuner.is_tuning_mode
+        or torch.cuda.is_current_stream_capturing()
+    ):
+        return contextlib.nullcontext()
+    if not _mxfp4_self_tuned_buckets:
+        if _flashinfer_autotune_disabled() or any(
+            k.custom_op == _MXFP4_TUNE_OP for k in tuner.profiling_cache
+        ):
+            _mxfp4_self_tuned_buckets.add(-1)
+    if -1 in _mxfp4_self_tuned_buckets:
+        return contextlib.nullcontext()
+    _mxfp4_self_tuned_buckets.add(bucket)
+    return autotune(True, tuning_buckets=(bucket,))
+
+
+# Fast relaunch of the routed MXFP4 op. FlashInfer's Python wrapper rebuilds
+# its MoERunner / tuning config and re-queries the autotuner on every call
+# (~100 us of host time per layer); once the tactic of a shape is known, the
+# same C++ launch is issued directly with identical arguments.
+_mxfp4_fast_moe_op = None
+_mxfp4_fast_tactics: dict = {}
+
+
+def _mxfp4_fast_get_moe_op():
+    global _mxfp4_fast_moe_op
+    if _mxfp4_fast_moe_op is None:
+        _mxfp4_fast_moe_op = False
+        try:
+            from flashinfer.fused_moe.core import get_trtllm_moe_sm100_module
+
+            fn = get_trtllm_moe_sm100_module().trtllm_fp4_block_scale_moe
+            cells = dict(zip(fn.__code__.co_freevars, fn.__closure__ or ()))
+            op = cells["moe_op"].cell_contents
+            if callable(getattr(op, "trtllm_fp4_block_scale_moe", None)):
+                _mxfp4_fast_moe_op = op
+        except Exception:
+            logger.debug("MXFP4 fast MoE relaunch unavailable", exc_info=True)
+    return _mxfp4_fast_moe_op or None
+
+
+def _mxfp4_fast_key(tuner, routing, x_quant, x_scale, quant_info, top_k, pdl):
+    ids = routing[0] if isinstance(routing, tuple) else routing
+    w = routing[1] if isinstance(routing, tuple) else None
+    return (
+        x_quant.shape,
+        x_quant.dtype,
+        None if x_scale is None else (x_scale.shape, x_scale.dtype),
+        ids.shape,
+        None if w is None else w.dtype,
+        top_k,
+        pdl,
+        id(quant_info.w13_weight),
+        id(quant_info.w2_weight),
+        len(tuner.profiling_cache),
+        len(tuner._file_configs),
+    )
+
+
+def _mxfp4_fast_routed_moe(routing, x_quant, x_scale, quant_info, top_k, pdl, out):
+    """Relaunch trtllm_fp4_block_scale_routed_moe (TopK/SiTU, finalized) with a
+    cached tactic; returns False when the shape has no cached tactic yet."""
+    from flashinfer.autotuner import AutoTuner
+    from flashinfer.fused_moe.da_config import is_trtllm_da_enabled
+
+    tuner = AutoTuner.get()
+    if tuner.is_tuning_mode or is_trtllm_da_enabled():
+        _mxfp4_fast_tactics.clear()
+        return False
+    key = _mxfp4_fast_key(tuner, routing, x_quant, x_scale, quant_info, top_k, pdl)
+    entry = _mxfp4_fast_tactics.get(key)
+    if entry is None:
+        return False
+    moe_op, tactic, routing_mode, enable_pdl = entry
+    if isinstance(routing, tuple):
+        topk_ids, topk_weights = routing
+    else:
+        topk_ids = routing
+        # Same bf16 scratch FlashInfer allocates for packed routing.
+        topk_weights = torch.empty(
+            topk_ids.shape, dtype=torch.bfloat16, device=x_quant.device
+        )
+    moe_op.trtllm_fp4_block_scale_moe(
+        routing_mode,
+        None,  # routing_logits
+        topk_ids,
+        topk_weights,
+        None,  # routing_bias
+        x_quant,
+        x_scale,
+        quant_info.w13_weight,
+        quant_info.w13_weight_scale,
+        None,  # gemm1_bias
+        None,  # gemm1_lora_delta
+        quant_info.gemm1_alpha,
+        quant_info.gemm1_clamp_limit,  # gemm1_beta
+        None,  # gemm1_clamp_limit
+        quant_info.w2_weight,
+        quant_info.w2_weight_scale,
+        None,  # gemm2_bias
+        None,  # output1_scale_scalar
+        None,  # output1_scale_gate_scalar
+        None,  # output2_scale_scalar
+        None,  # per_token_scale
+        quant_info.global_num_experts,
+        top_k,
+        0,  # num_fused_shared_experts
+        None,  # n_group
+        None,  # topk_group
+        quant_info.intermediate_size_per_partition,
+        quant_info.local_expert_offset,
+        quant_info.local_num_experts,
+        None,  # routed_scaling_factor
+        _MXFP4_ROUTING_TOPK,
+        True,  # do_finalize
+        enable_pdl,
+        _MXFP4_ACT_SITU,
+        out,
+        [-1, -1] if tactic == -1 else tactic,
+        True,  # norm_topk_prob
+        None,  # routing_replay_out
+        [],
+        [],
+        False,
+    )
+    return True
+
+
+@contextmanager
+def _mxfp4_fast_record(routing, x_quant, x_scale, quant_info, top_k, pdl):
+    """Run the regular FlashInfer call once, recording the tactic its
+    autotuner picks so later calls of the same shape take the fast path."""
+    from flashinfer.autotuner import AutoTuner
+    from flashinfer.fused_moe.core import (
+        _device_support_moe_pdl,
+        _enabled_trtllm_da_config,
+        _split_precomputed_routing,
+    )
+
+    tuner = AutoTuner.get()
+    moe_op = _mxfp4_fast_get_moe_op()
+    # Distribution-aware tactics are picked per call; never cache those.
+    if (
+        moe_op is None
+        or tuner.is_tuning_mode
+        or "choose_one" in tuner.__dict__
+        or _enabled_trtllm_da_config() is not None
+    ):
+        yield
+        return
+    key = _mxfp4_fast_key(tuner, routing, x_quant, x_scale, quant_info, top_k, pdl)
+    orig = tuner.choose_one
+    picked = []
+
+    def spy(custom_op, *args, **kwargs):
+        res = orig(custom_op, *args, **kwargs)
+        picked.append((custom_op, res[1]))
+        return res
+
+    tuner.choose_one = spy
+    try:
+        yield
+    finally:
+        del tuner.choose_one
+    if len(picked) == 1 and picked[0][0] == _MXFP4_TUNE_OP and not tuner.is_tuning_mode:
+        _, _, routing_mode = _split_precomputed_routing(routing)
+        enable_pdl = pdl and _device_support_moe_pdl(x_quant.device)
+        _mxfp4_fast_tactics[key] = (moe_op, picked[0][1], routing_mode, enable_pdl)
+
+
+def _flashinfer_autotune_disabled() -> bool:
+    from sglang.srt.runtime_context import get_exec
+
+    try:
+        exec_cfg = get_exec()
+        return bool(
+            exec_cfg.kernel.disable_flashinfer_autotune
+            or exec_cfg.deterministic.enable_deterministic_inference
+        )
+    except Exception:
+        # No server config (standalone layer drivers): nothing disabled it.
+        return False
